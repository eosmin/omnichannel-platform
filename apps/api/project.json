{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "lint": {},
    "type-check": {},
    "test": {},
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nest build --config apps/api/nest-cli.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/apps/api"]
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^prisma-generate"],
      "options": {
        "command": "jest --config jest.integration.config.cts --runInBand --coverage",
        "cwd": "{projectRoot}",
        "env": {
          "NODE_OPTIONS": "--experimental-vm-modules --no-warnings=ExperimentalWarning"
        }
      }
    }
  },
  "implicitDependencies": ["workspace"]
}
