# web. Copied to apps/web/.env.local by scripts/bootstrap.sh. Public values only.

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080
NEXT_PUBLIC_STORAGE_URL=http://localhost:8333
# The public key of the pair that `pnpm vapid:generate` prints (the same as VAPID_PUBLIC_KEY of the api).
# Read when the web is BUILT: set it in apps/web/.env.local and restart `pnpm dev:web`, or pass it to the image
# as a build argument. Without it the settings page says push is not set up here.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_WIDGET_SCRIPT_URL=http://localhost:4173/widget.js
