{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web",
  "projectType": "application",
  "tags": ["scope:web", "type:app"],
  "targets": {
    "lint": {},
    "type-check": {
      "options": {
        "command": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit"
      }
    },
    "test": {},
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "{projectRoot}",
        "env": {
          "NODE_ENV": "production"
        }
      },
      "outputs": ["{projectRoot}/.next"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "next dev --port 3000",
        "cwd": "{projectRoot}"
      }
    }
  }
}
