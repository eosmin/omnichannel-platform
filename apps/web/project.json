{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web",
  "projectType": "application",
  "tags": ["scope:web", "type:app"],
  "targets": {
    "lint": {},
    "type-check": {},
    "test": {},
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "{projectRoot}",
        "env": {
          "NODE_ENV": "production"
        }
      },
      "outputs": ["{projectRoot}/.next"]
    },
    "build-e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "^prisma-generate"],
      "options": {
        "command": "next build",
        "cwd": "{projectRoot}",
        "env": {
          "NODE_ENV": "production",
          "E2E_HARNESS": "1"
        }
      },
      "outputs": ["{projectRoot}/.next"]
    }
  }
}
