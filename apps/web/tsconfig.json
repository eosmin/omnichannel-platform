{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "allowJs": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["jest", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "jest.config.cts"],
  "exclude": ["node_modules", ".next"]
}
