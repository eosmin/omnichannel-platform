{
  "name": "widget",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/widget/src",
  "projectType": "application",
  "tags": ["scope:widget", "type:app"],
  "targets": {
    "lint": {},
    "type-check": {},
    "test": {},
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["vite build", "tsx ../../scripts/check-widget-size.ts"],
        "parallel": false,
        "cwd": "{projectRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/apps/widget"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "vite preview --outDir ../../dist/apps/widget --port 4173",
        "cwd": "{projectRoot}"
      }
    }
  }
}
