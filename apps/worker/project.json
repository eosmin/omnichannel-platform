{
  "name": "worker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/worker/src",
  "projectType": "application",
  "tags": ["scope:worker", "type:app"],
  "targets": {
    "lint": {},
    "type-check": {},
    "test": {},
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^prisma-generate"],
      "options": {
        "command": "nest build --config apps/worker/nest-cli.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/apps/worker"]
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^prisma-generate"],
      "options": {
        "command": "jest --config jest.integration.config.cts --runInBand",
        "cwd": "{projectRoot}",
        "env": {
          "NODE_OPTIONS": "--experimental-vm-modules --no-warnings=ExperimentalWarning"
        }
      }
    }
  },
  "implicitDependencies": ["workspace"]
}
