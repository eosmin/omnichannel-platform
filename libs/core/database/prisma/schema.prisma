// The CJS output has no import.meta and bare imports, so the Jest suites (compiled as CJS) and the
// ESM code run by tsx load the same generated client. The ESM output breaks under Jest.
generator client {
  provider            = "prisma-client"
  output              = "../generated/client"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ORGANIZATIONS & TENANCY
// ============================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stores                 Store[]
  memberships            Membership[]
  invitations            Invitation[]
  dataSubjectRequests    DataSubjectRequest[]
  warehouses             Warehouse[]
  stockCounts            StockCount[]
  stockTransfers         StockTransfer[]
  financeSettings        FinanceSettings?
  ledgerAccounts         LedgerAccount[]
  taxRates               TaxRate[]
  accountRoles           AccountRoleMapping[]
  paymentAccounts        PaymentMethodAccount[]
  fiscalPeriods          FiscalPeriod[]
  fiscalIssuer           FiscalIssuer?
  fiscalSequences        FiscalSequence[]
  fiscalContingencies    FiscalContingency[]
  fiscalDocuments        FiscalDocument[]
  financeBookLayouts     FinanceBookLayout[]
  financeBookSnapshots   FinanceBookSnapshot[]
  journalEntries         JournalEntry[]
  journalLines           JournalLine[]
  periodBalances         AccountPeriodBalance[]
  postingFailures        FinancePostingFailure[]
  chainIncidents         FinanceChainIncident[]
  bankProfiles           BankImportProfile[]
  bankImports            BankStatementImport[]
  bankLines              BankStatementLine[]
  reconciliationMatches  ReconciliationMatch[]
  financeTransactions    FinanceTransaction[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  purchaseReceipts       PurchaseReceipt[]
  supplierPayments       SupplierPayment[]
  supplierPaymentReturns SupplierPaymentReturn[]
  plugins                Plugin[]

  @@map("organizations")
}

model Store {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  timezone       String   @default("America/El_Salvador")
  currency       String   @default("USD")
  defaultLocale  String   @default("es") @map("default_locale")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settings                 StoreSettings?
  businessHours            BusinessHours?
  routingRules             RoutingRule[]
  memberships              Membership[]
  invitations              Invitation[]
  roles                    Role[]
  conversations            Conversation[]
  messages                 Message[]
  conversationOrigins      ConversationOrigin[]
  messageReactions         MessageReaction[]
  messageRevisions         MessageRevision[]
  customers                Customer[]
  customerIdentities       CustomerIdentity[]
  customerMerges           CustomerMerge[]
  customerFiscalData       CustomerFiscalData[]
  orders                   Order[]
  products                 Product[]
  inventoryMovements       InventoryMovement[]
  inventoryLevels          InventoryLevel[]
  storeWarehouses          StoreWarehouse[]
  orderItemAllocations     OrderItemAllocation[]
  stockCountLines          StockCountLine[]
  stockTransferLines       StockTransferLine[]
  journalLines             JournalLine[]
  periodBalances           AccountPeriodBalance[]
  paymentAccounts          PaymentMethodAccount[]
  financeTransactions      FinanceTransaction[]
  purchaseOrderLines       PurchaseOrderLine[]
  purchaseReceiptLines     PurchaseReceiptLine[]
  tags                     Tag[]
  snippets                 Snippet[]
  media                    Media[]
  channelConnections       ChannelConnection[]
  pluginInstallations      PluginInstallation[]
  webhooks                 Webhook[]
  apiKeys                  ApiKey[]
  notifications            Notification[]
  notificationPrefs        NotificationPreference[]
  retentionSettings        RetentionSettings?
  scheduledReports         ScheduledReport[]
  analyticsEvents          AnalyticsEvent[]
  metricsHourly            MetricHourly[]
  metricsDaily             MetricDaily[]
  consentRecords           ConsentRecord[]
  exports                  Export[]
  carrierConnections       CarrierConnection[]
  carrierGuidePolicies     CarrierGuidePolicy[]
  carrierGuideMovements    CarrierGuideMovement[]
  carrierBenefitPeriods    CarrierBenefitPeriod[]
  carrierServices          CarrierService[]
  guideSequences           GuideSequence[]
  shipments                Shipment[]
  shipmentEvents           ShipmentEvent[]
  carrierStatusMappings    CarrierStatusMapping[]
  carrierUnmappedStatuses  CarrierUnmappedStatus[]
  pickupRequests           PickupRequest[]
  bulkLabelJobs            BulkLabelJob[]
  orderMessageTemplates    OrderMessageTemplate[]
  orderMessageDispatches   OrderMessageDispatch[]
  codRemittances           CodRemittance[]
  codRemittanceLines       CodRemittanceLine[]
  remittanceImportProfiles RemittanceImportProfile[]
  orderReturns             OrderReturn[]
  orderReturnLines         OrderReturnLine[]
  returnReceptionBatches   ReturnReceptionBatch[]
  returnReceptionItems     ReturnReceptionItem[]
  fiscalDocuments          FiscalDocument[]

  @@unique([organizationId, slug])
  // So that a link to a store can name its organization and the database check that they go together (StoreWarehouse)
  @@unique([organizationId, id])
  @@map("stores")
}

// Per-store behaviour toggles (TDD_09 §3, §11). One row per store, created with the store.
model StoreSettings {
  storeId                    String   @id @map("store_id")
  reopenWindowDays           Int?     @map("reopen_window_days") // null: a customer keeps one thread per channel for good (TDD_09 §3.3)
  autoArchiveAfterDays       Int      @default(30) @map("auto_archive_after_days")
  resolveShowOptions         Boolean  @default(false) @map("resolve_show_options")
  sendClosingMessage         Boolean  @default(false) @map("send_closing_message")
  closingSnippetId           String?  @map("closing_snippet_id")
  requestCsat                Boolean  @default(false) @map("request_csat")
  agentLoadThreshold         Int      @default(8) @map("agent_load_threshold") // Team widget "above threshold"
  // Safety & confirmations (TDD_09 §11.2): { confirmDeleteCustomer, confirmDisconnectChannel,
  // confirmRemoveMember, applyToRoles: RoleName[], moderateRiskMode: 'dialog'|'undo'|'none' }
  safety                     Json     @default("{}")
  preferences                Json     @default("{}") // storePreferencesSchema (TDD_17 §4.14)
  returnShippingPayer        String   @default("sender") @map("return_shipping_payer")
  defaultCarrierConnectionId String?  @map("default_carrier_connection_id") // Plain column until Step 4.8
  bulkLabelRetentionDays     Int      @default(7) @map("bulk_label_retention_days")
  // Inventory (TDD_16 §2, §4.1, §4.4, §4.10): the three are edited in Settings -> Inventory
  defaultLowStockThreshold   Int?     @map("default_low_stock_threshold") // The threshold a new product starts with; null = none
  allowNegativeStock         Boolean  @default(false) @map("allow_negative_stock")
  allowSplitFulfillment      Boolean  @default(false) @map("allow_split_fulfillment")
  // Orders (TDD_17 §4.3): the number the next order of the store takes; OrdersService raises it as it makes the order
  nextOrderNumber            Int      @default(1) @map("next_order_number")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

model BusinessHours {
  storeId              String   @id @map("store_id")
  timezone             String
  // { mon: [{ from: "09:00", to: "18:00" }], ..., sun: [] }
  schedule             Json
  awayMessageSnippetId String?  @map("away_message_snippet_id")
  updatedAt            DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("business_hours")
}

// Assignment rules evaluated in priority order on every new inbound conversation
// (TDD_10 §4 step "routing"). conditions/action shapes are Zod schemas in
// libs/core/domain/schemas/routing-rule.schema.ts.
model RoutingRule {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  name       String
  priority   Int
  enabled    Boolean  @default(true)
  // { channelTypes?: ChannelType[], tagIds?: string[], keywords?: string[], outsideBusinessHours?: boolean }
  conditions Json
  // { type: 'assign_user' | 'round_robin' | 'unassigned', userIds?: string[] }
  action     Json
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, priority])
  @@index([storeId, enabled])
  @@map("routing_rules")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false) @map("email_verified")
  emailValid    Boolean  @default(true) @map("email_valid")
  avatarMediaId String?  @map("avatar_media_id")
  locale        String   @default("es")
  timezone      String?
  density       String   @default("comfortable") // UI preference
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  memberships             Membership[]
  messages                Message[]
  messageReactions        MessageReaction[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  notificationSettings    UserNotificationSettings?
  pushSubscriptions       PushSubscription[]
  auditLogs               AuditLog[]
  sessions                Session[]
  verificationTokens      VerificationToken[]
  invitationsSent         Invitation[]              @relation("InvitedBy")
  invitationsAccepted     Invitation[]              @relation("AcceptedBy")
  cookieConsents          CookieConsent[]

  @@map("users")
}

// Refresh-token rotation with family tracking (§7). One row per issued refresh token;
// a family is the chain started at login. Reuse of a consumed token revokes the family.
model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  familyId         String    @map("family_id")
  refreshTokenHash String    @unique @map("refresh_token_hash") // sha256; the raw token is never stored
  replacedById     String?   @unique @map("replaced_by_id")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  familyExpiresAt  DateTime  @map("family_expires_at") // The login ends here whatever the refreshes: the same value across the family
  consumedAt       DateTime? @map("consumed_at")
  graceUsedAt      DateTime? @map("grace_used_at") // The one time a consumed token came back inside the grace window
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy Session? @relation("SessionRotation", fields: [replacedById], references: [id])
  replaces   Session? @relation("SessionRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

// Magic-link login and DSR verification (TDD_07 §5.3, TDD_05 §10.2).
model VerificationToken {
  id        String    @id @default(uuid())
  type      String // VerificationTokenType
  tokenHash String    @unique @map("token_hash")
  userId    String?   @map("user_id")
  subject   String? // Email or DSR id when there is no user
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// A pending invitation is NOT a Membership: the invitee may not have a User yet.
// Membership rows are created only on acceptance (TDD_07 §5.3).
model Invitation {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  storeId        String    @map("store_id")
  email          String
  roleId         String    @map("role_id")
  tokenHash      String    @unique @map("token_hash")
  status         String    @default("PENDING") // InvitationStatus
  invitedById    String    @map("invited_by_id")
  acceptedById   String?   @map("accepted_by_id")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("AcceptedBy", fields: [acceptedById], references: [id])

  @@unique([storeId, email, status]) // One PENDING invitation per email per store (partial index in §5)
  @@index([storeId, status])
  @@map("invitations")
}

model Membership {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  organizationId String    @map("organization_id")
  storeId        String    @map("store_id")
  roleId         String    @map("role_id")
  status         String    @default("ACTIVE") // MembershipStatus
  invitationId   String?   @map("invitation_id")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, storeId])
  @@index([storeId, status])
  @@index([userId])
  @@index([organizationId, status])
  @@map("memberships")
}

// System presets have storeId = null and isSystem = true. Uniqueness of system role
// names is enforced by a partial unique index in §5 (NULLs are distinct in Postgres). A custom role's
// name is unique per store, case-insensitively, by the partial index uq_roles_store_name (raw SQL, on lower(name)).
model Role {
  id          String   @id @default(uuid())
  storeId     String?  @map("store_id")
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store       Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  permissions Permission[]
  memberships Membership[]
  invitations Invitation[]

  @@index([storeId])
  @@map("roles")
}

model Permission {
  id     String @id @default(uuid())
  name   String // Permission (TDD_02 §4)
  roleId String @map("role_id")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, name])
  @@map("permissions")
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id                    String    @id @default(uuid())
  storeId               String    @map("store_id")
  name                  String?
  email                 String?
  phone                 String? // As displayed
  phoneNormalized       String?   @map("phone_normalized") // E.164 digits only, for search
  // Generated by the database (lower(immutable_unaccent(name)), migration search_unaccent): the name as a search
  // compares it, with no accents. Never written; read by the customer search, which is accent-insensitive.
  nameSearch            String?   @map("name_search")
  locale                String? // Detected from channel/messages, for customer-facing copy
  erasedAt              DateTime? @map("erased_at")
  // When the data that hangs from an erased customer (the text of its messages, its files, the names in its notifications) was all cleared: the
  // sweep takes the erased customers that have none (a partial index in raw SQL, Prisma cannot express it)
  erasedDataPurgedAt    DateTime? @map("erased_data_purged_at")
  // When the sweep last tried to clear it: the sweep takes the ones tried longest ago first, so a customer that always fails does not starve the rest
  erasedDataAttemptedAt DateTime? @map("erased_data_attempted_at")
  mergedIntoId          String?   @map("merged_into_id") // Set when absorbed by a merge (row kept 30 days for unmerge)
  isCaution             Boolean   @default(false) @map("is_caution")
  cautionReason         String?   @map("caution_reason")
  cautionSetBy          String?   @map("caution_set_by")
  cautionSetAt          DateTime? @map("caution_set_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  identities    CustomerIdentity[]
  conversations Conversation[]
  orders        Order[]
  addresses     Address[]
  notes         CustomerNote[]
  consents      ConsentRecord[]
  tags          Tag[]               @relation("CustomerTags")
  media         Media[]
  fiscalData    CustomerFiscalData?

  @@index([storeId])
  @@index([storeId, phoneNormalized])
  @@index([storeId, email])
  @@index([storeId, mergedIntoId])
  @@map("customers")
}

// The fiscal data of a customer (Step 4B.7b-3, TDD_18 §8): what the store needs to invoice the person (tax id, registration, kind of
// taxpayer, economic activity, fiscal name and address). One row per customer, sealed like the receiver of a document (the tax id is
// personal and tax data), so the table holds no readable value. What a value must look like is the issuer's provider's rule, applied
// when a person saves it; the document takes a COPY when it is made, so a change here never reaches a document already made. The row goes
// with the customer (CASCADE: a customer with orders is never deleted, so a document's snapshot never depends on this row).
model CustomerFiscalData {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  customerId    String   @unique @map("customer_id")
  dataEncrypted Bytes    @map("data_encrypted")
  updatedBy     String?  @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("customer_fiscal_data")
}

// One row per (store, channel, handle). The SAME phone number in two stores is two
// rows — customers are always store-scoped (TDD_10 §5.2).
model CustomerIdentity {
  id                String    @id @default(uuid())
  storeId           String    @map("store_id")
  customerId        String    @map("customer_id")
  channelType       String    @map("channel_type") // ChannelType
  channelIdentity   String    @map("channel_identity") // phone (E.164), page-scoped id, visitor id, email
  displayName       String?   @map("display_name") // Profile name as reported by the channel
  channelMetadata   Json?     @map("channel_metadata")
  lastInboundAt     DateTime? @map("last_inbound_at") // Drives messaging windows (TDD_10 §4)
  // The first message after a click on an ad: the longer window of the providers that have one counts from it
  adWindowOpenedAt  DateTime? @map("ad_window_opened_at")
  // What the channel keeps for the person (where the provider has them), read by a job after the first message
  // and again once it is stale. The photo link expires and is not stored as a file yet.
  username          String?   @map("username")
  avatarUrl         String?   @map("avatar_url")
  profileFetchedAt  DateTime? @map("profile_fetched_at") // Set on a try that settled, even without a profile
  profileRetryAfter DateTime? @map("profile_retry_after") // After an outage that ate the attempts: not asked before this
  profileFetchError String?   @map("profile_fetch_error") // An ErrorCode of ours; null when the last settled try read a profile
  createdAt         DateTime  @default(now()) @map("created_at")

  store         Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  reactions     MessageReaction[]

  @@unique([storeId, channelType, channelIdentity])
  @@index([customerId])
  @@map("customer_identities")
}

model Address {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  label      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?  @map("postal_code")
  country    String   @default("SV")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  authorId   String   @map("author_id")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

// Snapshot that makes "Unmerge within 30 days" possible (TDD_09 §6.1).
model CustomerMerge {
  id           String    @id @default(uuid())
  storeId      String    @map("store_id")
  survivorId   String    @map("survivor_id")
  absorbedId   String    @map("absorbed_id")
  // { absorbed: Customer, identityIds, conversationIds, orderIds, addressIds, noteIds, tagIds, fieldChoices }
  snapshot     Json
  mergedById   String    @map("merged_by_id")
  mergedAt     DateTime  @default(now()) @map("merged_at")
  unmergeUntil DateTime  @map("unmerge_until")
  unmergedAt   DateTime? @map("unmerged_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, survivorId])
  @@index([unmergeUntil])
  @@map("customer_merges")
}

// ============================================================
// CONVERSATIONS & MESSAGES
// ============================================================

model Conversation {
  id                       String    @id @default(uuid())
  storeId                  String    @map("store_id")
  customerId               String    @map("customer_id")
  customerIdentityId       String    @map("customer_identity_id") // Which handle the customer used
  channelConnectionId      String    @map("channel_connection_id") // Which of our accounts received it → outbound route
  channelType              String    @map("channel_type") // ChannelType, denormalized for filters
  status                   String    @default("OPEN") // ConversationStatus
  assignedTo               String?   @map("assigned_to")
  unreadCount              Int       @default(0) @map("unread_count") // Inbound messages not yet read by an agent
  lastReadAt               DateTime? @map("last_read_at")
  lastReadBy               String?   @map("last_read_by")
  lastMessageAt            DateTime? @map("last_message_at")
  lastInboundAt            DateTime? @map("last_inbound_at")
  lastOutboundAt           DateTime? @map("last_outbound_at")
  firstResponseAt          DateTime? @map("first_response_at") // First reply of a person (an agent), for the first response time (TDD_11 §7.2)
  firstAutomatedResponseAt DateTime? @map("first_automated_response_at") // First reply of an automation (a plugin as system), reported apart: it never stands for a person's answer
  resolvedAt               DateTime? @map("resolved_at")
  resolutionReason         String?   @map("resolution_reason")
  csatScore                Int?      @map("csat_score") // 1-5
  csatComment              String?   @map("csat_comment")
  archivedAt               DateTime? @map("archived_at")
  snoozedUntil             DateTime? @map("snoozed_until")
  snoozeNote               String?   @map("snooze_note") // What the agent said it waits for; AttentionReasons use it on waking
  attentionReason          String?   @map("attention_reason") // AttentionReason: a mark that raises the row in the list until it is opened
  attentionAt              DateTime? @map("attention_at")
  attentionNote            String?   @map("attention_note")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  store             Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer          Customer             @relation(fields: [customerId], references: [id])
  customerIdentity  CustomerIdentity     @relation(fields: [customerIdentityId], references: [id])
  channelConnection ChannelConnection    @relation(fields: [channelConnectionId], references: [id])
  messages          Message[]
  origins           ConversationOrigin[]
  tags              Tag[]                @relation("ConversationTags")

  @@index([storeId, status, assignedTo, lastMessageAt(sort: Desc)])
  @@index([storeId, lastMessageAt(sort: Desc)])
  @@index([storeId, channelType, status])
  @@index([storeId, customerId])
  @@index([customerIdentityId])
  @@index([snoozedUntil])
  @@index([status, resolvedAt]) // Auto-archive scheduler
  @@index([storeId, createdAt]) // The rollups of analytics (TDD_11 §7.2) read a period of the store
  @@index([storeId, resolvedAt])
  @@index([storeId, firstResponseAt])
  @@map("conversations")
}

model Message {
  id                      String    @id @default(uuid())
  storeId                 String    @map("store_id") // Denormalized: RLS, exports, retention
  conversationId          String    @map("conversation_id")
  type                    String // MessageType
  content                 String?
  authorType              String    @map("author_type") // AuthorType
  authorId                String?   @map("author_id") // User id for AGENT, null otherwise
  channelMessageId        String?   @map("channel_message_id") // Provider id; unique per conversation
  // Provider id of the message that carried the caption of a file (some providers send it apart): the echo of it is this message
  captionChannelMessageId String?   @map("caption_channel_message_id")
  // CaptionState of the text under a file that the channel sends as a message of its own; null otherwise
  captionState            String?   @map("caption_state")
  // The text of a media message (`content`) is its own message sent after every file, not the text under the first one (the channel carries a text under each file: `CAPTION_PER_FILE`); false for a message sent before, and where the channel puts the one text with the first file
  textApart               Boolean   @default(false) @map("text_apart")
  idempotencyKey          String?   @map("idempotency_key") // Client-generated for outbound (TDD_06 §4)
  replyToMessageId        String?   @map("reply_to_message_id")
  // The file of an album the reply quotes (an agent chose one file); null: the message, or its first file. Checked when written, no FK (like the id above)
  replyToMediaId          String?   @map("reply_to_media_id")
  deliveryStatus          String?   @map("delivery_status") // DeliveryStatus, outbound only
  deliveryError           String?   @map("delivery_error") // ErrorCode when FAILED
  // Set with a FAILED status: true when the failure means the provider did NOT take the message (a refusal, a
  // check that failed before sending), false when it may have (a timeout, an answer that made no sense), null
  // for a failure from before this was recorded. Only a reply known not to have gone can be discarded.
  failureDefinitive       Boolean?  @map("failure_definitive")
  resentAt                DateTime? @map("resent_at") // When an agent sent a failed reply again; the outbound sweep counts its age from here
  mentions                String[]  @default([]) // User ids mentioned in an internal note
  metadata                Json? // Channel-specific metadata
  createdAt               DateTime  @default(now()) @map("created_at")

  // Edits. `version` starts at 1 and grows with each edit of the text: an edit of a note carries the
  // one it saw. `pendingContent` is the text of an edit of ours that the channel has not taken yet: the
  // thread shows `content` until it does, and an edit the channel refuses never changes it.
  version             Int       @default(1)
  editedAt            DateTime? @map("edited_at")
  editedByType        String?   @map("edited_by_type") // AuthorType
  editedById          String?   @map("edited_by_id") // User id when an agent edited
  // The plugin that edited it (TDD_10 §6), instead of a person; never both. No FK, like `authorPluginId`
  editedByPluginId    String?   @map("edited_by_plugin_id")
  // The plugin that asked for the edit the channel has not taken yet; the worker records it as the editor when it settles
  pendingEditPluginId String?   @map("pending_edit_plugin_id")
  pendingContent      String?   @map("pending_content")
  editStatus          String?   @map("edit_status") // DeliveryStatus of an edit toward the channel
  editError           String?   @map("edit_error") // ErrorCode of a failed one

  // Deletion. `deletedAt` is when the message stopped being shown; a deletion of ours that the channel
  // has not taken yet is `deleteStatus` queued with no `deletedAt`. The text stays until
  // `contentPurgedAt` (DeletedMessageRetention), read only with MESSAGES_VIEW_DELETED.
  deletedAt         DateTime? @map("deleted_at")
  deletedByType     String?   @map("deleted_by_type") // AuthorType
  deletedById       String?   @map("deleted_by_id") // User id when an agent deleted
  // The plugin that deleted it, instead of a person; never both. No FK, like `authorPluginId`
  deletedByPluginId String?   @map("deleted_by_plugin_id")
  deleteStatus      String?   @map("delete_status") // DeliveryStatus of a deletion toward the channel
  deleteError       String?   @map("delete_error") // ErrorCode of a failed one
  // When the agent asked for the edit or the deletion that is queued; the sweep reads it to find a job that was lost
  changeRequestedAt DateTime? @map("change_requested_at")
  contentPurgedAt   DateTime? @map("content_purged_at")
  // A reply of the team that failed for good and that an agent threw away: it is not shown anywhere, and its
  // text goes with the retention of the deleted ones. It also has `deletedAt`, so every rule of the deleted
  // applies; this is what tells it from one that was deleted for the customer to see as a tombstone.
  discardedAt       DateTime? @map("discarded_at")
  // The plugin that wrote the message (TDD_10 §6), whatever the author type says: `system` or `agent` (a person of the team on whose
  // behalf it wrote). Null for a message no plugin wrote. Kept if the plugin is later revoked. No FK, like the other ids of a message
  // (the route takes it from the installation of the key): a FK would scan `messages` to be added and again to delete a plugin.
  authorPluginId    String?   @map("author_plugin_id")
  // The name the message shows for a plugin that wrote as `system` (the plugin chose it, cleaned); null for any other message
  authorNickname    String?   @map("author_nickname")

  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?               @relation(fields: [authorId], references: [id])
  media        Media[]
  origin       ConversationOrigin?
  reactions    MessageReaction[]
  revisions    MessageRevision[]

  @@unique([conversationId, channelMessageId])
  @@unique([conversationId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@index([conversationId, captionChannelMessageId])
  @@index([storeId, createdAt])
  @@index([deletedAt])
  @@map("messages")
}

// The text a message had before an edit, one row for each edit: who edited, when, and the text it
// replaced. Kept with the message; the text goes with a purge of a deleted message.
model MessageRevision {
  id               String   @id @default(uuid())
  storeId          String   @map("store_id")
  messageId        String   @map("message_id")
  version          Int // The version the text had
  content          String?
  editedByType     String   @map("edited_by_type") // AuthorType
  editedById       String?  @map("edited_by_id")
  // The plugin that edited, instead of a person; never both. No FK
  editedByPluginId String?  @map("edited_by_plugin_id")
  createdAt        DateTime @default(now()) @map("created_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, version])
  @@index([storeId])
  @@map("message_revisions")
}

// One emoji that one person left on a message. A person has at most one per message (a new emoji
// replaces the old one, taking it back deletes the row): the customer by identity, an agent by user, and
// the owner who reacts from the provider's own app, who is not a user of the platform, as one external
// reactor per message. The unique index of the external reactor and the check that each author type
// has its own id column live in the migration, which Prisma cannot express.
model MessageReaction {
  id                 String   @id @default(uuid())
  storeId            String   @map("store_id")
  messageId          String   @map("message_id")
  authorType         String   @map("author_type") // AuthorType: customer, agent or external
  customerIdentityId String?  @map("customer_identity_id")
  userId             String?  @map("user_id")
  // A plugin's reaction: `authorType` is `system` and this is the plugin (no FK); the unique index lives in the migration
  pluginId           String?  @map("plugin_id")
  // The file of an album the reaction is on (one provider message each); null: the message itself, or the first file
  // of a message whose files are not told apart. A person has one reaction for each target, so the unique indexes
  // are raw SQL on `coalesce(media_id, '')` (uq_message_reactions_customer, uq_message_reactions_user).
  mediaId            String?  @map("media_id")
  emoji              String
  // DeliveryStatus of an agent's reaction toward the channel: queued, sent or failed. The reactions the
  // channel reports (customer, external) are already there, so they are sent.
  deliveryStatus     String   @default("sent") @map("delivery_status")
  deliveryError      String?  @map("delivery_error") // ErrorCode of a failed one
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  message          Message           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  customerIdentity CustomerIdentity? @relation(fields: [customerIdentityId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  media            Media?            @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([messageId])
  @@index([mediaId])
  @@index([customerIdentityId])
  @@index([userId])
  @@map("message_reactions")
}

// Where a conversation came from (an ad, a post), read by the plugin from what its provider sent. One
// conversation can come from several ads, so the origin hangs from the message that carried it; the
// thread shows the latest and the first is the first contact.
model ConversationOrigin {
  id             String   @id @default(uuid())
  storeId        String   @map("store_id")
  conversationId String   @map("conversation_id")
  messageId      String   @unique @map("message_id")
  kind           String // OriginKind
  sourceId       String?  @map("source_id")
  sourceUrl      String?  @map("source_url")
  title          String?
  body           String?
  mediaType      String?  @map("media_type") // OriginMediaType
  mediaRef       String?  @map("media_ref") // Provider reference, fetched like any media
  mediaUrl       String?  @map("media_url")
  thumbnailUrl   String?  @map("thumbnail_url")
  clickId        String?  @map("click_id")
  // What the provider sent, untouched: the first real ad teaches what the columns missed
  referral       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // The picture and the thumbnail of the ad, fetched by the worker (purpose origin)
  files        Media[]

  @@index([conversationId, createdAt])
  @@index([storeId])
  @@map("conversation_origins")
}

model Tag {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  name        String
  color       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  conversations Conversation[] @relation("ConversationTags")
  customers     Customer[]     @relation("CustomerTags")

  // Also uq_tags_store_name_ci (store_id, lower(name)) in the raw SQL of 20261026140000: the name is
  // unique whatever its case, which the schema cannot say
  @@unique([storeId, name])
  @@map("tags")
}

model Snippet {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  shortcut  String
  title     String
  content   String
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shortcut])
  @@map("snippets")
}

// ============================================================
// ORDERS, PRODUCTS & INVENTORY
// ============================================================

model Order {
  id                               String    @id @default(uuid())
  storeId                          String    @map("store_id")
  customerId                       String    @map("customer_id")
  conversationId                   String?   @map("conversation_id")
  orderNumber                      String    @map("order_number")
  status                           String    @default("PENDING_CONFIRMATION") // OrderStatus
  subtotalCents                    Int       @map("subtotal_cents")
  shippingCents                    Int       @default(0) @map("shipping_cents")
  discountCents                    Int       @default(0) @map("discount_cents")
  totalCents                       Int       @map("total_cents")
  currency                         String    @default("USD")
  paymentMethod                    String    @map("payment_method") // PaymentMethod
  paymentStatus                    String    @default("PENDING") @map("payment_status") // PaymentStatus
  paymentReference                 String?   @map("payment_reference") // The transfer or deposit number of a payment recorded by hand (v1.2: no online payment)
  paymentProofMediaId              String?   @map("payment_proof_media_id") // The receipt, a file of purpose order; plain column like proofOfDeliveryMediaId
  shippingAddress                  Json?     @map("shipping_address")
  customerNotes                    String?   @map("customer_notes")
  internalNotes                    String?   @map("internal_notes") // Customer-care note: members with a permission on the order only, never the customer, a channel, a plugin or the label
  packingNotes                     String?   @map("packing_notes") // For whoever packs the order: same audience as internalNotes, and the warehouse is told when it changes on a confirmed order
  recipientPhones                  String[]  @default([]) @map("recipient_phones") // National digits, no country code (the carriers take none); the first is the main number (TDD_02 §13)
  scheduledDeliveryDate            DateTime? @map("scheduled_delivery_date") @db.Date // A calendar day in the store timezone, no time of day (D18)
  trackingNumber                   String?   @map("tracking_number")
  cancellationReason               String?   @map("cancellation_reason")
  cancelledBy                      String?   @map("cancelled_by")
  cancelledByPluginId              String?   @map("cancelled_by_plugin_id") // The plugin that did it, when no person did: never both (a check)
  proofOfDeliveryMediaId           String?   @map("proof_of_delivery_media_id")
  confirmedAt                      DateTime? @map("confirmed_at")
  confirmedBy                      String?   @map("confirmed_by")
  confirmedByPluginId              String?   @map("confirmed_by_plugin_id")
  confirmedVia                     String?   @map("confirmed_via") // OrderConfirmationChannel
  exchangeOfOrderId                String?   @map("exchange_of_order_id") // The order this one replaces
  copiedFromOrderId                String?   @map("copied_from_order_id") // The order it was copied from
  freeShipping                     Boolean   @default(false) @map("free_shipping") // Derived and stored on save (TDD_17 §4.13)
  discountReason                   String?   @map("discount_reason")
  priceApprovalStatus              String    @default("not_required") @map("price_approval_status") // PriceApprovalStatus
  priceApprovalRequestedBy         String?   @map("price_approval_requested_by")
  priceApprovalRequestedByPluginId String?   @map("price_approval_requested_by_plugin_id")
  priceApprovedBy                  String?   @map("price_approved_by")
  priceApprovedByPluginId          String?   @map("price_approved_by_plugin_id")
  priceApprovedAt                  DateTime? @map("price_approved_at")
  priceApprovedDiscountCents       Int?      @map("price_approved_discount_cents")
  priceApprovedShippingCents       Int?      @map("price_approved_shipping_cents")
  carrierConnectionId              String?   @map("carrier_connection_id") // The planned carrier (TDD_17 §4.13); composite foreign key with the store, Step 4.8 PR C1
  taxCents                         Int?      @map("tax_cents") // The tax of the order, fixed at creation (TDD_18 §7); null on an order made before the tax columns
  pricesIncludeTax                 Boolean?  @map("prices_include_tax") // Whether the prices were tax included when it was made; null as above
  shippingTaxRateBps               Int?      @map("shipping_tax_rate_bps") // The rate the shipping fee was taxed at; null when it was not taxed
  taxRounding                      String?   @map("tax_rounding") // The rounding the tax was made with (a TaxRounding); null on an order made before this column
  createdBy                        String?   @map("created_by") // Null when a plugin made it (`createdByPluginId`): exactly one of the two (a check)
  createdByPluginId                String?   @map("created_by_plugin_id")
  createdAt                        DateTime  @default(now()) @map("created_at")
  updatedAt                        DateTime  @updatedAt @map("updated_at")
  shippedAt                        DateTime? @map("shipped_at")
  deliveredAt                      DateTime? @map("delivered_at")
  cancelledAt                      DateTime? @map("cancelled_at")

  store              Store                  @relation(fields: [storeId], references: [id]) // No cascade: tax retention
  carrierConnection  CarrierConnection?     @relation(fields: [storeId, carrierConnectionId], references: [storeId, id], onDelete: Restrict)
  customer           Customer               @relation(fields: [customerId], references: [id])
  items              OrderItem[]
  media              Media[]
  // The shipping tables of Step 4.8 point at the order with a plain foreign key (an order has no (store_id, id) key)
  shipments          Shipment[]
  messageDispatches  OrderMessageDispatch[]
  returns            OrderReturn[]          @relation("ReturnOrder")
  replacementReturns OrderReturn[]          @relation("ReturnReplacement")
  fiscalDocuments    FiscalDocument[]

  @@unique([storeId, orderNumber])
  // The key the records that hang from an order point at, so that the database refuses one of another store
  @@unique([storeId, id])
  @@index([storeId, status, createdAt(sort: Desc)])
  @@index([storeId, carrierConnectionId])
  @@index([storeId, customerId])
  @@index([storeId, scheduledDeliveryDate])
  @@index([storeId, createdAt]) // The rollups of analytics
  @@index([conversationId])
  @@map("orders")
}

model OrderItem {
  id                     String  @id @default(uuid())
  orderId                String  @map("order_id")
  productId              String  @map("product_id")
  variantId              String? @map("variant_id")
  productName            String  @map("product_name") // Denormalized snapshot at time of order
  variantName            String? @map("variant_name")
  quantity               Int
  unitPriceCents         Int     @map("unit_price_cents") // Snapshot; never trusted from the client
  originalUnitPriceCents Int?    @map("original_unit_price_cents") // Null unless the price was overridden
  priceOverrideReason    String? @map("price_override_reason")
  priceOverriddenBy      String? @map("price_overridden_by")
  freeShipping           Boolean @default(false) @map("free_shipping") // Snapshot of Product.freeShipping at order time
  taxTreatment           String? @map("tax_treatment") // Snapshot of the treatment at order time (TDD_18 §7); null on an order made before
  taxRateBps             Int?    @map("tax_rate_bps") // Snapshot of the rate of a taxed line; null for an exempt or not subject one
  taxCents               Int?    @map("tax_cents") // The tax of the line, after its share of the discount

  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product               @relation(fields: [productId], references: [id])
  variant     ProductVariant?       @relation(fields: [variantId], references: [id])
  allocations OrderItemAllocation[]
  returnLines OrderReturnLine[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model Product {
  id                String   @id @default(uuid())
  storeId           String   @map("store_id")
  name              String
  description       String?
  priceCents        Int      @map("price_cents")
  costCents         Int?     @map("cost_cents") // Reference cost per unit in USD cents; the cost of a unit in stock is the one of its movements (Step 4.2)
  sku               String?
  imageMediaId      String?  @map("image_media_id")
  trackInventory    Boolean  @default(true) @map("track_inventory")
  lowStockThreshold Int?     @map("low_stock_threshold") // Null = no low-stock alert (TDD_16 §4.4)
  active            Boolean  @default(true)
  freeShipping      Boolean  @default(false) @map("free_shipping") // The price already includes shipping (TDD_17 §4.13)
  taxTreatment      String   @default("taxed") @map("tax_treatment") // TaxTreatment (TDD_18 §7)
  taxRateId         String?  @map("tax_rate_id") // A rate other than the default of the organization; only for a taxed product
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  taxRate         TaxRate?            @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  variants        ProductVariant[]
  inventory       InventoryMovement[]
  inventoryLevels InventoryLevel[]
  stockCountLines StockCountLine[]
  transferLines   StockTransferLine[]
  purchaseLines   PurchaseOrderLine[]
  orderItems      OrderItem[]
  media           Media[]

  @@unique([storeId, sku])
  // So that the stock of a product can name its store and the database check that they go together
  @@unique([storeId, id])
  @@index([storeId, active])
  @@index([taxRateId])
  @@map("products")
}

// "Size 42", "Red / L". A product without variants sells the product row itself.
model ProductVariant {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  name       String // Display: "42", "Rojo / L"
  sku        String?
  priceCents Int?     @map("price_cents") // Null = inherits Product.priceCents
  costCents  Int?     @map("cost_cents") // Null = inherits Product.costCents
  attributes Json // { size: "42", color: "red" }
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory       InventoryMovement[]
  inventoryLevels InventoryLevel[]
  stockCountLines StockCountLine[]
  transferLines   StockTransferLine[]
  purchaseLines   PurchaseOrderLine[]
  orderItems      OrderItem[]

  @@unique([productId, name])
  @@unique([productId, sku])
  @@index([productId, active])
  @@map("product_variants")
}

// The ledger of stock (TDD_16 §2): append-only, the audit trail of InventoryLevel and the source of reconciliation.
// `quantity` is always positive and `type` carries the direction. The database refuses UPDATE and DELETE on it to
// the application roles, and a store with stock cannot be deleted (TDD_16 §4.9: the foreign keys restrict it).
model InventoryMovement {
  id                String   @id @default(uuid())
  // The order in which the ledger was written: the kardex reads by it, because every movement of a transaction has
  // the same created_at (the database default is the start of the transaction) and ids are random
  seq               BigInt   @unique @default(autoincrement())
  storeId           String   @map("store_id")
  productId         String   @map("product_id")
  variantId         String?  @map("variant_id")
  warehouseId       String   @map("warehouse_id")
  type              String // InventoryMovementType
  quantity          Int
  reason            String? // InventoryAdjustmentReason, set for the manual types
  note              String?
  referenceType     String?  @map("reference_type") // InventoryReferenceType
  referenceId       String?  @map("reference_id")
  idempotencyKey    String   @map("idempotency_key")
  // The cost of ONE unit, in whole USD cents, for the movements that bring units in (receipts, opening stock,
  // returns); null for the rest (a reserve has no cost) and for units whose cost is not known. The weighted-average
  // cost of a level is kept from these (InventoryLevel.valueCents), and FIFO lots can later be built from the receipts
  // without changing this table.
  unitCostCents     Int?     @map("unit_cost_cents")
  // The value the movement moved in or out of the level, in whole USD cents (what the books post, TDD_18 §4.2): units x the rounded
  // unit cost differs from it by a cent or two when the average has a fraction of a cent. Null for a reserve, a release, units that were
  // never on hand, and the rows written before the column existed (those are valued at units x unit cost).
  valueCents        BigInt?  @map("value_cents")
  onHandAfter       Int      @map("on_hand_after")
  reservedAfter     Int      @map("reserved_after")
  createdBy         String?  @map("created_by")
  createdByPluginId String?  @map("created_by_plugin_id") // The plugin that moved it; null with a null person is the system
  createdAt         DateTime @default(now()) @map("created_at")

  store     Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product   Product         @relation(fields: [storeId, productId], references: [storeId, id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])

  // The key is the caller's, so it is unique inside a store: tenants never share a namespace
  @@unique([storeId, idempotencyKey])
  @@index([productId, variantId, type, createdAt(sort: Desc)])
  @@index([storeId, warehouseId, createdAt(sort: Desc)])
  // The kardex and the reconciliation of one item in one warehouse, in the order of the ledger
  @@index([storeId, productId, warehouseId, variantId, seq(sort: Desc)])
  @@index([warehouseId])
  @@index([variantId])
  @@map("inventory_movements")
}

// A place where stock is kept. It belongs to the ORGANIZATION and can supply several of its stores (TDD_16 §1).
// The transfers that refer to it (StockTransfer) arrive with Step 4.5; its counts (StockCount) are below.
// The transfers that refer to it are StockTransfer (Step 4.5); the counts (StockCount) arrive with Step 4.6.
model Warehouse {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String // Short, printed on documents. Unique per organization
  address        Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stores       StoreWarehouse[]
  levels       InventoryLevel[]
  movements    InventoryMovement[]
  allocations  OrderItemAllocation[]
  counts       StockCount[]
  transfersOut StockTransfer[]       @relation("TransferFrom")
  transfersIn  StockTransfer[]       @relation("TransferTo")
  shipments    Shipment[]
  returnLines  OrderReturnLine[]
  purchases    PurchaseOrder[]

  @@unique([organizationId, code])
  // So that a link can name its organization and the database check that they go together (StoreWarehouse)
  @@unique([organizationId, id])
  @@map("warehouses")
}

// Which warehouses a store sells from; priority 1 is reserved first (TDD_16 §4.1). Both foreign keys carry the
// organization, so the database itself refuses to link a store to a warehouse of another organization.
model StoreWarehouse {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  storeId        String @map("store_id")
  warehouseId    String @map("warehouse_id")
  priority       Int

  store     Store     @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Cascade)

  @@unique([storeId, warehouseId])
  // One warehouse per priority of a store: (store_id, priority) is a DEFERRABLE unique constraint in the raw SQL of the
  // migration, so that the priorities can be swapped or shifted inside one transaction (Prisma cannot declare it)
  @@index([warehouseId])
  @@map("store_warehouses")
}

// The current stock of one item in one warehouse; variantId is null for a product without variants. Reads use this
// table and the ledger above is the trail; both change in ONE transaction (TDD_16 §4.2).
model InventoryLevel {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  productId   String   @map("product_id")
  variantId   String?  @map("variant_id")
  warehouseId String   @map("warehouse_id")
  onHand      Int      @default(0) @map("on_hand")
  reserved    Int      @default(0)
  // What the units on hand are worth at their cost, in USD cents (weighted-average costing: the average cost is
  // this divided by onHand). BigInt because a big stock of a dear item does not fit in 32 bits of cents.
  valueCents  BigInt   @default(0) @map("value_cents")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store     Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product   Product         @relation(fields: [storeId, productId], references: [storeId, id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])

  @@index([storeId, warehouseId])
  @@index([productId, variantId])
  @@index([warehouseId])
  @@index([variantId])
  @@map("inventory_levels")
}

// Which warehouse serves how many units of an order line; with split fulfillment (TDD_16 §4.1) a line can have
// several. The quantities of a line's allocations add up to OrderItem.quantity (checked by InventoryService).
model OrderItemAllocation {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  orderItemId String   @map("order_item_id")
  warehouseId String   @map("warehouse_id")
  quantity    Int
  createdAt   DateTime @default(now()) @map("created_at")

  store     Store     @relation(fields: [storeId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([orderItemId, warehouseId])
  @@index([storeId])
  @@index([warehouseId])
  @@map("order_item_allocations")
}

// A physical count of one warehouse (TDD_16 §4.6). The header belongs to the ORGANIZATION; its lines to the store of the
// product they count. `storeId` limits the count to the products of one store (null: every store that keeps stock
// there); its foreign key (organization_id, store_id) is declared in the raw SQL of the migration, because Prisma cannot
// declare a composite relation with an optional column.
model StockCount {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  warehouseId       String    @map("warehouse_id")
  number            String // "CT-0001", unique inside the organization
  status            String    @default("draft") // CountStatus
  storeId           String?   @map("store_id")
  note              String?
  createdBy         String?   @map("created_by") // Null when a plugin made it (createdByPluginId): exactly one of the two is set
  createdByPluginId String?   @map("created_by_plugin_id")
  startedAt         DateTime? @map("started_at")
  submittedAt       DateTime? @map("submitted_at")
  appliedBy         String?   @map("applied_by")
  appliedByPluginId String?   @map("applied_by_plugin_id") // The plugin that applied it, never beside appliedBy
  appliedAt         DateTime? @map("applied_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse        @relation(fields: [organizationId, warehouseId], references: [organizationId, id])
  lines        StockCountLine[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, warehouseId])
  @@index([organizationId, storeId])
  @@map("stock_counts")
}

// One item of a count. `expectedQuantity` is the on-hand snapshot taken when the count started; applying the count
// moves stock by `countedQuantity - expectedQuantity`, never by "counted minus what is there now".
model StockCountLine {
  id               String  @id @default(uuid())
  countId          String  @map("count_id")
  storeId          String  @map("store_id")
  productId        String  @map("product_id")
  variantId        String? @map("variant_id")
  expectedQuantity Int     @map("expected_quantity")
  countedQuantity  Int?    @map("counted_quantity")

  count   StockCount      @relation(fields: [countId], references: [id], onDelete: Cascade)
  store   Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product Product         @relation(fields: [storeId, productId], references: [storeId, id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([countId, storeId])
  @@index([storeId])
  @@index([storeId, productId, variantId])
  @@index([variantId])
  @@map("stock_count_lines")
}

// A shipment of stock from one warehouse to another of the same ORGANIZATION (TDD_16 §4.5). The header belongs to the
// organization; its lines belong to the stores whose products travel. The status only moves through the transfers
// service, which writes the stock through InventoryService and never touches a level itself.
model StockTransfer {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  number               String // "TR-0001", per organization
  fromWarehouseId      String    @map("from_warehouse_id")
  toWarehouseId        String    @map("to_warehouse_id")
  status               String    @default("draft") // TransferStatus
  note                 String?
  createdBy            String?   @map("created_by") // Null when a plugin made it (createdByPluginId): exactly one of the two is set
  createdByPluginId    String?   @map("created_by_plugin_id")
  dispatchedBy         String?   @map("dispatched_by")
  dispatchedByPluginId String?   @map("dispatched_by_plugin_id") // The plugin that sent it, never beside dispatchedBy
  dispatchedAt         DateTime? @map("dispatched_at")
  closedAt             DateTime? @map("closed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Both warehouses carry the organization, so the database refuses a transfer that reaches another organization's
  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse           @relation("TransferFrom", fields: [organizationId, fromWarehouseId], references: [organizationId, id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [organizationId, toWarehouseId], references: [organizationId, id])
  lines         StockTransferLine[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@map("stock_transfers")
}

// One item that travels: `quantity` is what was (or will be) dispatched, `receivedQuantity` what has arrived. The
// STORE is the one of the product: a user sees the lines of the stores they belong to (TDD_16 §1).
model StockTransferLine {
  id               String  @id @default(uuid())
  transferId       String  @map("transfer_id")
  storeId          String  @map("store_id")
  productId        String  @map("product_id")
  variantId        String? @map("variant_id")
  quantity         Int
  receivedQuantity Int     @default(0) @map("received_quantity")
  shortageAction   String? @map("shortage_action") // TransferShortageAction, set on close

  transfer StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  store    Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product  Product         @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Restrict)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // One line per item: the unique indexes of the raw SQL (a null variant is not a value to a unique index)
  @@index([transferId])
  @@index([storeId])
  @@index([productId, variantId])
  @@index([variantId])
  @@map("stock_transfer_lines")
}

// ============================================================
// MEDIA
// ============================================================

model Media {
  id                   String    @id @default(uuid())
  storeId              String?   @map("store_id") // Null only for user avatars
  purpose              String // MediaPurpose: message | origin | product | order | avatar | export
  messageId            String?   @map("message_id")
  originSlot           String?   @map("origin_slot") // OriginMediaSlot: which picture of the ad this is
  originId             String?   @map("origin_id") // Set for the picture of an ad (purpose origin), never for the gallery
  customerId           String?   @map("customer_id") // Set for message media: gallery queries
  productId            String?   @map("product_id")
  orderId              String?   @map("order_id")
  financeTransactionId String?   @map("finance_transaction_id") // The transaction of the books a receipt is for (purpose finance_document)
  fiscalDocumentId     String?   @map("fiscal_document_id") // The fiscal document a file of evidence is for (purpose fiscal_evidence)
  fiscalEvidenceKind   String?   @map("fiscal_evidence_kind") // FiscalEvidenceKind: the document, the answer to its acceptance, the answer to its void
  uploadedBy           String?   @map("uploaded_by") // User id; null for inbound channel media
  key                  String    @unique // S3 object key, built by storage-keys.ts
  filename             String
  contentType          String    @map("content_type")
  fileSize             Int       @map("file_size")
  // { full: key, medium: key, thumb: key } — KEYS, signed at read time (TDD_07 §6.6)
  variants             Json?
  status               String    @default("pending") // MediaStatus
  scanResult           Json?     @map("scan_result") // { viruses: string[] } when infected; { reason } when refused; { sanitized: true } once a picture was cleaned of its metadata (by the scan, or by the sweep of stored pictures, which also writes { sanitized: true, sanitizeSweep: 'already_clean' } for a file that held none); { sanitizeSweep: outcome } for a stored picture the sweep left as it is; { sweepAttempts: n } while the sweep retries one that failed
  processedAt          DateTime? @map("processed_at")
  scannedAt            DateTime? @map("scanned_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  // The files an agent sends in one message: their order and the state of each toward the channel. Null for
  // an inbound file, a gallery file and any file sent before several were allowed (the message's state is theirs).
  position             Int?      @map("position")
  deliveryStatus       String?   @map("delivery_status") // DeliveryStatus: queued | sent | failed (the receipts of the provider move it on)
  channelMessageId     String?   @map("channel_message_id") // Provider id of the message that carried this file
  sendErrorCode        String?   @map("send_error_code") // ErrorCode when its delivery failed
  sentAt               DateTime? @map("sent_at")
  // The text the agent put under this file (null: none, or a file sent before each had its own, when the text
  // of the message was the one of the first). How the text of the message went is on the message.
  caption              String?   @map("caption")

  store              Store?               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  message            Message?             @relation(fields: [messageId], references: [id], onDelete: SetNull)
  origin             ConversationOrigin?  @relation(fields: [originId], references: [id], onDelete: Cascade)
  customer           Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product            Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  order              Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  financeTransaction FinanceTransaction?  @relation("TransactionDocuments", fields: [financeTransactionId], references: [id], onDelete: Restrict)
  documentOf         FinanceTransaction?  @relation("TransactionDocument")
  fiscalDocument     FiscalDocument?      @relation("FiscalEvidence", fields: [fiscalDocumentId], references: [id], onDelete: Restrict)
  bankImport         BankStatementImport? @relation("BankImportFile")
  reactions          MessageReaction[]

  @@index([storeId, createdAt])
  @@index([storeId, customerId, createdAt(sort: Desc)])
  @@index([messageId])
  @@index([originId])
  @@index([status, createdAt])
  @@index([storeId, channelMessageId])
  @@index([productId, storeId])
  @@index([financeTransactionId])
  @@index([fiscalDocumentId])
  @@map("media")
}

// ============================================================
// CHANNELS, PLUGINS & WEBHOOKS
// ============================================================

// One row per (store, plugin, account). connectionId is what the provider sends as the
// RECIPIENT of an inbound webhook (a phone number id, a Page id, an
// account id, widget site key, inbound mailbox address). It is unique per plugin
// platform-wide — a phone number belongs to exactly one store — which is how the inbound
// pipeline resolves the store (TDD_10 §4).
model ChannelConnection {
  id             String    @id @default(uuid())
  storeId        String    @map("store_id")
  pluginId       String    @map("plugin_id") // ChannelType / plugin id
  connectionId   String    @map("connection_id")
  displayName    String    @map("display_name") // "+503 2222-3333", "Mi Empresa (Page)"
  // The name the owner gave to this connection ("Main account"); null while it has none, and then the
  // name of the account (`displayName`) is shown. A connect, a reconnect or a new token never write it.
  label          String?
  status         String    @default("active") // ChannelConnectionStatus
  credentials    Bytes // AES-256-GCM ciphertext (libs/core/crypto)
  metadata       Json?
  lastHealthyAt  DateTime? @map("last_healthy_at")
  lastError      String?   @map("last_error")
  // The installation of the plugin in this store (D19): a connection is the configuration of an
  // installed plugin, and uninstalling it disconnects every one that hangs from it
  installationId String    @map("installation_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  installation  PluginInstallation @relation(fields: [installationId], references: [id], onDelete: Restrict)
  conversations Conversation[]

  @@unique([pluginId, connectionId])
  @@index([storeId, status])
  @@index([installationId])
  @@map("channel_connections")
}

// The catalog entry — one row per plugin, independent of how many stores installed it. The official
// plugins are written here from the code registry at boot (isOfficial true); the owner registers
// the private ones (isOfficial false, pricingModel 'free', status 'approved'). D19.
model Plugin {
  // The manifest's own declared id (TDD_10 §6.1, e.g. "telegram-connector", or a built-in id
  // for an official channel) — not a generated uuid, so it matches PluginInstallation.pluginId
  // and the in-memory registry key exactly.
  id                          String   @id
  name                        String
  authorName                  String   @map("author_name")
  authorEmail                 String   @map("author_email")
  type                        String // 'channel' | 'integration'
  isOfficial                  Boolean  @default(false) @map("is_official")
  manifest                    Json // Full manifest JSON, TDD_10 §6.1
  pricingModel                String   @map("pricing_model") // PluginPricingModels
  priceCents                  Int?     @map("price_cents") // pricingModel = 'paid' only
  platformRevenueSharePercent Int?     @default(20) @map("platform_revenue_share_percent")
  status                      String   @default("submitted") // PluginStatus
  reviewNotes                 String?  @map("review_notes")
  // The organization that registered it (private registration, D10): only its stores see it and install it. Null for the
  // plugins the platform ships and the ones its code registers, which every store sees. Never an official plugin.
  organizationId              String?  @map("organization_id")
  // The platform's own 128 px PNG of the icon of a channel plugin (`plugin-icons/{id}.png`), made once when the plugin is
  // registered; the original the author hosts is never served. Null: no icon, or not fetched yet.
  iconKey                     String?  @map("icon_key")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  organization  Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installations PluginInstallation[]

  @@index([status])
  @@index([organizationId])
  @@map("plugins")
}

model PluginInstallation {
  id                         String    @id @default(uuid())
  storeId                    String    @map("store_id")
  pluginId                   String    @map("plugin_id")
  scopes                     String[] // PluginScope[]
  status                     String    @default("pending_setup") // PluginInstallationStatus
  // The scoped key of a plugin that calls the platform: null for an official channel, which runs
  // inside it and has none
  apiKeyPrefix               String?   @map("api_key_prefix") // First 12 chars, shown in UI
  apiKeyHash                 String?   @unique @map("api_key_hash") // sha256 of the full key
  rateLimitPerMinute         Int       @default(60) @map("rate_limit_per_minute") // From manifest.limits
  // The webhook endpoint that answered the install challenge: the only address a delivery goes to, whatever a newer version of
  // the manifest says. Null for a plugin with no webhooks and for the plugins that run inside the platform.
  webhookEndpoint            String?   @map("webhook_endpoint")
  // The secret that signs each delivery to that endpoint (sealed, as the secret of a tenant webhook): made at the setup exchange and
  // shown to the plugin once with its key. Removed after the last delivery of a revoked installation.
  webhookSecret              Bytes?    @map("webhook_secret")
  // The deliveries that failed for good one after the other; 20 turn the webhooks of the installation off (`webhookDisabledAt`),
  // as for a tenant webhook. Zero after a delivery that went through.
  webhookConsecutiveFailures Int       @default(0) @map("webhook_consecutive_failures")
  webhookLastFailureAt       DateTime? @map("webhook_last_failure_at")
  // Set when the failures turned the webhooks off: nothing is queued for the installation while it is set
  webhookDisabledAt          DateTime? @map("webhook_disabled_at")
  config                     Json?
  // The secret that signs the commands the platform sends to a remote channel plugin (TDD_10 §6.7.3), encrypted as
  // `Webhook.secret` is; null for an installation that is not of a remote channel. The previous one stays valid for 10 minutes
  // after a rotation. The install flow and the rotation arrive with Step 5.6 PR P2 and PR C2.
  commandSecret              Bytes?    @map("command_secret")
  commandSecretPrevious      Bytes?    @map("command_secret_previous")
  commandSecretRotatedAt     DateTime? @map("command_secret_rotated_at")
  installedBy                String    @map("installed_by")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  revokedAt                  DateTime? @map("revoked_at")

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plugin             Plugin              @relation(fields: [pluginId], references: [id], onDelete: Restrict)
  channelConnections ChannelConnection[]
  webhookDeliveries  WebhookDelivery[]

  @@unique([storeId, pluginId])
  @@index([storeId, status])
  @@map("plugin_installations")
}

// Tenant-created outbound webhooks (Settings → Webhooks).
model Webhook {
  id                  String    @id @default(uuid())
  storeId             String    @map("store_id")
  url                 String
  events              String[] // EventName[]
  secret              Bytes // Encrypted HMAC secret
  status              String    @default("active") // WebhookStatus
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastFailureAt       DateTime? @map("last_failure_at")
  createdBy           String    @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([storeId, status])
  @@map("webhooks")
}

// One try of a delivery: of a webhook of a store (`webhookId`) or of the webhook of a plugin installation
// (`pluginInstallationId`); a CHECK of the database says exactly one of them is set
model WebhookDelivery {
  id                   String   @id @default(uuid())
  webhookId            String?  @map("webhook_id")
  pluginInstallationId String?  @map("plugin_installation_id")
  event                String
  statusCode           Int?     @map("status_code")
  durationMs           Int      @map("duration_ms")
  success              Boolean
  error                String?
  attempt              Int      @default(1)
  createdAt            DateTime @default(now()) @map("created_at")

  webhook            Webhook?            @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  pluginInstallation PluginInstallation? @relation(fields: [pluginInstallationId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt(sort: Desc)])
  @@index([pluginInstallationId, createdAt(sort: Desc)])
  @@index([createdAt]) // 30-day cleanup
  @@map("webhook_deliveries")
}

// Idempotency for inbound provider webhooks (Resend). Channel webhooks dedupe on
// Message.channelMessageId instead.
model ProcessedWebhookEvent {
  source      String // 'resend'
  eventId     String   @map("event_id")
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([source, eventId])
  @@index([processedAt])
  @@map("processed_webhook_events")
}

// Tenant API keys (Settings → API keys) for the public REST API. Distinct from plugin keys.
model ApiKey {
  id         String    @id @default(uuid())
  storeId    String    @map("store_id")
  name       String
  keyPrefix  String    @map("key_prefix") // "pk_live_ab12…" shown in UI
  keyHash    String    @unique @map("key_hash")
  scopes     String[] // Permission[] subset
  status     String    @default("active") // ApiKeyStatus
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@map("api_keys")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

// Persisted as an i18n key + params (TDD_02 §12). Rendered at display time in the
// recipient's locale; emails render server-side.
model Notification {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  storeId        String    @map("store_id")
  type           String // NotificationType
  severity       String // NotificationSeverity
  messageKey     String    @map("message_key") // e.g. "notifications.conversation.assigned"
  params         Json      @default("{}") // { customerName, conversationId, … }
  resourceType   String?   @map("resource_type")
  resourceId     String?   @map("resource_id")
  actionPath     String?   @map("action_path") // App-relative path, built from AppPaths
  readAt         DateTime? @map("read_at")
  // Set when the person asked for this one by email: the digest sends the rows that have it and clears it.
  // Its partial index (ix_notifications_email_pending) is raw SQL in a migration, Prisma cannot express it
  emailPendingAt DateTime? @map("email_pending_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([userId, storeId, createdAt(sort: Desc)])
  @@index([storeId, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  id      String  @id @default(uuid())
  userId  String  @map("user_id")
  storeId String  @map("store_id")
  type    String // NotificationType
  inApp   Boolean @default(true) @map("in_app")
  push    Boolean @default(true)
  email   Boolean @default(false)
  sound   Boolean @default(true)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId, type])
  @@map("notification_preferences")
}

// User-level (not per store) notification behaviour: quiet hours, digest, cross-store.
model UserNotificationSettings {
  userId                   String    @id @map("user_id")
  quietHoursEnabled        Boolean   @default(false) @map("quiet_hours_enabled")
  quietHoursStart          Int       @default(22) @map("quiet_hours_start") // 0-23, in `timezone`
  quietHoursEnd            Int       @default(7) @map("quiet_hours_end")
  quietHoursFollowStore    Boolean   @default(false) @map("quiet_hours_follow_store")
  timezone                 String    @default("America/El_Salvador")
  digestFrequency          String    @default("hourly") @map("digest_frequency") // DigestFrequency
  crossStoreEnabled        Boolean   @default(true) @map("cross_store_enabled")
  crossStoreSupervisorOnly Boolean   @default(false) @map("cross_store_supervisor_only")
  lastDigestSentAt         DateTime? @map("last_digest_sent_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_settings")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  lastUsed  DateTime @default(now()) @map("last_used")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================================
// ANALYTICS & EXPORTS
// ============================================================

model AnalyticsEvent {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  event     String // AnalyticsEventNames (TDD_11 §7.1)
  data      Json
  date      DateTime @db.Date
  timestamp DateTime @default(now())
  eventKey  String?  @map("event_key") // What the producer says identifies the event (the Svix id of a webhook): a job delivered twice writes one row

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, eventKey])
  @@index([storeId, event, date])
  @@index([date])
  @@map("analytics_events")
}

// dimension/dimensionId default to '' (never NULL) so the unique constraint works with upsert.
model MetricHourly {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  hour        DateTime
  metric      String
  dimension   String   @default("")
  dimensionId String   @default("") @map("dimension_id")
  value       Decimal  @db.Decimal(18, 4)
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, hour, metric, dimension, dimensionId])
  @@index([storeId, metric, hour])
  @@index([hour]) // The purge of the hours past DataRetentionPolicies.METRICS_HOURLY, across the stores
  @@map("metrics_hourly")
}

model MetricDaily {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  date        DateTime @db.Date
  metric      String
  dimension   String   @default("")
  dimensionId String   @default("") @map("dimension_id")
  value       Decimal  @db.Decimal(18, 4)
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date, metric, dimension, dimensionId])
  @@index([storeId, metric, date])
  @@map("metrics_daily")
}

model ScheduledReport {
  id         String    @id @default(uuid())
  storeId    String    @map("store_id")
  name       String
  metrics    String[]
  frequency  String // ReportFrequency
  format     String // ReportFormats
  recipients String[]
  filters    Json?
  timezone   String    @default("America/El_Salvador")
  sendAtHour Int       @default(8) @map("send_at_hour")
  enabled    Boolean   @default(true)
  lastSentAt DateTime? @map("last_sent_at")
  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([enabled, frequency])
  @@map("scheduled_reports")
}

// Generated exports (CSV/Excel/ZIP/PDF) — the record behind ApiRoutes.exports and the
// EXPORT_READY notification (TDD_07 §7).
model Export {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  requestedBy String    @map("requested_by")
  type        String // ExportTypes (TDD_07 §1.3)
  format      String
  filters     Json?
  status      String    @default("pending") // ExportStatus: pending | ready | failed | expired
  key         String? // S3 key when ready
  rowCount    Int?      @map("row_count")
  // How much of the file is written, 0 to 100, while the status is pending; null until the worker has counted
  progress    Int?
  error       String?
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("exports")
}

// ============================================================
// COMPLIANCE & AUDIT
// ============================================================

model AuditLog {
  id             String   @id @default(uuid())
  action         String // AuditActionType
  // Null for system actions (workers, webhooks)
  userId         String?  @map("user_id")
  storeId        String?  @map("store_id")
  // Org-level actions have no single store.
  organizationId String?  @map("organization_id")
  resourceType   String?  @map("resource_type")
  resourceId     String?  @map("resource_id")
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  timestamp      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, timestamp(sort: Desc)])
  @@index([storeId, timestamp(sort: Desc)])
  @@index([organizationId, timestamp(sort: Desc)])
  @@index([action, timestamp(sort: Desc)])
  @@index([timestamp]) // Cold export / purge
  @@map("audit_logs")
}

model DataSubjectRequest {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  storeId                String?   @map("store_id")
  type                   String // DsrType
  status                 String    @default("pending_verification") // DsrStatus
  subjectType            String    @map("subject_type") // 'customer' | 'user'
  subjectId              String?   @map("subject_id")
  subjectEmail           String?   @map("subject_email")
  subjectPhone           String?   @map("subject_phone")
  requestedBy            String?   @map("requested_by")
  requestedAt            DateTime  @default(now()) @map("requested_at")
  deadlineAt             DateTime  @map("deadline_at")
  deadlineAlertSentAt    DateTime? @map("deadline_alert_sent_at")
  verifiedAt             DateTime? @map("verified_at")
  completedAt            DateTime? @map("completed_at")
  resultKey              String?   @map("result_key")
  resultExpiresAt        DateTime? @map("result_expires_at")
  rejectionReason        String?   @map("rejection_reason")
  retainedRecordsSummary Json?     @map("retained_records_summary") // What was kept and under which legal basis
  notes                  String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@index([deadlineAt, status])
  @@index([subjectEmail])
  @@map("data_subject_requests")
}

model ConsentRecord {
  id         String    @id @default(uuid())
  storeId    String    @map("store_id")
  customerId String    @map("customer_id")
  purpose    String
  legalBasis String    @map("legal_basis") // LegalBases
  granted    Boolean
  grantedAt  DateTime? @map("granted_at")
  revokedAt  DateTime? @map("revoked_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  source     String
  createdAt  DateTime  @default(now()) @map("created_at")

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose])
  @@index([storeId, purpose, granted])
  @@map("consent_records")
}

// Cookie consent for platform users and anonymous visitors (TDD_05 §10.5).
model CookieConsent {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  visitorId     String   @map("visitor_id")
  categories    Json // { functional: true, analytics: false, marketing: false }
  policyVersion String   @map("policy_version")
  ipHash        String?  @map("ip_hash")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visitorId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("cookie_consents")
}

model RetentionSettings {
  storeId          String   @id @map("store_id")
  conversationDays Int      @default(730) @map("conversation_days")
  mediaDays        Int      @default(365) @map("media_days")
  analyticsDays    Int      @default(395) @map("analytics_days")
  notificationDays Int      @default(90) @map("notification_days")
  updatedAt        DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("retention_settings")
}

// ============================================================
// SHIPPING (TDD_17 §2, §4.17; Step 4.8, PR B1). Schema only: no service reads or writes these tables yet.
// Every table carries its store_id. A relation to another table of the same store names the store as well
// (fields [storeId, x] -> references [storeId, id]), so the database refuses a link to another store's row.
// Order, OrderItem and Warehouse have no (store_id, id) key to point at, so those links are plain foreign keys
// and the migration adds triggers that check the store (or the organization of the store) of the row they reach.
// The reception tables arrived with Step 4.12 (PR R2), the remittance tables Step 4.13, and Order.carrierConnectionId stays a
// plain column until its foreign key in Step 4.8 PR C1.
// ============================================================

// A store's account with a carrier (or a courier with CarrierCapability.INTERNAL_GUIDE). Credentials and webhook secret are ciphertext.
model CarrierConnection {
  id                      String    @id @default(uuid())
  storeId                 String    @map("store_id")
  carrierId               String    @map("carrier_id") // CarrierId: the id of an official or private carrier plugin
  displayName             String    @map("display_name")
  status                  String    @default("active") // CarrierConnectionStatus
  credentials             Bytes? // Ciphertext; null for CarrierCapability.INTERNAL_GUIDE
  webhookSecret           Bytes?    @map("webhook_secret") // Ciphertext; the secret of this connection's inbound webhook
  defaultServiceCode      String?   @map("default_service_code") // A CarrierService.code of this connection
  defaultShippingPayer    String    @default("sender") @map("default_shipping_payer") // ShippingPayer
  labelFormat             String    @default("pdf_100x150") @map("label_format") // LabelFormat
  contact                 Json? // CarrierCapability.INTERNAL_GUIDE only: { phone, notes }
  pickupEnabled           Boolean   @default(false) @map("pickup_enabled")
  pickupDays              Int[]     @default([1, 2, 3, 4, 5]) @map("pickup_days") // ISO weekdays, 1 = Monday
  pickupCutoffTime        String?   @map("pickup_cutoff_time") // 'HH:mm' in the store timezone
  autoPickup              Boolean   @default(false) @map("auto_pickup")
  autoPickupTime          String?   @map("auto_pickup_time") // 'HH:mm' in the store timezone
  pickupReminderMinutes   Int       @default(30) @map("pickup_reminder_minutes")
  pollIntervalMinutes     Int?      @map("poll_interval_minutes") // Null = the plugin default; only for carriers polled instead of pushing
  maxDeliveryAttempts     Int       @default(3) @map("max_delivery_attempts") // Attempts the carrier makes before returning the package; the {{maxAttempts}} of a message
  defaultShippingFeeCents Int?      @map("default_shipping_fee_cents") // The fee charged to the customer: the preset and the accepted range (TDD_17 §4.13)
  minShippingFeeCents     Int?      @map("min_shipping_fee_cents")
  maxShippingFeeCents     Int?      @map("max_shipping_fee_cents")
  chargeModel             String    @default("invoiced") @map("charge_model") // CarrierChargeModel: how the carrier charges the business for its guides (TDD_18 §4.2, E4)
  remittanceDeductsFee    Boolean   @default(false) @map("remittance_deducts_fee") // The carrier subtracts its fee from what it remits when the sender pays (§4.15)
  commissionBps           Int?      @map("commission_bps") // The carrier's commission over the cash it collects, in basis points (450 = 4.5 %): agreed with the carrier, null = none (§4.15)
  serviceRatesCents       Json?     @map("service_rates_cents") // The cost of a guide by rate service of the carrier ({ "CCE": 300 }), for a carrier that does not report it (§4.15)
  lastHealthyAt           DateTime? @map("last_healthy_at")
  lastError               String?   @map("last_error")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  store            Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  services         CarrierService[]
  guideSequence    GuideSequence?
  shipments        Shipment[]
  plannedOrders    Order[]
  pickups          PickupRequest[]
  statusMappings   CarrierStatusMapping[]
  unmappedStatuses CarrierUnmappedStatus[]
  remittances      CodRemittance[]
  importProfiles   RemittanceImportProfile[]
  guidePolicy      CarrierGuidePolicy?
  guideMovements   CarrierGuideMovement[]
  benefitPeriods   CarrierBenefitPeriod[]

  @@unique([storeId, displayName])
  // So that what hangs from a connection can name its store and the database check that they go together
  @@unique([storeId, id])
  @@index([storeId, status])
  @@map("carrier_connections")
}

// The balance of prepaid guides and the refund benefit of a connection (TDD_17 §4.18, Step 4.16). One row per connection that
// opted in; every column is a setting, and the defaults that stand for a carrier's rule are to be confirmed with the carrier.
model CarrierGuidePolicy {
  connectionId        String   @id @map("connection_id")
  storeId             String   @map("store_id")
  balanceEnabled      Boolean  @default(false) @map("balance_enabled")
  benefitEnabled      Boolean  @default(false) @map("benefit_enabled")
  warnOnEmptyBalance  Boolean  @default(true) @map("warn_on_empty_balance")
  lowBalanceThreshold Int?     @map("low_balance_threshold") // Guides; null = no low-balance alert
  periodKind          String   @default("fixed_days") @map("period_kind") // BenefitPeriodKind
  periodDays          Int      @default(15) @map("period_days")
  benefitSince        DateTime @default(now()) @map("benefit_since") // The benefit is judged from here: set when it is switched on or its period changes, never judging what happened before
  periodAnchor        String   @map("period_anchor") // 'YYYY-MM-DD', a calendar day of the store: the first day of a period of fixed days
  thresholdBps        Int      @default(1000) @map("threshold_bps")
  warnAtBps           Int      @default(8000) @map("warn_at_bps")
  base                String   @default("delivered") // BenefitBase
  returnStatuses      String[] @default(["returned"]) @map("return_statuses") // ShipmentStatus values that count as a return
  refundRule          String   @default("at_period_close") @map("refund_rule") // BenefitRefundRule
  lossRule            String   @default("from_crossing") @map("loss_rule") // BenefitLossRule
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection CarrierConnection @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Cascade)

  @@unique([storeId, connectionId])
  @@index([storeId])
  @@map("carrier_guide_policies")
}

// The ledger of guides of a connection: append-only (a trigger refuses an update or a delete). The balance is the sum of
// guidesDelta; the average cost is what the purchases and their voids paid over the guides they brought.
model CarrierGuideMovement {
  id                String   @id @default(uuid())
  storeId           String   @map("store_id")
  connectionId      String   @map("connection_id")
  kind              String // GuideMovementKind
  guidesDelta       Int      @map("guides_delta")
  costCentsDelta    Int      @default(0) @map("cost_cents_delta") // Whole cents of USD; only a purchase and its void move it
  paidQuantity      Int?     @map("paid_quantity") // purchase
  giftQuantity      Int?     @map("gift_quantity") // purchase
  unitCostCents     Int?     @map("unit_cost_cents") // consume: the weighted average cost of that moment, when there was one
  shipmentId        String?  @map("shipment_id") // consume and refund: the guide it is about (one of each per shipment)
  voidsMovementId   String?  @unique @map("voids_movement_id") // void: the purchase it undoes (once)
  paidFromAccountId String?  @map("paid_from_account_id") // purchase: the account the money left (the books default to the bank role); not a foreign key, the books validate it when they post
  onAdvance         Boolean  @default(false) @map("on_advance") // consume: the connection was prepaid when the guide was made, so its cost came out of the advance (E4 credits the advance, not the carrier); purchase: it was prepaid when bought, so the books carry it (E15)
  note              String?
  createdBy         String   @map("created_by") // A user id or 'system'
  occurredAt        DateTime @default(now()) @map("occurred_at")
  createdAt         DateTime @default(now()) @map("created_at")

  store      Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  connection CarrierConnection     @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Restrict)
  shipment   Shipment?             @relation(fields: [storeId, shipmentId], references: [storeId, id], onDelete: Restrict)
  voids      CarrierGuideMovement? @relation("MovementVoid", fields: [voidsMovementId], references: [id], onDelete: Restrict)
  voidedBy   CarrierGuideMovement? @relation("MovementVoid")

  @@unique([storeId, id])
  @@index([connectionId, createdAt, id])
  @@index([storeId, shipmentId])
  @@map("carrier_guide_movements")
}

// Raw SQL of the migration (Prisma cannot express it): carrier_guide_movements_one_per_shipment (one consume and one refund per
// shipment, a partial unique index), the CHECKs of each kind, and the append-only triggers.

// A period of the benefit that ended and was judged once by the daily close: its numbers and how many guides it gave back.
// It is the idempotency of the close and the history the screen shows.
model CarrierBenefitPeriod {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  connectionId  String   @map("connection_id")
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  baseCount     Int      @map("base_count")
  returnCount   Int      @map("return_count")
  rateBps       Int      @map("rate_bps")
  state         String // BenefitState at the close
  refundedCount Int      @map("refunded_count")
  closedAt      DateTime @default(now()) @map("closed_at")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  connection CarrierConnection @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Restrict)

  @@unique([connectionId, periodStart])
  @@index([storeId, connectionId, periodStart])
  @@map("carrier_benefit_periods")
}

// The service types a carrier offers (next day, express, ...). The code is what the carrier's API expects; the label
// is what the owner sees. Seeded from the plugin's serviceCatalog() when the connection is created.
model CarrierService {
  id           String  @id @default(uuid())
  storeId      String  @map("store_id")
  connectionId String  @map("connection_id")
  code         String // Carrier-specific, sent in the API call
  label        String
  active       Boolean @default(true)

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection CarrierConnection @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Cascade)

  @@unique([connectionId, code])
  @@index([storeId])
  @@map("carrier_services")
}

// Guide numbers of a carrier with CarrierCapability.INTERNAL_GUIDE. One row per connection, advanced with
// UPDATE ... SET next_value = next_value + 1 RETURNING in the same transaction as the Shipment.
model GuideSequence {
  connectionId String @id @map("connection_id")
  storeId      String @map("store_id")
  prefix       String // Printed in front of the number, e.g. 'JM'
  nextValue    Int    @default(1) @map("next_value")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection CarrierConnection @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Cascade)

  // The primary key already makes the connection unique; this is the key the composite relation to it needs
  @@unique([storeId, connectionId])
  @@index([storeId])
  @@map("guide_sequences")
}

// One guide of one order from one warehouse. Its contents are the order's allocations from that warehouse
// (TDD_16 §4.1): there is no shipment-lines table. The status is written only by ShippingService (lint rule).
model Shipment {
  id                 String    @id @default(uuid())
  storeId            String    @map("store_id")
  orderId            String    @map("order_id")
  connectionId       String    @map("connection_id")
  kind               String    @default("outbound") // ShipmentKind
  returnId           String?   @map("return_id") // Set when kind = return
  originWarehouseId  String?   @map("origin_warehouse_id") // The warehouse the goods leave from (§4.5); of a return guide, the one they go to
  status             String    @default("creating") // ShipmentStatus
  serviceCode        String    @map("service_code")
  shippingPayer      String    @map("shipping_payer") // ShippingPayer
  codAmountCents     Int?      @map("cod_amount_cents") // Null = prepaid
  codStatus          String    @default("not_applicable") @map("cod_status") // CodStatus
  codExpectedCents   Int?      @map("cod_expected_cents") // Written when the shipment is delivered (§4.15)
  codRemittedCents   Int?      @map("cod_remitted_cents")
  codRemittanceId    String?   @map("cod_remittance_id") // The confirmed remittance that settled it (Step 4.13)
  deliveredAt        DateTime? @map("delivered_at") // When the carrier delivered it: the age of what it owes (§4.15)
  currency           String
  packageCount       Int       @default(1) @map("package_count")
  failedAttempts     Int       @default(0) @map("failed_attempts") // Delivery attempts that failed (§4.9)
  weightGrams        Int?      @map("weight_grams")
  guideNumber        String?   @map("guide_number") // The carrier's guide, or ours for CarrierCapability.INTERNAL_GUIDE
  providerShipmentId String?   @map("provider_shipment_id") // The carrier's internal id, when it has one
  trackingUrl        String?   @map("tracking_url")
  labelMediaId       String?   @map("label_media_id") // Media purpose SHIPPING_LABEL; plain column like the other media ids
  carrierCostCents   Int?      @map("carrier_cost_cents") // When the carrier reports it
  carrierRateCents   Int?      @map("carrier_rate_cents") // The connection's rate for the service of the guide, kept when the guide was made (§4.15)
  commissionBps      Int?      @map("commission_bps") // The connection's commission when the guide was made, in basis points (§4.15)
  refundStatus       String    @default("not_applicable") @map("refund_status") // GuideRefundStatus
  idempotencyKey     String    @map("idempotency_key") // Unique per store (@@unique below)
  pickupId           String?   @map("pickup_id")
  lastError          String?   @map("last_error")
  cancelRequestedAt  DateTime? @map("cancel_requested_at")
  cancelledAt        DateTime? @map("cancelled_at")
  createdBy          String    @map("created_by") // A user id or 'system'
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  store           Store                  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order           Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  connection      CarrierConnection      @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Restrict)
  pickup          PickupRequest?         @relation(fields: [storeId, pickupId], references: [storeId, id], onDelete: Restrict)
  originWarehouse Warehouse?             @relation(fields: [originWarehouseId], references: [id], onDelete: Restrict)
  orderReturn     OrderReturn?           @relation("ShipmentReturn", fields: [storeId, returnId], references: [storeId, id], onDelete: Restrict)
  returnOf        OrderReturn[]          @relation("ReturnShipment")
  receptionItems  ReturnReceptionItem[]
  events          ShipmentEvent[]
  remittance      CodRemittance?         @relation("RemittedShipment", fields: [storeId, codRemittanceId], references: [storeId, id], onDelete: Restrict)
  remittanceLines CodRemittanceLine[]
  guideMovements  CarrierGuideMovement[]

  @@unique([storeId, id])
  @@unique([storeId, idempotencyKey])
  @@index([orderId])
  @@index([storeId, status])
  @@index([storeId, orderId])
  @@index([connectionId, status])
  @@index([connectionId, providerShipmentId]) // The worker finds the package a carrier event names (the guide has its own unique index)
  @@index([pickupId])
  @@index([originWarehouseId])
  @@index([returnId])
  @@index([storeId, connectionId, codStatus]) // The pending screen and the daily check of what is owed
  @@index([codRemittanceId])
  @@map("shipments")
}

// Raw SQL of the migration (Prisma cannot express a partial unique index): shipments_one_active_outbound (one active
// outbound guide per order and origin warehouse, NULLS NOT DISTINCT) and shipments_guide_per_connection.

// The history of a shipment. A status the plugin could not map is stored with a null status (TDD_17 §4.17).
model ShipmentEvent {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  shipmentId      String   @map("shipment_id")
  providerEventId String?  @map("provider_event_id")
  status          String? // ShipmentStatus; null = an unmapped provider status, stored only
  rawStatus       String?  @map("raw_status")
  description     String?
  occurredAt      DateTime @map("occurred_at")
  receivedAt      DateTime @default(now()) @map("received_at")
  source          String // ShipmentEventSource: webhook | poll | manual | system
  payload         Json? // Redacted (§4.12)

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [storeId, shipmentId], references: [storeId, id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@index([storeId])
  @@index([storeId, status, occurredAt]) // The periods of the refund benefit read the first event of a status (TDD_17 §4.18)
  @@map("shipment_events")
}

// Raw SQL: shipment_events_provider_dedupe, unique on (shipment_id, provider_event_id) where provider_event_id is not null.
// Raw SQL: shipment_events_unmapped_idx on (store_id, shipment_id) where status is null (what a replay reads).

// The owner's map from a carrier's own status code to a ShipmentStatus (§4.17). Seeded from the plugin's
// statusCatalog() when the connection is created, editable afterwards.
model CarrierStatusMapping {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  connectionId String   @map("connection_id")
  providerCode String   @map("provider_code") // Normalized: normalizeProviderStatusCode
  label        String? // What the carrier calls it, for the screen
  status       String? // ShipmentStatus; null = ignore on purpose (no effect, not counted as unknown)
  source       String   @default("default") // CarrierStatusMappingSource: default | custom
  updatedBy    String?  @map("updated_by")
  updatedAt    DateTime @updatedAt @map("updated_at")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection CarrierConnection @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Cascade)

  @@unique([connectionId, providerCode])
  @@index([storeId])
  @@map("carrier_status_mappings")
}

// A provider status code that arrived with no mapping and no plugin default (§4.17). One row per connection and code,
// so the owner is told once and the screen lists what is waiting.
model CarrierUnmappedStatus {
  id                String    @id @default(uuid())
  storeId           String    @map("store_id")
  connectionId      String    @map("connection_id")
  providerCode      String    @map("provider_code") // Normalized
  sampleRawStatus   String    @map("sample_raw_status") // The text as the carrier sent it
  sampleDescription String?   @map("sample_description")
  occurrences       Int       @default(1)
  firstSeenAt       DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  resolvedAt        DateTime? @map("resolved_at")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection CarrierConnection @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Cascade)

  @@unique([connectionId, providerCode])
  @@index([storeId])
  @@map("carrier_unmapped_statuses")
}

// A request to the carrier to collect packages on a day (§4.10). No unique index on (connection, date): a carrier whose
// guides exist only inside a pickup can need several pickups on one day; "one open pickup per connection and day" is a
// rule of ShippingService.ensurePickup, under an advisory lock.
model PickupRequest {
  id                  String   @id @default(uuid())
  storeId             String   @map("store_id")
  connectionId        String   @map("connection_id")
  pickupDate          DateTime @map("pickup_date") @db.Date // In the store timezone
  status              String   @default("pending") // PickupStatus
  packageCount        Int      @default(0) @map("package_count")
  revision            Int      @default(1) // +1 each time the package count is modified
  carrierPackageCount Int?     @map("carrier_package_count") // What the carrier last acknowledged; null = what we hold
  providerPickupId    String?  @map("provider_pickup_id")
  windowStart         String?  @map("window_start") // 'HH:mm', when the carrier lets us choose
  windowEnd           String?  @map("window_end")
  requestedBy         String   @map("requested_by") // A user id or 'system'
  lastError           String?  @map("last_error")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  connection CarrierConnection @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Restrict)
  shipments  Shipment[]

  @@unique([storeId, id])
  @@index([storeId, pickupDate])
  @@index([connectionId])
  @@map("pickup_requests")
}

model BulkLabelJob {
  id            String    @id @default(uuid())
  storeId       String    @map("store_id")
  status        String    @default("queued") // BulkLabelJobStatus
  orderIds      String[]  @map("order_ids") // In the order the agent selected them (the PDF keeps it)
  total         Int
  succeeded     Int       @default(0)
  failed        Int       @default(0)
  results       Json? // Per order: { orderId, shipmentId?, outcome, errorCode? }
  mergedMediaId String?   @map("merged_media_id") // Media purpose BULK_LABELS; plain column like the other media ids
  requestedBy   String    @map("requested_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  finishedAt    DateTime? @map("finished_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("bulk_label_jobs")
}

// The messages a store sends about an order, one template per kind and locale (§4.7).
// Every message about an order that was due (TDD_17 §4.7): where it went, or why it did not. One row per idempotency key
// (automatic: `(shipmentId, status, kind)`; manual change: `(orderId, kind, status)`), so a repeated carrier event or a
// retried request sends nothing twice, and the timeline of the order can say "not sent, reason".
model OrderMessageDispatch {
  id                  String   @id @default(uuid())
  storeId             String   @map("store_id")
  orderId             String   @map("order_id") // Composite foreign key with the store: the database refuses an order of another store
  kind                String // OrderMessageKind
  trigger             String // OrderMessageTrigger
  route               String // OrderMessageRoute
  reason              String? // OrderMessageNotSentReason, set only when the route is not_sent
  idempotencyKey      String   @map("idempotency_key")
  messageId           String?  @map("message_id") // The outbound Message of a channel route; plain column like the other message links
  shipmentId          String?  @map("shipment_id") // The package that caused an automatic message
  requestedBy         String?  @map("requested_by") // The member who pressed "send" or changed the status; null for the system
  requestedByPluginId String?  @map("requested_by_plugin_id") // The plugin that asked for it, when no member did
  locale              String? // The language of the template that was used
  createdAt           DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade)

  @@unique([storeId, idempotencyKey])
  @@index([storeId, orderId, createdAt(sort: Desc)])
  @@map("order_message_dispatches")
}

model OrderMessageTemplate {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  kind            String // OrderMessageKind
  locale          String
  body            String // Plain text with {{variables}} from OrderMessageVariables
  autoSend        Boolean  @default(false) @map("auto_send")
  attachSummary   Boolean  @default(false) @map("attach_summary") // Attach the order summary PDF when the channel supports documents
  channelTemplate Json?    @map("channel_template") // { pluginId, name, language, variables } of a pre-approved channel template (§4.7)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, kind, locale])
  @@map("order_message_templates")
}

// A return or an exchange of a delivered order (§4.11).
model OrderReturn {
  id                 String    @id @default(uuid())
  storeId            String    @map("store_id")
  orderId            String    @map("order_id")
  type               String // OrderReturnType: refund | exchange
  reason             String // OrderReturnReason
  status             String    @default("requested") // OrderReturnStatus
  shippingPayer      String    @map("shipping_payer") // Who pays the return leg and the replacement (§4.11)
  replacementOrderId String?   @map("replacement_order_id") // Exchange: the new order
  returnShipmentId   String?   @map("return_shipment_id")
  refundAmountCents  Int?      @map("refund_amount_cents")
  notes              String?
  createdBy          String    @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  receivedAt         DateTime? @map("received_at")

  store            Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order            Order                 @relation("ReturnOrder", fields: [orderId], references: [id], onDelete: Restrict)
  replacementOrder Order?                @relation("ReturnReplacement", fields: [replacementOrderId], references: [id], onDelete: Restrict)
  returnShipment   Shipment?             @relation("ReturnShipment", fields: [storeId, returnShipmentId], references: [storeId, id], onDelete: Restrict)
  shipments        Shipment[]            @relation("ShipmentReturn")
  lines            OrderReturnLine[]
  receptionItems   ReturnReceptionItem[]
  fiscalDocuments  FiscalDocument[]

  @@unique([storeId, id])
  @@index([orderId])
  @@index([storeId, orderId])
  @@index([storeId, status])
  @@index([storeId, createdAt(sort: Desc), id(sort: Desc)], map: "order_returns_store_created_idx")
  @@index([replacementOrderId])
  @@index([returnShipmentId])
  @@map("order_returns")
}

model OrderReturnLine {
  id                 String  @id @default(uuid())
  storeId            String  @map("store_id")
  returnId           String  @map("return_id")
  orderItemId        String  @map("order_item_id")
  quantity           Int
  condition          String? // OrderReturnCondition, set on receipt
  restockWarehouseId String? @map("restock_warehouse_id") // Set on receipt for resellable items

  store            Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  orderReturn      OrderReturn @relation(fields: [storeId, returnId], references: [storeId, id], onDelete: Cascade)
  orderItem        OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  restockWarehouse Warehouse?  @relation(fields: [restockWarehouseId], references: [id], onDelete: Restrict)

  @@unique([returnId, orderItemId])
  @@index([storeId])
  @@index([orderItemId])
  @@index([restockWarehouseId])
  @@map("order_return_lines")
}

// A scanning session of the returns reception (TDD_17 §4.16). Saved as a draft while the agent scans, so a refresh or a lost
// connection loses nothing. `processing` is the claim of one completion (a second one is refused until it ends, or until it is
// older than ReceptionLimits.PROCESSING_STALE_MS, a run that died).
model ReturnReceptionBatch {
  id                  String    @id @default(uuid())
  storeId             String    @map("store_id")
  status              String    @default("draft") // ReceptionBatchStatus
  createdBy           String    @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  processingStartedAt DateTime? @map("processing_started_at")
  completedAt         DateTime? @map("completed_at")

  store Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items ReturnReceptionItem[]

  @@unique([storeId, id])
  @@index([storeId, status])
  @@map("return_reception_batches")
}

// One package of a batch. `lines` is empty while the agent has not narrowed the package (every unit of the order that is not in a
// return yet comes back, in `condition`) and otherwise holds [{ orderItemId, quantity, condition, restockWarehouseId? }].
// `outcome` is null until the batch is completed; `returnId` is set when the package was received.
model ReturnReceptionItem {
  id               String    @id @default(uuid())
  storeId          String    @map("store_id")
  batchId          String    @map("batch_id")
  shipmentId       String    @map("shipment_id")
  reason           String // OrderReturnReason key
  condition        String    @default("resellable") // OrderReturnCondition, for the lines that name none
  note             String?
  lines            Json      @default("[]")
  flagCustomer     Boolean   @default(false) @map("flag_customer")
  flagReason       String?   @map("flag_reason")
  // The agent confirmed that a package whose guide is DELIVERED came back anyway (TDD_17 §4.16)
  confirmDelivered Boolean   @default(false) @map("confirm_delivered")
  outcome          String? // ReceptionItemOutcome
  errorCode        String?   @map("error_code")
  returnId         String?   @map("return_id")
  flagAppliedAt    DateTime? @map("flag_applied_at")
  scannedAt        DateTime  @default(now()) @map("scanned_at")

  store       Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  batch       ReturnReceptionBatch @relation(fields: [storeId, batchId], references: [storeId, id], onDelete: Cascade)
  shipment    Shipment             @relation(fields: [storeId, shipmentId], references: [storeId, id], onDelete: Restrict)
  orderReturn OrderReturn?         @relation(fields: [storeId, returnId], references: [storeId, id], onDelete: Restrict)

  @@unique([batchId, shipmentId])
  @@index([storeId, shipmentId])
  @@index([storeId, returnId])
  @@map("return_reception_items")
}

// The carrier's settlement of cash collected on delivery (TDD_17 §4.15). A draft is built by hand or from an import and
// confirmed once; a confirmed remittance is immutable and can only be voided. The status is written only by
// RemittancesService (lint rule). The three totals are written at confirmation.
model CodRemittance {
  id                   String    @id @default(uuid())
  storeId              String    @map("store_id")
  connectionId         String    @map("connection_id")
  status               String    @default("draft") // RemittanceStatus
  reference            String? // The carrier's settlement number
  receivedOn           DateTime? @map("received_on") @db.Date
  importProfileId      String?   @map("import_profile_id") // The profile an import used: a plain column like the other ids a record keeps for evidence, the profile may be deleted later
  sourceMediaId        String?   @map("source_media_id") // The uploaded file, Media purpose REMITTANCE_FILE; plain column like the other media ids
  expectedCents        BigInt    @default(0) @map("expected_cents")
  reportedCents        BigInt    @default(0) @map("reported_cents")
  feeCents             BigInt    @default(0) @map("fee_cents")
  note                 String?
  createdBy            String    @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  confirmedAt          DateTime? @map("confirmed_at")
  confirmedBy          String?   @map("confirmed_by")
  voidedAt             DateTime? @map("voided_at")
  voidedBy             String?   @map("voided_by")
  voidReason           String?   @map("void_reason") // Why a confirmed remittance was voided
  destinationAccountId String?   @map("destination_account_id") // The account the money of the remittance went to (TDD_18 §4.2 E5); null = the role BANK_DEFAULT

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  connection         CarrierConnection   @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Restrict)
  lines              CodRemittanceLine[]
  destinationAccount LedgerAccount?      @relation("RemittanceDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  shipments          Shipment[]          @relation("RemittedShipment")

  // So that its lines and the shipments it settled can name their store and the database check that they go together
  @@unique([storeId, id])
  @@index([storeId, connectionId, status])
  @@index([destinationAccountId])
  @@map("cod_remittances")
}

model CodRemittanceLine {
  id               String  @id @default(uuid())
  storeId          String  @map("store_id")
  remittanceId     String  @map("remittance_id")
  position         Int // 1-based order of the line in its remittance: of two lines for one guide, the first one counts
  shipmentId       String? @map("shipment_id") // Null when the guide matched nothing
  guideNumber      String  @map("guide_number") // As it appeared in the file, trimmed
  reportedCents    Int     @map("reported_cents")
  reportedFeeCents Int?    @map("reported_fee_cents")
  expectedCents    Int?    @map("expected_cents")
  outcome          String // RemittanceLineOutcome
  excluded         Boolean @default(false) // The agent left it out of the confirmation
  note             String?

  store      Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  remittance CodRemittance @relation(fields: [storeId, remittanceId], references: [storeId, id], onDelete: Cascade)
  shipment   Shipment?     @relation(fields: [storeId, shipmentId], references: [storeId, id], onDelete: Restrict)

  @@unique([remittanceId, position])
  @@index([shipmentId])
  @@map("cod_remittance_lines")
}

// How a carrier's settlement file is read (TDD_17 §4.15): saved per connection, so the second import of a carrier is one click. The
// columns name where each value is, by the header text or by the position of the column. Nothing in it is a formula.
model RemittanceImportProfile {
  id               String   @id @default(uuid())
  storeId          String   @map("store_id")
  connectionId     String   @map("connection_id")
  name             String
  delimiter        String   @default(",") // ',' | ';' | tab
  hasHeader        Boolean  @default(true) @map("has_header")
  decimalSeparator String   @default(".") @map("decimal_separator") // '.' | ','
  dateFormat       String   @default("yyyy-MM-dd") @map("date_format")
  columns          Json // { guideNumber, amount, fee?, date?, reference? } -> header name or column position
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  connection CarrierConnection @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Restrict)

  // So that what an import points at can name its store and the database check that they go together
  @@unique([storeId, id])
  @@unique([connectionId, name])
  @@map("remittance_import_profiles")
}

// ============================================================
// FINANCE (TDD_18, Step 4B.2): the double-entry ledger of the ORGANIZATION
// ============================================================
// Every table is scoped by organization_id (TDD_18 §2.1), and every foreign key to another finance table or to a store
// carries it, so the database itself refuses a link across organizations. Whatever the schema cannot say is raw SQL in
// the migration (20261213110000_finance_ledger): the append-only triggers, the balanced-entry constraint, the open-period
// and postable-account checks, the gapless number and the hash chain head, and the CHECKs. Money is whole USD cents;
// stored balances are BigInt because a sum of cents passes the 32-bit ceiling of one line.

model FinanceSettings {
  organizationId      String    @id @map("organization_id")
  countryCode         String    @map("country_code") // ISO 3166-1 alpha-2, 'SV' now: picks the template
  baseCurrency        String    @default("USD") @map("base_currency") // CHECK = 'USD' in the MVP (TDD_18 §2.8)
  accountingStartDate DateTime  @map("accounting_start_date") @db.Date // events before it are never posted
  lockedThrough       DateTime? @map("locked_through") @db.Date // last day of the last closed period; null = none
  nextEntryNumber     BigInt    @default(1) @map("next_entry_number") // gapless counter, locked per post
  lastEntryHash       String?   @map("last_entry_hash") // the head of the hash chain
  recognizeSaleOn     String    @default("delivered") @map("recognize_sale_on") // SaleRecognition
  roundingAccountId   String?   @map("rounding_account_id")
  taxRounding         String    @default("half_up") @map("tax_rounding") // TaxRounding (TDD_18 §7): how a fraction of a cent of tax is placed
  shippingTaxed       Boolean   @default(true) @map("shipping_taxed") // Whether the shipping fee carries VAT [ACCOUNTANT] (TDD_18 §7, §13 row 2)
  nextPurchaseNumber  BigInt    @default(1) @map("next_purchase_number") // the counter of the purchase numbers (TDD_18 §2.7), taken under the row lock of the update
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roundingAccount LedgerAccount? @relation(fields: [organizationId, roundingAccountId], references: [organizationId, id], onDelete: Restrict)

  @@map("finance_settings")
}

model LedgerAccount {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  storeId        String?  @map("store_id") // NULL in the MVP, held by a CHECK (accounts per store are Phase 2, TDD_18 §2.2)
  code           String // the accountant's numbering, unique per organization
  name           String // plain data the accountant edits (the template seeds it)
  type           String // AccountType
  normalSide     String   @map("normal_side") // NormalSide: derived from the type, stored for the CHECK
  parentId       String?  @map("parent_id")
  isPostable     Boolean  @default(true) @map("is_postable") // false for a header that only groups
  cashKind       String?  @map("cash_kind") // CashKind: cash | bank | wallet; null for every other account
  isSystem       Boolean  @default(false) @map("is_system") // created by the template: cannot be deleted, can be renamed
  active         Boolean  @default(true)
  currency       String   @default("USD")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent               LedgerAccount?          @relation("AccountTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children             LedgerAccount[]         @relation("AccountTree")
  roleMappings         AccountRoleMapping[]
  paymentAccounts      PaymentMethodAccount[]
  settings             FinanceSettings[]
  lines                JournalLine[]
  balances             AccountPeriodBalance[]
  taxRatesOutput       TaxRate[]               @relation("TaxRateOutputAccount")
  taxRatesInput        TaxRate[]               @relation("TaxRateInputAccount")
  transactionsFrom     FinanceTransaction[]    @relation("TransactionFromAccount")
  transactionsTo       FinanceTransaction[]    @relation("TransactionToAccount")
  transactionsCategory FinanceTransaction[]    @relation("TransactionCategoryAccount")
  suppliersPayable     Supplier[]
  remittancesTo        CodRemittance[]         @relation("RemittanceDestinationAccount")
  supplierPaymentsFrom SupplierPayment[]
  supplierReturnsInto  SupplierPaymentReturn[]
  bankProfiles         BankImportProfile[]
  bankImports          BankStatementImport[]
  bankLines            BankStatementLine[]

  @@unique([organizationId, code])
  // So that every table that names an account can name its organization with it
  @@unique([organizationId, id])
  @@index([organizationId, type])
  @@map("ledger_accounts")
}

// A tax of the organization (TDD_18 §7). The rate is basis points (13 % is 1300): no float ever holds a percent. The accounts are
// the ones a sale (output) and a purchase or an expense (input) post the tax to. A rate that was used is deactivated, never
// deleted: the orders, the products and the lines of the journal point at it.
model TaxRate {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  code            String // the accountant's short name, unique per organization
  name            String // plain data the accountant edits (the template seeds it)
  rateBps         Int      @map("rate_bps") // 0 to 10000
  kind            String   @default("vat") // TaxKind
  outputAccountId String   @map("output_account_id")
  inputAccountId  String   @map("input_account_id")
  active          Boolean  @default(true)
  isDefault       Boolean  @default(false) @map("is_default") // the rate of a taxed product that names none; at most one per organization
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  outputAccount LedgerAccount        @relation("TaxRateOutputAccount", fields: [organizationId, outputAccountId], references: [organizationId, id], onDelete: Restrict)
  inputAccount  LedgerAccount        @relation("TaxRateInputAccount", fields: [organizationId, inputAccountId], references: [organizationId, id], onDelete: Restrict)
  products      Product[]
  lines         JournalLine[]
  transactions  FinanceTransaction[]
  purchaseLines PurchaseOrderLine[]

  @@unique([organizationId, code])
  // So that a product and a line can name the organization with the rate
  @@unique([organizationId, id])
  @@map("tax_rates")
}

// Which account each automatic entry posts to (TDD_18 §3, AccountRole)
model AccountRoleMapping {
  organizationId String @map("organization_id")
  role           String // AccountRole
  accountId      String @map("account_id")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account      LedgerAccount @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, role])
  @@index([accountId])
  @@map("account_role_mappings")
}

// Which account receives a payment method (TDD_18 §6.2); store_id NULL is the default of the organization
model PaymentMethodAccount {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  storeId        String? @map("store_id")
  paymentMethod  String  @map("payment_method") // PaymentMethod (CASH_ON_DELIVERY is not listed: it goes to the carrier receivable)
  accountId      String  @map("account_id")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  store        Store?        @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Restrict)
  account      LedgerAccount @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)

  // One default per method is a partial index in the migration: here a NULL store is never equal to another
  @@unique([organizationId, storeId, paymentMethod])
  @@index([accountId])
  @@map("payment_method_accounts")
}

model FiscalPeriod {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  year           Int
  month          Int // 1 to 12
  startsOn       DateTime  @map("starts_on") @db.Date
  endsOn         DateTime  @map("ends_on") @db.Date
  status         String    @default("open") // PeriodStatus
  closedAt       DateTime? @map("closed_at")
  closedBy       String?   @map("closed_by")
  reopenedAt     DateTime? @map("reopened_at")
  reopenedBy     String?   @map("reopened_by")
  reopenReason   String?   @map("reopen_reason")
  closingHash    String?   @map("closing_hash") // the head of the entry chain when it closed (TDD_18 §5.1)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entries       JournalEntry[]
  balances      AccountPeriodBalance[]
  bookSnapshots FinanceBookSnapshot[]

  @@unique([organizationId, year, month])
  @@unique([organizationId, id])
  @@map("fiscal_periods")
}

// The journal: immutable (TDD_18 §2.5). The database refuses an UPDATE or a DELETE of an entry or a line, whoever asks.
model JournalEntry {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  number          BigInt // gapless, per organization, from FinanceSettings.nextEntryNumber
  entryDate       DateTime  @map("entry_date") @db.Date // the accounting date; decides the period
  periodId        String    @map("period_id")
  type            String // JournalEntryType
  sourceType      String?   @map("source_type") // FinanceSourceType; null for a manual entry
  sourceId        String?   @map("source_id")
  sourceDate      DateTime? @map("source_date") @db.Date // when the source event really happened (a late post keeps it)
  idempotencyKey  String    @map("idempotency_key") // e.g. 'order:<id>:sale'; unique per organization
  reversesEntryId String?   @map("reverses_entry_id") // set on the reversing entry only; the original is never touched
  memo            String?
  currency        String    @default("USD")
  totalCents      Int       @map("total_cents") // sum of debits (= sum of credits)
  createdBy       String?   @map("created_by") // a user; null for the system, then `origin` says why
  origin          String // EntryOrigin: user | system
  createdAt       DateTime  @default(now()) @map("created_at")
  prevHash        String?   @map("prev_hash") // hash of the previous entry of the organization
  hash            String // sha256 over the canonical entry and its lines and prevHash (TDD_18 §11)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  period                FiscalPeriod           @relation(fields: [organizationId, periodId], references: [organizationId, id], onDelete: Restrict)
  reverses              JournalEntry?          @relation("Reversal", fields: [organizationId, reversesEntryId], references: [organizationId, id], onDelete: Restrict)
  reversedBy            JournalEntry?          @relation("Reversal")
  lines                 JournalLine[]
  transaction           FinanceTransaction?    @relation("TransactionEntry")
  voidedTransaction     FinanceTransaction?    @relation("TransactionVoidEntry")
  purchaseReceipt       PurchaseReceipt?       @relation("ReceiptEntry")
  supplierPayment       SupplierPayment?       @relation("PaymentEntry")
  voidedPayment         SupplierPayment?       @relation("PaymentVoidEntry")
  supplierPaymentReturn SupplierPaymentReturn? @relation("ReturnEntry")
  voidedPaymentReturn   SupplierPaymentReturn? @relation("ReturnVoidEntry")
  fiscalDocuments       FiscalDocument[]

  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, id])
  // An entry is reversed at most once (FINANCE_ENTRY_ALREADY_REVERSED)
  @@unique([organizationId, reversesEntryId])
  @@index([organizationId, periodId])
  @@index([organizationId, sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(uuid())
  entryId        String  @map("entry_id")
  organizationId String  @map("organization_id")
  storeId        String? @map("store_id") // a dimension, not a scope (TDD_18 §2.2)
  accountId      String  @map("account_id")
  debitCents     Int     @default(0) @map("debit_cents")
  creditCents    Int     @default(0) @map("credit_cents")
  partyType      String? @map("party_type") // PartyType: supplier | carrier_connection | customer
  partyId        String? @map("party_id") // dimension for subledgers (payables, carrier receivables)
  taxRateId      String? @map("tax_rate_id") // set on the lines that carry VAT
  memo           String?
  lineNo         Int     @map("line_no")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entry        JournalEntry          @relation(fields: [organizationId, entryId], references: [organizationId, id], onDelete: Restrict)
  account      LedgerAccount         @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  store        Store?                @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Restrict)
  taxRate      TaxRate?              @relation(fields: [organizationId, taxRateId], references: [organizationId, id], onDelete: Restrict)
  matches      ReconciliationMatch[]

  @@unique([entryId, lineNo])
  @@index([organizationId, accountId])
  @@index([storeId])
  @@map("journal_lines")
}

// What each account has had debited and credited in a period, by store (TDD_18 §2.5): kept in the same transaction as
// the entry and recomputed by the daily reconciliation. The unique key treats a null store as one (a partial index pair
// in the migration, since Prisma cannot say it).
model AccountPeriodBalance {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  accountId      String   @map("account_id")
  storeId        String?  @map("store_id")
  periodId       String   @map("period_id")
  debitCents     BigInt   @default(0) @map("debit_cents")
  creditCents    BigInt   @default(0) @map("credit_cents")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account      LedgerAccount @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  period       FiscalPeriod  @relation(fields: [organizationId, periodId], references: [organizationId, id], onDelete: Restrict)
  store        Store?        @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, periodId])
  @@index([accountId])
  @@map("account_period_balances")
}

// What a person registers by hand: an expense, an income or a transfer between accounts (TDD_18 §2.6, §4.3). The operational header
// of ONE journal entry (E12): the amounts and accounts here are what the entry was posted from, and the entry is the record of the
// money. A transaction is never edited: voiding it writes the reversing entry and points at it, and changing one voids it and
// creates another in one request (`replacesTransactionId`), so the journal tells the whole story. Organization-scoped; `storeId`
// is the dimension its lines carry. Whole USD cents, tax included.
model FinanceTransaction {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  storeId               String?  @map("store_id") // the store it belongs to for the reports, optional
  kind                  String // FinanceTransactionKind: expense | income | transfer
  occurredOn            DateTime @map("occurred_on") @db.Date
  amountCents           Int      @map("amount_cents") // paid or received, tax included
  fromAccountId         String?  @map("from_account_id") // the money source (expense, transfer): a cash-kind account
  toAccountId           String?  @map("to_account_id") // the money destination (income, transfer): a cash-kind account
  categoryAccountId     String?  @map("category_account_id") // the expense or income account it is classified under
  taxRateId             String?  @map("tax_rate_id")
  taxCents              Int      @default(0) @map("tax_cents") // the tax inside amountCents, computed by the server
  taxCreditable         Boolean  @default(false) @map("tax_creditable") // an expense's tax is input VAT only with a valid document [ACCOUNTANT]
  documentNumber        String?  @map("document_number") // the supplier's document number
  documentMediaId       String?  @unique @map("document_media_id") // the receipt: a Media of purpose finance_document made for this transaction, set once
  memo                  String?
  clientKey             String   @map("client_key") // the screen's key for the request: a retry is the same transaction
  entryId               String   @map("entry_id") // the entry it produced
  voidedByEntryId       String?  @map("voided_by_entry_id") // the reversing entry, once voided
  replacesTransactionId String?  @map("replaces_transaction_id") // the transaction this one replaced when it was changed
  createdBy             String   @map("created_by")
  createdAt             DateTime @default(now()) @map("created_at")

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  store           Store?              @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Restrict)
  fromAccount     LedgerAccount?      @relation("TransactionFromAccount", fields: [organizationId, fromAccountId], references: [organizationId, id], onDelete: Restrict)
  toAccount       LedgerAccount?      @relation("TransactionToAccount", fields: [organizationId, toAccountId], references: [organizationId, id], onDelete: Restrict)
  categoryAccount LedgerAccount?      @relation("TransactionCategoryAccount", fields: [organizationId, categoryAccountId], references: [organizationId, id], onDelete: Restrict)
  taxRate         TaxRate?            @relation(fields: [organizationId, taxRateId], references: [organizationId, id], onDelete: Restrict)
  entry           JournalEntry        @relation("TransactionEntry", fields: [organizationId, entryId], references: [organizationId, id], onDelete: Restrict)
  voidedByEntry   JournalEntry?       @relation("TransactionVoidEntry", fields: [organizationId, voidedByEntryId], references: [organizationId, id], onDelete: Restrict)
  replaces        FinanceTransaction? @relation("TransactionReplaced", fields: [organizationId, replacesTransactionId], references: [organizationId, id], onDelete: Restrict)
  replacedBy      FinanceTransaction? @relation("TransactionReplaced")
  documentMedia   Media?              @relation("TransactionDocument", fields: [documentMediaId], references: [id], onDelete: Restrict)
  documents       Media[]             @relation("TransactionDocuments")

  @@unique([organizationId, id])
  @@unique([organizationId, clientKey])
  @@unique([organizationId, entryId])
  @@unique([organizationId, voidedByEntryId])
  @@unique([organizationId, replacesTransactionId])
  @@index([organizationId, occurredOn])
  @@index([organizationId, kind, occurredOn])
  // The list: the newest first, by page
  @@index([organizationId, createdAt, id])
  @@map("finance_transactions")
}

// ============================================================
// SUPPLIERS AND PURCHASES (TDD_18 §2.7, Step 4B.5): organization-scoped like the books they post to. Whole USD cents.
// ============================================================

// Who the organization buys from. Never deleted: a supplier with bills or payments is switched off, and its payable account is
// fixed once it has a bill (its payments would otherwise post to another account than its bills).
model Supplier {
  id                      String   @id @default(uuid())
  organizationId          String   @map("organization_id")
  name                    String
  taxId                   String?  @map("tax_id")
  contactName             String?  @map("contact_name")
  email                   String?
  phone                   String?
  paymentTermsDays        Int      @default(0) @map("payment_terms_days") // the bill of a receipt falls due this many days after it
  defaultPayableAccountId String?  @map("default_payable_account_id") // null = the account of the PAYABLE_SUPPLIERS role
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  defaultPayableAccount LedgerAccount?          @relation(fields: [organizationId, defaultPayableAccountId], references: [organizationId, id], onDelete: Restrict)
  orders                PurchaseOrder[]
  receipts              PurchaseReceipt[]
  payments              SupplierPayment[]
  paymentReturns        SupplierPaymentReturn[]

  // So that every table that names a supplier can name its organization with it. The name is unique ignoring case: a raw index of the migration
  @@unique([organizationId, id])
  @@index([organizationId, active])
  @@map("suppliers")
}

// What was ordered from a supplier, to be received into ONE warehouse. The number is the organization's sequence
// (`FinanceSettings.nextPurchaseNumber`); the status moves along `PurchaseOrderStatusTransitions` only.
model PurchaseOrder {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  number         String
  supplierId     String    @map("supplier_id")
  warehouseId    String    @map("warehouse_id")
  status         String // PurchaseOrderStatus
  orderedOn      DateTime? @map("ordered_on") @db.Date
  expectedOn     DateTime? @map("expected_on") @db.Date
  notes          String?
  clientKey      String    @map("client_key") // the screen's key: a retry of the create is the same order
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier     Supplier            @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  warehouse    Warehouse           @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  lines        PurchaseOrderLine[]
  receipts     PurchaseReceipt[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, clientKey])
  @@index([organizationId, status])
  @@index([organizationId, supplierId])
  // The list: the newest first, by page
  @@index([organizationId, createdAt, id])
  @@map("purchase_orders")
}

// One item of an order, at the cost before tax of ONE unit. It carries the store of the product (the stock it raises is that store's), so a
// member of one store reads only the lines of its own.
model PurchaseOrderLine {
  id               String  @id @default(uuid())
  organizationId   String  @map("organization_id")
  storeId          String  @map("store_id")
  purchaseOrderId  String  @map("purchase_order_id")
  lineNo           Int     @map("line_no")
  productId        String  @map("product_id")
  variantId        String? @map("variant_id")
  quantity         Int
  receivedQuantity Int     @default(0) @map("received_quantity")
  unitCostCents    Int     @map("unit_cost_cents") // before tax
  taxRateId        String? @map("tax_rate_id")

  order        PurchaseOrder         @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Cascade)
  store        Store                 @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Restrict)
  product      Product               @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Restrict)
  variant      ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  taxRate      TaxRate?              @relation(fields: [organizationId, taxRateId], references: [organizationId, id], onDelete: Restrict)
  receiptLines PurchaseReceiptLine[]

  @@unique([organizationId, id])
  @@unique([purchaseOrderId, lineNo])
  @@index([storeId])
  @@index([productId, variantId])
  @@map("purchase_order_lines")
}

// One receiving event, and the supplier's bill (E10): what is owed, when it falls due, and the entry that posted it. Never edited
// and never deleted; the goods it brought in are taken back by a return to the supplier (after the MVP), not by undoing it.
model PurchaseReceipt {
  id                     String   @id @default(uuid())
  organizationId         String   @map("organization_id")
  purchaseOrderId        String   @map("purchase_order_id")
  supplierId             String   @map("supplier_id")
  receivedOn             DateTime @map("received_on") @db.Date
  dueOn                  DateTime @map("due_on") @db.Date
  supplierDocumentNumber String?  @map("supplier_document_number")
  taxCreditable          Boolean  @map("tax_creditable") // the tax is input VAT only against a supplier document [ACCOUNTANT]
  subtotalCents          Int      @map("subtotal_cents")
  taxCents               Int      @map("tax_cents")
  totalCents             Int      @map("total_cents") // what is owed to the supplier
  clientKey              String   @map("client_key")
  entryId                String   @map("entry_id")
  createdBy              String   @map("created_by")
  createdAt              DateTime @default(now()) @map("created_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        PurchaseOrder         @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict)
  supplier     Supplier              @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  entry        JournalEntry          @relation("ReceiptEntry", fields: [organizationId, entryId], references: [organizationId, id], onDelete: Restrict)
  lines        PurchaseReceiptLine[]
  payments     SupplierPayment[]

  @@unique([organizationId, id])
  @@unique([organizationId, clientKey])
  @@unique([organizationId, entryId])
  @@index([organizationId, supplierId, dueOn])
  @@index([purchaseOrderId])
  @@map("purchase_receipts")
}

// What one line of a receipt took in: the units, the cost of one before tax and the stock movement that raised the level.
model PurchaseReceiptLine {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  storeId        String @map("store_id")
  receiptId      String @map("receipt_id")
  orderLineId    String @map("order_line_id")
  quantity       Int
  unitCostCents  Int    @map("unit_cost_cents")
  subtotalCents  Int    @map("subtotal_cents")
  taxCents       Int    @map("tax_cents")
  movementId     String @map("movement_id") // the inventory movement this line made (the ledger of stock is append-only)

  receipt   PurchaseReceipt   @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Restrict)
  store     Store             @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Restrict)
  orderLine PurchaseOrderLine @relation(fields: [organizationId, orderLineId], references: [organizationId, id], onDelete: Restrict)

  @@index([receiptId])
  @@index([storeId])
  @@index([orderLineId])
  @@map("purchase_receipt_lines")
}

// A payment to a supplier (E11), from the cash, bank or wallet account the person chose, against one bill or against what is owed in all. It is
// never edited: voiding it writes the reversing entry and points at it, once.
model SupplierPayment {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  supplierId        String   @map("supplier_id")
  purchaseReceiptId String?  @map("purchase_receipt_id")
  paidFromAccountId String   @map("paid_from_account_id")
  amountCents       Int      @map("amount_cents")
  paidOn            DateTime @map("paid_on") @db.Date
  reference         String?
  clientKey         String   @map("client_key")
  entryId           String   @map("entry_id")
  voidedByEntryId   String?  @map("voided_by_entry_id")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier      Supplier                @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  receipt       PurchaseReceipt?        @relation(fields: [organizationId, purchaseReceiptId], references: [organizationId, id], onDelete: Restrict)
  paidFrom      LedgerAccount           @relation(fields: [organizationId, paidFromAccountId], references: [organizationId, id], onDelete: Restrict)
  entry         JournalEntry            @relation("PaymentEntry", fields: [organizationId, entryId], references: [organizationId, id], onDelete: Restrict)
  voidedByEntry JournalEntry?           @relation("PaymentVoidEntry", fields: [organizationId, voidedByEntryId], references: [organizationId, id], onDelete: Restrict)
  returns       SupplierPaymentReturn[]

  @@unique([organizationId, id])
  @@unique([organizationId, clientKey])
  @@unique([organizationId, entryId])
  @@unique([organizationId, voidedByEntryId])
  @@index([organizationId, supplierId, paidOn])
  @@index([purchaseReceiptId])
  @@map("supplier_payments")
}

// What a supplier gave back of a payment (TDD_18 §4.2 E11b, HC-121): the bank returned it or the payment bounced. It is a fact of its own,
// never the voiding of the payment (the payment happened and the bank saw it): one entry (Dr the account the money came back into, Cr the
// payable account with the supplier as party) that the bank statement can match, and the debt is owed again by that amount. Never edited;
// voiding it writes the reversing entry. The sum of the live returns of a payment never exceeds the payment.
model SupplierPaymentReturn {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  supplierId            String   @map("supplier_id")
  supplierPaymentId     String   @map("supplier_payment_id")
  receivedIntoAccountId String   @map("received_into_account_id")
  amountCents           Int      @map("amount_cents")
  returnedOn            DateTime @map("returned_on") @db.Date
  reference             String?
  clientKey             String   @map("client_key")
  entryId               String   @map("entry_id")
  voidedByEntryId       String?  @map("voided_by_entry_id")
  createdBy             String   @map("created_by")
  createdAt             DateTime @default(now()) @map("created_at")

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier      Supplier        @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  payment       SupplierPayment @relation(fields: [organizationId, supplierPaymentId], references: [organizationId, id], onDelete: Restrict)
  receivedInto  LedgerAccount   @relation(fields: [organizationId, receivedIntoAccountId], references: [organizationId, id], onDelete: Restrict)
  entry         JournalEntry    @relation("ReturnEntry", fields: [organizationId, entryId], references: [organizationId, id], onDelete: Restrict)
  voidedByEntry JournalEntry?   @relation("ReturnVoidEntry", fields: [organizationId, voidedByEntryId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, clientKey])
  @@unique([organizationId, entryId])
  @@unique([organizationId, voidedByEntryId])
  @@index([organizationId, supplierId, returnedOn])
  @@index([organizationId, supplierPaymentId])
  @@map("supplier_payment_returns")
}

// A source whose automatic entry could not be posted (TDD_18 §6.1): visible, never silent, and a period will not close
// over it. The posting service of Step 4B.6 writes it; Step 4B.2 only builds the table the close reads.
model FinancePostingFailure {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  sourceType     String    @map("source_type") // FinanceSourceType
  sourceId       String    @map("source_id")
  eventKind      String    @map("event_kind") // which event of the source: sale, shipped, confirm...
  reason         String // FinancePostingFailureReason: a code, never free text
  attempts       Int       @default(1)
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, sourceType, sourceId, eventKind])
  @@index([organizationId, resolvedAt])
  @@map("finance_posting_failures")
}

// An alteration of the hash chain of the journal that the weekly check found (TDD_18 §11, Step 4B.8b-2). One OPEN row per organization at
// most (a partial unique index in the migration, which Prisma cannot express): a later check that still finds the break only moves
// `last_seen_at`; a check that passes closes it. While a row is open the close of a month is refused. It is the record of an incident,
// not a fix: the journal is never touched from here.
model FinanceChainIncident {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  reason         String // ChainProblem: a code, never free text
  entryNumber    String?   @map("entry_number") // the number of the last entry the walk trusted, or of the broken one
  entriesChecked Int       @map("entries_checked")
  detectedAt     DateTime  @default(now()) @map("detected_at")
  lastSeenAt     DateTime  @map("last_seen_at")
  resolvedAt     DateTime? @map("resolved_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, resolvedAt])
  @@map("finance_chain_incidents")
}

// ============================================================================================================
// Bank reconciliation by CSV (TDD_18 §2.7, §4.4), Step 4B.4b-2. No connection to a bank: a person imports the CSV the bank gives, read with
// a saved profile; the lines are suggested against the journal lines of the cash account and a PERSON confirms or rejects each. The
// journal is never touched: a match is a row here, so the immutable lines carry no flag.
// ============================================================================================================

// How the CSV of one cash, bank or wallet account is read (every bank is data, none is built in)
model BankImportProfile {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  accountId          String   @map("account_id") // a cash-kind account of the organization
  name               String
  delimiter          String   @default(",")
  hasHeader          Boolean  @default(true) @map("has_header")
  skipRows           Int      @default(0) @map("skip_rows") // records dropped from the start of the file (a lead of report lines)
  decimalSeparator   String   @default(".") @map("decimal_separator")
  thousandsSeparator String   @default("none") @map("thousands_separator") // BankThousandsSeparator
  dateFormat         String   @default("yyyy-MM-dd") @map("date_format")
  encoding           String   @default("utf-8") // BankStatementEncoding
  dateWindowDays     Int      @default(3) @map("date_window_days") // how far apart a statement line and a book line may be and still be suggested
  columns            Json // { date, description?, reference?, amount | debit + credit } -> header text or column position
  createdBy          String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account      LedgerAccount @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, accountId, name])
  @@unique([organizationId, id])
  @@map("bank_import_profiles")
}

// One file of a statement that was read and accepted: append-only, the evidence of what was imported (the file is kept as a Media)
model BankStatementImport {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  accountId           String    @map("account_id")
  profileId           String?   @map("profile_id") // a plain column: the evidence of how it was read, which outlives the profile
  mediaId             String    @unique @map("media_id") // the file as it was sent, kept as a finance_document
  lineCount           Int       @map("line_count") // the lines of the file
  newLineCount        Int       @map("new_line_count") // the ones that were not in the books of the bank before (the rest were imported already)
  firstDay            DateTime  @map("first_day") @db.Date
  lastDay             DateTime  @map("last_day") @db.Date
  closingBalanceCents Int?      @map("closing_balance_cents") // the balance the statement ends with, said by the person who imported it
  closingOn           DateTime? @map("closing_on") @db.Date
  createdBy           String    @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account      LedgerAccount       @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  media        Media               @relation("BankImportFile", fields: [mediaId], references: [id], onDelete: Restrict)
  lines        BankStatementLine[]

  @@unique([organizationId, id])
  @@index([organizationId, accountId, createdAt])
  @@map("bank_statement_imports")
}

// A line of a statement: append-only. `lineHash` makes a line that was imported before the same line (a statement that overlaps the
// last one never doubles what it repeats).
model BankStatementLine {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  importId       String   @map("import_id") // the import that brought it first
  accountId      String   @map("account_id")
  lineNo         Int      @map("line_no") // the line of the file where its row starts
  postedOn       DateTime @map("posted_on") @db.Date
  amountCents    Int      @map("amount_cents") // signed: money in is positive, money out is negative; never 0
  description    String?
  reference      String?
  lineHash       String   @map("line_hash") // sha256 of account, day, amount, reference, description and which of the equal ones it is
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account      LedgerAccount         @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  import       BankStatementImport   @relation(fields: [organizationId, importId], references: [organizationId, id], onDelete: Restrict)
  matches      ReconciliationMatch[]

  @@unique([organizationId, accountId, lineHash])
  @@unique([organizationId, id])
  @@index([importId, lineNo])
  @@index([organizationId, accountId, postedOn])
  @@map("bank_statement_lines")
}

// What a person decided about a statement line and a journal line of the same cash account: confirmed (they are the same movement),
// rejected (never suggest this pair again) or undone (either decision taken back: kept as history). The only row that moves is the
// status of a decision, once, to `undone`; there is at most one confirmed match per statement line and per journal line (partial
// unique indexes of the migration).
model ReconciliationMatch {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  statementLineId String    @map("statement_line_id")
  journalLineId   String    @map("journal_line_id")
  status          String // ReconciliationMatchStatus
  decidedBy       String    @map("decided_by")
  decidedAt       DateTime  @default(now()) @map("decided_at")
  undoneBy        String?   @map("undone_by")
  undoneAt        DateTime? @map("undone_at")
  // The decisions that confirmed ONE statement line against several lines of the journal share it (HC-121); null for a pair
  groupId         String?   @map("group_id")
  // The one row of a group that stands for it (the unique index of the confirmed decisions of a line holds it)
  isGroupLead     Boolean   @default(false) @map("is_group_lead")

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  statementLine BankStatementLine @relation(fields: [organizationId, statementLineId], references: [organizationId, id], onDelete: Restrict)
  journalLine   JournalLine       @relation(fields: [journalLineId], references: [id], onDelete: Restrict)

  @@index([organizationId, statementLineId])
  @@index([journalLineId])
  @@index([organizationId, groupId])
  @@map("reconciliation_matches")
}

// Fiscal documents (TDD_18 §8, Step 4B.7). Core owns the lifecycle; the provider named by `providerId` owns what is legal and
// country-specific, and its id is plain data here, never a constant of core.
// The legal entity that issues (the organization), one row. The credentials are what the provider needs to sign and to talk to the
// authority, encrypted like the credentials of a carrier (libs/core/crypto): never returned, never logged.
model FiscalIssuer {
  organizationId       String   @id @map("organization_id")
  providerId           String   @map("provider_id")
  legalName            String   @map("legal_name")
  taxId                String   @map("tax_id")
  registrationId       String?  @map("registration_id")
  address              Json
  activityCode         String?  @map("activity_code")
  establishmentCode    String?  @map("establishment_code")
  // The kind of establishment, the code of the point of sale and the contact of the issuer, in the words of the provider's manifest (Step 4B.7c-1)
  establishmentType    String?  @map("establishment_type")
  pointOfSaleCode      String?  @map("point_of_sale_code")
  phone                String?
  email                String?
  environment          String // FiscalEnvironment
  issueOn              String   @default("delivered") @map("issue_on") // FiscalIssueOn: when the document of a sale is made
  credentialsEncrypted Bytes?   @map("credentials_encrypted")
  // The correlative of the documents of the organization: taken with an atomic increment when a document is made
  nextSequence         Int      @default(1) @map("next_sequence")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("fiscal_issuers")
}

// The counters of the correlatives a provider's manifest asks for (Step 4B.7c-1): one row per series, the key being a hash of the provider,
// the environment and what the manifest declares (document type, establishment, point of sale). Taken with an atomic increment under the
// lock of the document that takes it. A provider that declares no scope has no row here: its documents count in `FiscalIssuer.nextSequence`.
model FiscalSequence {
  organizationId String   @map("organization_id")
  scopeKey       String   @map("scope_key")
  scope          Json // what the key was made of: shown to a person by the series view (never used to find a counter: the key does that)
  nextValue      Int      @default(1) @map("next_value")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, scopeKey])
  @@map("fiscal_sequences")
}

// The layout of a legal book of the organization (TDD_18 §7, §13 row 6; Step 4B.8b-3). **[ACCOUNTANT]** The format of a legal book is the
// accountant's and the law's: a layout is the organization's own data (columns, order, correlative), versioned and never changed in
// place, so the book of a closed month can be asked for again with the version it was written with and give the same bytes. A kind with
// no row uses the proposal of the code, which nobody has validated.
model FinanceBookLayout {
  id                  String   @id @default(uuid())
  organizationId      String   @map("organization_id")
  bookKind            String   @map("book_kind") // LegalBookKind
  version             Int
  columns             Json // [{ field: LegalBookField, label: string | null }]
  sort                String // LegalBookSort
  correlativeStart    Int      @map("correlative_start")
  correlativeRestart  String   @map("correlative_restart") // LegalBookCorrelativeRestart
  unissuedSales       String   @map("unissued_sales") // LegalBookUnissuedSales
  accountantConfirmed Boolean  @default(false) @map("accountant_confirmed") // somebody with the accountant's word says this is the layout the law asks for
  createdBy           String   @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, bookKind, version])
  @@map("finance_book_layouts")
}

// A legal book of a CLOSED period as it was the first time it was asked for (Step 4B.8b-3): the book of a closed month is served from
// here from then on, byte for byte, even if a supplier was renamed since (the name of a supplier is not in the ledger). Keyed by the
// closing it was taken at, so a month reopened and closed again takes a new one. Never changed or deleted.
model FinanceBookSnapshot {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  periodId       String   @map("period_id")
  bookKind       String   @map("book_kind") // LegalBookKind
  layoutVersion  Int      @map("layout_version") // 0 = the proposal of the code
  closedAt       DateTime @map("closed_at") // the closing of the period this was taken at
  book           Json // the book as the pure builder made it (header, rows, totals, warnings): the CSV is a function of it
  contentSha256  String   @map("content_sha256")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  period       FiscalPeriod @relation(fields: [organizationId, periodId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, periodId, bookKind, layoutVersion, closedAt], map: "finance_book_snapshots_key")
  @@index([organizationId, createdAt])
  @@map("finance_book_snapshots")
}

model FiscalDocument {
  id                    String    @id @default(uuid())
  organizationId        String    @map("organization_id")
  storeId               String    @map("store_id")
  orderId               String    @map("order_id")
  kind                  String    @default("sale") // FiscalDocumentKind: the document of a sale, or the credit note of a return
  returnId              String?   @map("return_id") // a credit note of one return; null for the credit note of an order that came back as a whole
  parentDocumentId      String?   @map("parent_document_id") // a credit note: the sale document it cancels (part of)
  replacesDocumentId    String?   @map("replaces_document_id") // a sale document made again after the one before was voided
  journalEntryId        String?   @map("journal_entry_id") // the sale entry it belongs to; linked, never copied amounts
  sequenceNumber        Int       @map("sequence_number") // the correlative of the organization
  correlative           Int?      @map("correlative") // the number in the series the provider's manifest names (Step 4B.7c-1); null while the document has none, and for a provider that declares no scope (its number is sequenceNumber)
  correlativeScopeKey   String?   @map("correlative_scope_key") // the series `correlative` was taken in (`FiscalSequence.scopeKey`)
  documentType          String    @map("document_type") // a type the manifest of the provider declares
  status                String // FiscalDocumentStatus
  providerId            String    @map("provider_id") // the provider that built it: a later change of issuer does not rewrite history
  environment           String // FiscalEnvironment at the time
  externalNumber        String?   @map("external_number") // what the provider or the authority assigned
  providerData          Json?     @map("provider_data") // opaque to core
  issuerSnapshot        Json      @map("issuer_snapshot") // the issuer at issue time, without credentials
  linesSnapshot         Json      @map("lines_snapshot") // the lines with the tax snapshot of the order (Step 4B.3b)
  receiverEncrypted     Bytes     @map("receiver_encrypted") // name, tax id and address of the customer: customer data, encrypted at rest
  builtPayloadEncrypted Bytes?    @map("built_payload_encrypted") // what the provider built: the legal evidence, fixed once accepted; it holds the receiver's data, so it is sealed like the receiver
  response              Json? // what the authority answered
  currency              String    @default("USD")
  totalCents            Int       @map("total_cents")
  taxCents              Int       @map("tax_cents")
  rejectionReason       String?   @map("rejection_reason") // a code, never the receiver's data
  attempts              Int       @default(0)
  submission            Int       @default(1) // moves only when the authority refused the document: the idempotency key is organization:document:submission
  voidReason            String?   @map("void_reason")
  voidedBy              String?   @map("voided_by")
  voidedAt              DateTime? @map("voided_at")
  voidClaimKey          String?   @map("void_claim_key") // the idempotency key of the invalidation that holds the document, until voidClaimUntil
  voidClaimUntil        DateTime? @map("void_claim_until") // the lease of that claim: no other invalidation of this document is sent before it
  voidResponse          Json?     @map("void_response") // what the authority answered to the invalidation: the evidence of the void, kept apart because the accepted row cannot change
  issuedAt              DateTime? @map("issued_at")
  contingencyId         String?   @map("contingency_id") // set when the document was made in contingency (the deferred model); fixed for ever once it is
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  store        Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  contingency  FiscalContingency? @relation(fields: [contingencyId], references: [id], onDelete: Restrict)
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  entry        JournalEntry?      @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  orderReturn  OrderReturn?       @relation(fields: [returnId], references: [id], onDelete: Restrict)
  // NoAction (checked when the statement ends), so a statement that removes a document and the ones that name it works in one go
  parent       FiscalDocument?    @relation("FiscalCreditNotes", fields: [parentDocumentId], references: [id], onDelete: NoAction)
  creditNotes  FiscalDocument[]   @relation("FiscalCreditNotes")
  replaces     FiscalDocument?    @relation("FiscalReplacement", fields: [replacesDocumentId], references: [id], onDelete: NoAction)
  replacedBy   FiscalDocument[]   @relation("FiscalReplacement")
  evidence     Media[]            @relation("FiscalEvidence")

  // At most one live sale document per order, one live credit note per return and one per order that came back with no return row: the
  // partial unique indexes of the migration say it (Prisma cannot), a voided document leaves room for the one that replaces it, and a
  // document that replaces another (made first, before the original is voided) is left out of the live-sale index: it is unique through
  // the one-replacement-per-document index
  @@unique([organizationId, sequenceNumber])
  // One number of a series for one document: Postgres reads two nulls as different, so a document with no number yet never collides
  @@unique([organizationId, correlativeScopeKey, correlative])
  @@index([organizationId, orderId])
  @@index([returnId])
  @@index([parentDocumentId])
  @@index([replacesDocumentId])
  @@index([organizationId, status])
  @@index([storeId])
  @@index([contingencyId])
  @@map("fiscal_documents")
}

// A contingency of an issuer (Step 4B.7c-7, TDD_18 §8.3): the time the authority could not be reached and the issuer went on making
// documents in the deferred model. At most one is OPEN per organization (a partial unique index of the migration says it). The row never
// is deleted and only moves forward: OPEN, CLOSED (the window ended, the event that reports it is not accepted yet), REPORTED (the
// authority took the event; the documents of the lot go out from then, inside the window the provider declares).
model FiscalContingency {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  providerId           String    @map("provider_id")
  environment          String // FiscalEnvironment
  status               String // FiscalContingencyStatus
  origin               String // FiscalContingencyOrigin
  reason               String // one of the reasons the provider's manifest declares: the provider's words, never read by core
  motive               String? // what the person wrote about it
  responsibleEncrypted Bytes?    @map("responsible_encrypted") // who answers for the establishment (name and identity document), sealed: given when it is ended
  eventCode            String    @unique @map("event_code") // the stable identifier of the event that reports it, in the shape of a random UUID
  startedAt            DateTime  @map("started_at")
  endedAt              DateTime? @map("ended_at")
  reportedAt           DateTime? @map("reported_at") // when the authority took the event
  windowEndsAt         DateTime? @map("window_ends_at") // the last instant to send the documents of the lot (the provider's window after `reportedAt`)
  warnedAt             DateTime? @map("warned_at") // the person was told the window is closing
  providerData         Json?     @map("provider_data") // opaque to core: the seal the authority gave the event
  response             Json? // what the authority answered
  reportAttempts       Int       @default(0) @map("report_attempts")
  lastReportError      String?   @map("last_report_error") // a code, never data
  openedBy             String?   @map("opened_by") // a user, null when the lifecycle opened it
  closedBy             String?   @map("closed_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documents    FiscalDocument[]

  @@index([organizationId, status])
  @@map("fiscal_contingencies")
}
