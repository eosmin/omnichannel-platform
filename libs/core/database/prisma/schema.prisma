// The CJS output has no import.meta and bare imports, so the Jest suites (compiled as CJS) and the
// ESM code run by tsx load the same generated client. The ESM output breaks under Jest.
generator client {
  provider            = "prisma-client"
  output              = "../generated/client"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ORGANIZATIONS & TENANCY
// ============================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stores              Store[]
  memberships         Membership[]
  invitations         Invitation[]
  dataSubjectRequests DataSubjectRequest[]
  warehouses          Warehouse[]
  stockCounts         StockCount[]
  stockTransfers      StockTransfer[]

  @@map("organizations")
}

model Store {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  timezone       String   @default("America/El_Salvador")
  currency       String   @default("USD")
  defaultLocale  String   @default("es") @map("default_locale")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settings                StoreSettings?
  businessHours           BusinessHours?
  routingRules            RoutingRule[]
  memberships             Membership[]
  invitations             Invitation[]
  roles                   Role[]
  conversations           Conversation[]
  messages                Message[]
  conversationOrigins     ConversationOrigin[]
  messageReactions        MessageReaction[]
  messageRevisions        MessageRevision[]
  customers               Customer[]
  customerIdentities      CustomerIdentity[]
  customerMerges          CustomerMerge[]
  orders                  Order[]
  products                Product[]
  inventoryMovements      InventoryMovement[]
  inventoryLevels         InventoryLevel[]
  storeWarehouses         StoreWarehouse[]
  orderItemAllocations    OrderItemAllocation[]
  stockCountLines         StockCountLine[]
  stockTransferLines      StockTransferLine[]
  tags                    Tag[]
  snippets                Snippet[]
  media                   Media[]
  channelConnections      ChannelConnection[]
  pluginInstallations     PluginInstallation[]
  webhooks                Webhook[]
  apiKeys                 ApiKey[]
  notifications           Notification[]
  notificationPrefs       NotificationPreference[]
  retentionSettings       RetentionSettings?
  scheduledReports        ScheduledReport[]
  analyticsEvents         AnalyticsEvent[]
  metricsHourly           MetricHourly[]
  metricsDaily            MetricDaily[]
  consentRecords          ConsentRecord[]
  exports                 Export[]
  carrierConnections      CarrierConnection[]
  carrierServices         CarrierService[]
  guideSequences          GuideSequence[]
  shipments               Shipment[]
  shipmentEvents          ShipmentEvent[]
  carrierStatusMappings   CarrierStatusMapping[]
  carrierUnmappedStatuses CarrierUnmappedStatus[]
  pickupRequests          PickupRequest[]
  bulkLabelJobs           BulkLabelJob[]
  orderMessageTemplates   OrderMessageTemplate[]
  orderMessageDispatches  OrderMessageDispatch[]
  codRemittances          CodRemittance[]
  codRemittanceLines      CodRemittanceLine[]
  orderReturns            OrderReturn[]
  orderReturnLines        OrderReturnLine[]

  @@unique([organizationId, slug])
  // So that a link to a store can name its organization and the database check that they go together (StoreWarehouse)
  @@unique([organizationId, id])
  @@map("stores")
}

// Per-store behaviour toggles (TDD_09 §3, §11). One row per store, created with the store.
model StoreSettings {
  storeId                    String   @id @map("store_id")
  reopenWindowDays           Int?     @map("reopen_window_days") // null: a customer keeps one thread per channel for good (TDD_09 §3.3)
  autoArchiveAfterDays       Int      @default(30) @map("auto_archive_after_days")
  resolveShowOptions         Boolean  @default(false) @map("resolve_show_options")
  sendClosingMessage         Boolean  @default(false) @map("send_closing_message")
  closingSnippetId           String?  @map("closing_snippet_id")
  requestCsat                Boolean  @default(false) @map("request_csat")
  agentLoadThreshold         Int      @default(8) @map("agent_load_threshold") // Team widget "above threshold"
  // Safety & confirmations (TDD_09 §11.2): { confirmDeleteCustomer, confirmDisconnectChannel,
  // confirmRemoveMember, applyToRoles: RoleName[], moderateRiskMode: 'dialog'|'undo'|'none' }
  safety                     Json     @default("{}")
  preferences                Json     @default("{}") // storePreferencesSchema (TDD_17 §4.14)
  returnShippingPayer        String   @default("sender") @map("return_shipping_payer")
  defaultCarrierConnectionId String?  @map("default_carrier_connection_id") // Plain column until Step 4.8
  bulkLabelRetentionDays     Int      @default(7) @map("bulk_label_retention_days")
  // Inventory (TDD_16 §2, §4.1, §4.4, §4.10): the three are edited in Settings -> Inventory
  defaultLowStockThreshold   Int?     @map("default_low_stock_threshold") // The threshold a new product starts with; null = none
  allowNegativeStock         Boolean  @default(false) @map("allow_negative_stock")
  allowSplitFulfillment      Boolean  @default(false) @map("allow_split_fulfillment")
  // Orders (TDD_17 §4.3): the number the next order of the store takes; OrdersService raises it as it makes the order
  nextOrderNumber            Int      @default(1) @map("next_order_number")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

model BusinessHours {
  storeId              String   @id @map("store_id")
  timezone             String
  // { mon: [{ from: "09:00", to: "18:00" }], ..., sun: [] }
  schedule             Json
  awayMessageSnippetId String?  @map("away_message_snippet_id")
  updatedAt            DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("business_hours")
}

// Assignment rules evaluated in priority order on every new inbound conversation
// (TDD_10 §4 step "routing"). conditions/action shapes are Zod schemas in
// libs/core/domain/schemas/routing-rule.schema.ts.
model RoutingRule {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  name       String
  priority   Int
  enabled    Boolean  @default(true)
  // { channelTypes?: ChannelType[], tagIds?: string[], keywords?: string[], outsideBusinessHours?: boolean }
  conditions Json
  // { type: 'assign_user' | 'round_robin' | 'unassigned', userIds?: string[] }
  action     Json
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, priority])
  @@index([storeId, enabled])
  @@map("routing_rules")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false) @map("email_verified")
  emailValid    Boolean  @default(true) @map("email_valid")
  avatarMediaId String?  @map("avatar_media_id")
  locale        String   @default("es")
  timezone      String?
  density       String   @default("comfortable") // UI preference
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  memberships             Membership[]
  messages                Message[]
  messageReactions        MessageReaction[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  notificationSettings    UserNotificationSettings?
  pushSubscriptions       PushSubscription[]
  auditLogs               AuditLog[]
  sessions                Session[]
  verificationTokens      VerificationToken[]
  invitationsSent         Invitation[]              @relation("InvitedBy")
  invitationsAccepted     Invitation[]              @relation("AcceptedBy")
  cookieConsents          CookieConsent[]

  @@map("users")
}

// Refresh-token rotation with family tracking (§7). One row per issued refresh token;
// a family is the chain started at login. Reuse of a consumed token revokes the family.
model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  familyId         String    @map("family_id")
  refreshTokenHash String    @unique @map("refresh_token_hash") // sha256; the raw token is never stored
  replacedById     String?   @unique @map("replaced_by_id")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  familyExpiresAt  DateTime  @map("family_expires_at") // The login ends here whatever the refreshes: the same value across the family
  consumedAt       DateTime? @map("consumed_at")
  graceUsedAt      DateTime? @map("grace_used_at") // The one time a consumed token came back inside the grace window
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy Session? @relation("SessionRotation", fields: [replacedById], references: [id])
  replaces   Session? @relation("SessionRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

// Magic-link login and DSR verification (TDD_07 §5.3, TDD_05 §10.2).
model VerificationToken {
  id        String    @id @default(uuid())
  type      String // VerificationTokenType
  tokenHash String    @unique @map("token_hash")
  userId    String?   @map("user_id")
  subject   String? // Email or DSR id when there is no user
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// A pending invitation is NOT a Membership: the invitee may not have a User yet.
// Membership rows are created only on acceptance (TDD_07 §5.3).
model Invitation {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  storeId        String    @map("store_id")
  email          String
  roleId         String    @map("role_id")
  tokenHash      String    @unique @map("token_hash")
  status         String    @default("PENDING") // InvitationStatus
  invitedById    String    @map("invited_by_id")
  acceptedById   String?   @map("accepted_by_id")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("AcceptedBy", fields: [acceptedById], references: [id])

  @@unique([storeId, email, status]) // One PENDING invitation per email per store (partial index in §5)
  @@index([storeId, status])
  @@map("invitations")
}

model Membership {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  organizationId String    @map("organization_id")
  storeId        String    @map("store_id")
  roleId         String    @map("role_id")
  status         String    @default("ACTIVE") // MembershipStatus
  invitationId   String?   @map("invitation_id")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, storeId])
  @@index([storeId, status])
  @@index([userId])
  @@index([organizationId, status])
  @@map("memberships")
}

// System presets have storeId = null and isSystem = true. Uniqueness of system role
// names is enforced by a partial unique index in §5 (NULLs are distinct in Postgres). A custom role's
// name is unique per store, case-insensitively, by the partial index uq_roles_store_name (raw SQL, on lower(name)).
model Role {
  id          String   @id @default(uuid())
  storeId     String?  @map("store_id")
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store       Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  permissions Permission[]
  memberships Membership[]
  invitations Invitation[]

  @@index([storeId])
  @@map("roles")
}

model Permission {
  id     String @id @default(uuid())
  name   String // Permission (TDD_02 §4)
  roleId String @map("role_id")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, name])
  @@map("permissions")
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id              String    @id @default(uuid())
  storeId         String    @map("store_id")
  name            String?
  email           String?
  phone           String? // As displayed
  phoneNormalized String?   @map("phone_normalized") // E.164 digits only, for search
  locale          String? // Detected from channel/messages, for customer-facing copy
  erasedAt        DateTime? @map("erased_at")
  mergedIntoId    String?   @map("merged_into_id") // Set when absorbed by a merge (row kept 30 days for unmerge)
  isCaution       Boolean   @default(false) @map("is_caution")
  cautionReason   String?   @map("caution_reason")
  cautionSetBy    String?   @map("caution_set_by")
  cautionSetAt    DateTime? @map("caution_set_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  identities    CustomerIdentity[]
  conversations Conversation[]
  orders        Order[]
  addresses     Address[]
  notes         CustomerNote[]
  consents      ConsentRecord[]
  tags          Tag[]              @relation("CustomerTags")
  media         Media[]

  @@index([storeId])
  @@index([storeId, phoneNormalized])
  @@index([storeId, email])
  @@index([storeId, mergedIntoId])
  @@map("customers")
}

// One row per (store, channel, handle). The SAME phone number in two stores is two
// rows — customers are always store-scoped (TDD_10 §5.2).
model CustomerIdentity {
  id                String    @id @default(uuid())
  storeId           String    @map("store_id")
  customerId        String    @map("customer_id")
  channelType       String    @map("channel_type") // ChannelType
  channelIdentity   String    @map("channel_identity") // phone (E.164), page-scoped id, visitor id, email
  displayName       String?   @map("display_name") // Profile name as reported by the channel
  channelMetadata   Json?     @map("channel_metadata")
  lastInboundAt     DateTime? @map("last_inbound_at") // Drives messaging windows (TDD_10 §4)
  // The first message after a click on an ad: the longer window of the providers that have one counts from it
  adWindowOpenedAt  DateTime? @map("ad_window_opened_at")
  // What the channel keeps for the person (where the provider has them), read by a job after the first message
  // and again once it is stale. The photo link expires and is not stored as a file yet.
  username          String?   @map("username")
  avatarUrl         String?   @map("avatar_url")
  profileFetchedAt  DateTime? @map("profile_fetched_at") // Set on a try that settled, even without a profile
  profileRetryAfter DateTime? @map("profile_retry_after") // After an outage that ate the attempts: not asked before this
  profileFetchError String?   @map("profile_fetch_error") // An ErrorCode of ours; null when the last settled try read a profile
  createdAt         DateTime  @default(now()) @map("created_at")

  store         Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  reactions     MessageReaction[]

  @@unique([storeId, channelType, channelIdentity])
  @@index([customerId])
  @@map("customer_identities")
}

model Address {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  label      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?  @map("postal_code")
  country    String   @default("SV")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  authorId   String   @map("author_id")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

// Snapshot that makes "Unmerge within 30 days" possible (TDD_09 §6.1).
model CustomerMerge {
  id           String    @id @default(uuid())
  storeId      String    @map("store_id")
  survivorId   String    @map("survivor_id")
  absorbedId   String    @map("absorbed_id")
  // { absorbed: Customer, identityIds, conversationIds, orderIds, addressIds, noteIds, tagIds, fieldChoices }
  snapshot     Json
  mergedById   String    @map("merged_by_id")
  mergedAt     DateTime  @default(now()) @map("merged_at")
  unmergeUntil DateTime  @map("unmerge_until")
  unmergedAt   DateTime? @map("unmerged_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, survivorId])
  @@index([unmergeUntil])
  @@map("customer_merges")
}

// ============================================================
// CONVERSATIONS & MESSAGES
// ============================================================

model Conversation {
  id                  String    @id @default(uuid())
  storeId             String    @map("store_id")
  customerId          String    @map("customer_id")
  customerIdentityId  String    @map("customer_identity_id") // Which handle the customer used
  channelConnectionId String    @map("channel_connection_id") // Which of our accounts received it → outbound route
  channelType         String    @map("channel_type") // ChannelType, denormalized for filters
  status              String    @default("OPEN") // ConversationStatus
  assignedTo          String?   @map("assigned_to")
  unreadCount         Int       @default(0) @map("unread_count") // Inbound messages not yet read by an agent
  lastReadAt          DateTime? @map("last_read_at")
  lastReadBy          String?   @map("last_read_by")
  lastMessageAt       DateTime? @map("last_message_at")
  lastInboundAt       DateTime? @map("last_inbound_at")
  lastOutboundAt      DateTime? @map("last_outbound_at")
  firstResponseAt     DateTime? @map("first_response_at") // First agent reply, for analytics
  resolvedAt          DateTime? @map("resolved_at")
  resolutionReason    String?   @map("resolution_reason")
  csatScore           Int?      @map("csat_score") // 1-5
  csatComment         String?   @map("csat_comment")
  archivedAt          DateTime? @map("archived_at")
  snoozedUntil        DateTime? @map("snoozed_until")
  snoozeNote          String?   @map("snooze_note") // What the agent said it waits for; AttentionReasons use it on waking
  attentionReason     String?   @map("attention_reason") // AttentionReason: a mark that raises the row in the list until it is opened
  attentionAt         DateTime? @map("attention_at")
  attentionNote       String?   @map("attention_note")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  store             Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer          Customer             @relation(fields: [customerId], references: [id])
  customerIdentity  CustomerIdentity     @relation(fields: [customerIdentityId], references: [id])
  channelConnection ChannelConnection    @relation(fields: [channelConnectionId], references: [id])
  messages          Message[]
  origins           ConversationOrigin[]
  tags              Tag[]                @relation("ConversationTags")

  @@index([storeId, status, assignedTo, lastMessageAt(sort: Desc)])
  @@index([storeId, lastMessageAt(sort: Desc)])
  @@index([storeId, channelType, status])
  @@index([storeId, customerId])
  @@index([customerIdentityId])
  @@index([snoozedUntil])
  @@index([status, resolvedAt]) // Auto-archive scheduler
  @@map("conversations")
}

model Message {
  id                      String    @id @default(uuid())
  storeId                 String    @map("store_id") // Denormalized: RLS, exports, retention
  conversationId          String    @map("conversation_id")
  type                    String // MessageType
  content                 String?
  authorType              String    @map("author_type") // AuthorType
  authorId                String?   @map("author_id") // User id for AGENT, null otherwise
  channelMessageId        String?   @map("channel_message_id") // Provider id; unique per conversation
  // Provider id of the message that carried the caption of a file (some providers send it apart): the echo of it is this message
  captionChannelMessageId String?   @map("caption_channel_message_id")
  // CaptionState of the text under a file that the channel sends as a message of its own; null otherwise
  captionState            String?   @map("caption_state")
  // The text of a media message (`content`) is its own message sent after every file, not the text under the first one (the channel carries a text under each file: `CAPTION_PER_FILE`); false for a message sent before, and where the channel puts the one text with the first file
  textApart               Boolean   @default(false) @map("text_apart")
  idempotencyKey          String?   @map("idempotency_key") // Client-generated for outbound (TDD_06 §4)
  replyToMessageId        String?   @map("reply_to_message_id")
  // The file of an album the reply quotes (an agent chose one file); null: the message, or its first file. Checked when written, no FK (like the id above)
  replyToMediaId          String?   @map("reply_to_media_id")
  deliveryStatus          String?   @map("delivery_status") // DeliveryStatus, outbound only
  deliveryError           String?   @map("delivery_error") // ErrorCode when FAILED
  // Set with a FAILED status: true when the failure means the provider did NOT take the message (a refusal, a
  // check that failed before sending), false when it may have (a timeout, an answer that made no sense), null
  // for a failure from before this was recorded. Only a reply known not to have gone can be discarded.
  failureDefinitive       Boolean?  @map("failure_definitive")
  resentAt                DateTime? @map("resent_at") // When an agent sent a failed reply again; the outbound sweep counts its age from here
  mentions                String[]  @default([]) // User ids mentioned in an internal note
  metadata                Json? // Channel-specific metadata
  createdAt               DateTime  @default(now()) @map("created_at")

  // Edits. `version` starts at 1 and grows with each edit of the text: an edit of a note carries the
  // one it saw. `pendingContent` is the text of an edit of ours that the channel has not taken yet: the
  // thread shows `content` until it does, and an edit the channel refuses never changes it.
  version        Int       @default(1)
  editedAt       DateTime? @map("edited_at")
  editedByType   String?   @map("edited_by_type") // AuthorType
  editedById     String?   @map("edited_by_id") // User id when an agent edited
  pendingContent String?   @map("pending_content")
  editStatus     String?   @map("edit_status") // DeliveryStatus of an edit toward the channel
  editError      String?   @map("edit_error") // ErrorCode of a failed one

  // Deletion. `deletedAt` is when the message stopped being shown; a deletion of ours that the channel
  // has not taken yet is `deleteStatus` queued with no `deletedAt`. The text stays until
  // `contentPurgedAt` (DeletedMessageRetention), read only with MESSAGES_VIEW_DELETED.
  deletedAt         DateTime? @map("deleted_at")
  deletedByType     String?   @map("deleted_by_type") // AuthorType
  deletedById       String?   @map("deleted_by_id") // User id when an agent deleted
  deleteStatus      String?   @map("delete_status") // DeliveryStatus of a deletion toward the channel
  deleteError       String?   @map("delete_error") // ErrorCode of a failed one
  // When the agent asked for the edit or the deletion that is queued; the sweep reads it to find a job that was lost
  changeRequestedAt DateTime? @map("change_requested_at")
  contentPurgedAt   DateTime? @map("content_purged_at")
  // A reply of the team that failed for good and that an agent threw away: it is not shown anywhere, and its
  // text goes with the retention of the deleted ones. It also has `deletedAt`, so every rule of the deleted
  // applies; this is what tells it from one that was deleted for the customer to see as a tombstone.
  discardedAt       DateTime? @map("discarded_at")

  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?               @relation(fields: [authorId], references: [id])
  media        Media[]
  origin       ConversationOrigin?
  reactions    MessageReaction[]
  revisions    MessageRevision[]

  @@unique([conversationId, channelMessageId])
  @@unique([conversationId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@index([conversationId, captionChannelMessageId])
  @@index([storeId, createdAt])
  @@index([deletedAt])
  @@map("messages")
}

// The text a message had before an edit, one row for each edit: who edited, when, and the text it
// replaced. Kept with the message; the text goes with a purge of a deleted message.
model MessageRevision {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  messageId    String   @map("message_id")
  version      Int // The version the text had
  content      String?
  editedByType String   @map("edited_by_type") // AuthorType
  editedById   String?  @map("edited_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, version])
  @@index([storeId])
  @@map("message_revisions")
}

// One emoji that one person left on a message. A person has at most one per message (a new emoji
// replaces the old one, taking it back deletes the row): the customer by identity, an agent by user, and
// the owner who reacts from the provider's own app, who is not a user of the platform, as one external
// reactor per message. The unique index of the external reactor and the check that each author type
// has its own id column live in the migration, which Prisma cannot express.
model MessageReaction {
  id                 String   @id @default(uuid())
  storeId            String   @map("store_id")
  messageId          String   @map("message_id")
  authorType         String   @map("author_type") // AuthorType: customer, agent or external
  customerIdentityId String?  @map("customer_identity_id")
  userId             String?  @map("user_id")
  // The file of an album the reaction is on (one provider message each); null: the message itself, or the first file
  // of a message whose files are not told apart. A person has one reaction for each target, so the unique indexes
  // are raw SQL on `coalesce(media_id, '')` (uq_message_reactions_customer, uq_message_reactions_user).
  mediaId            String?  @map("media_id")
  emoji              String
  // DeliveryStatus of an agent's reaction toward the channel: queued, sent or failed. The reactions the
  // channel reports (customer, external) are already there, so they are sent.
  deliveryStatus     String   @default("sent") @map("delivery_status")
  deliveryError      String?  @map("delivery_error") // ErrorCode of a failed one
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  message          Message           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  customerIdentity CustomerIdentity? @relation(fields: [customerIdentityId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  media            Media?            @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([messageId])
  @@index([mediaId])
  @@index([customerIdentityId])
  @@index([userId])
  @@map("message_reactions")
}

// Where a conversation came from (an ad, a post), read by the plugin from what its provider sent. One
// conversation can come from several ads, so the origin hangs from the message that carried it; the
// thread shows the latest and the first is the first contact.
model ConversationOrigin {
  id             String   @id @default(uuid())
  storeId        String   @map("store_id")
  conversationId String   @map("conversation_id")
  messageId      String   @unique @map("message_id")
  kind           String // OriginKind
  sourceId       String?  @map("source_id")
  sourceUrl      String?  @map("source_url")
  title          String?
  body           String?
  mediaType      String?  @map("media_type") // OriginMediaType
  mediaRef       String?  @map("media_ref") // Provider reference, fetched like any media
  mediaUrl       String?  @map("media_url")
  thumbnailUrl   String?  @map("thumbnail_url")
  clickId        String?  @map("click_id")
  // What the provider sent, untouched: the first real ad teaches what the columns missed
  referral       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // The picture and the thumbnail of the ad, fetched by the worker (purpose origin)
  files        Media[]

  @@index([conversationId, createdAt])
  @@index([storeId])
  @@map("conversation_origins")
}

model Tag {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  name        String
  color       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  conversations Conversation[] @relation("ConversationTags")
  customers     Customer[]     @relation("CustomerTags")

  // Also uq_tags_store_name_ci (store_id, lower(name)) in the raw SQL of 20261026140000: the name is
  // unique whatever its case, which the schema cannot say
  @@unique([storeId, name])
  @@map("tags")
}

model Snippet {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  shortcut  String
  title     String
  content   String
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shortcut])
  @@map("snippets")
}

// ============================================================
// ORDERS, PRODUCTS & INVENTORY
// ============================================================

model Order {
  id                         String    @id @default(uuid())
  storeId                    String    @map("store_id")
  customerId                 String    @map("customer_id")
  conversationId             String?   @map("conversation_id")
  orderNumber                String    @map("order_number")
  status                     String    @default("PENDING_CONFIRMATION") // OrderStatus
  subtotalCents              Int       @map("subtotal_cents")
  shippingCents              Int       @default(0) @map("shipping_cents")
  discountCents              Int       @default(0) @map("discount_cents")
  totalCents                 Int       @map("total_cents")
  currency                   String    @default("USD")
  paymentMethod              String    @map("payment_method") // PaymentMethod
  paymentStatus              String    @default("PENDING") @map("payment_status") // PaymentStatus
  paymentReference           String?   @map("payment_reference") // The transfer or deposit number of a payment recorded by hand (v1.2: no online payment)
  paymentProofMediaId        String?   @map("payment_proof_media_id") // The receipt, a file of purpose order; plain column like proofOfDeliveryMediaId
  shippingAddress            Json?     @map("shipping_address")
  customerNotes              String?   @map("customer_notes")
  internalNotes              String?   @map("internal_notes") // Customer-care note: members with a permission on the order only, never the customer, a channel, a plugin or the label
  packingNotes               String?   @map("packing_notes") // For whoever packs the order: same audience as internalNotes, and the warehouse is told when it changes on a confirmed order
  recipientPhones            String[]  @default([]) @map("recipient_phones") // National digits, no country code (the carriers take none); the first is the main number (TDD_02 §13)
  scheduledDeliveryDate      DateTime? @map("scheduled_delivery_date") @db.Date // A calendar day in the store timezone, no time of day (D18)
  trackingNumber             String?   @map("tracking_number")
  cancellationReason         String?   @map("cancellation_reason")
  cancelledBy                String?   @map("cancelled_by")
  proofOfDeliveryMediaId     String?   @map("proof_of_delivery_media_id")
  confirmedAt                DateTime? @map("confirmed_at")
  confirmedBy                String?   @map("confirmed_by")
  confirmedVia               String?   @map("confirmed_via") // OrderConfirmationChannel
  exchangeOfOrderId          String?   @map("exchange_of_order_id") // The order this one replaces
  copiedFromOrderId          String?   @map("copied_from_order_id") // The order it was copied from
  freeShipping               Boolean   @default(false) @map("free_shipping") // Derived and stored on save (TDD_17 §4.13)
  discountReason             String?   @map("discount_reason")
  priceApprovalStatus        String    @default("not_required") @map("price_approval_status") // PriceApprovalStatus
  priceApprovalRequestedBy   String?   @map("price_approval_requested_by")
  priceApprovedBy            String?   @map("price_approved_by")
  priceApprovedAt            DateTime? @map("price_approved_at")
  priceApprovedDiscountCents Int?      @map("price_approved_discount_cents")
  priceApprovedShippingCents Int?      @map("price_approved_shipping_cents")
  carrierConnectionId        String?   @map("carrier_connection_id") // The planned carrier (TDD_17 §4.13); composite foreign key with the store, Step 4.8 PR C1
  createdBy                  String    @map("created_by")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  shippedAt                  DateTime? @map("shipped_at")
  deliveredAt                DateTime? @map("delivered_at")
  cancelledAt                DateTime? @map("cancelled_at")

  store              Store                  @relation(fields: [storeId], references: [id]) // No cascade: tax retention
  carrierConnection  CarrierConnection?     @relation(fields: [storeId, carrierConnectionId], references: [storeId, id], onDelete: Restrict)
  customer           Customer               @relation(fields: [customerId], references: [id])
  items              OrderItem[]
  media              Media[]
  // The shipping tables of Step 4.8 point at the order with a plain foreign key (an order has no (store_id, id) key)
  shipments          Shipment[]
  messageDispatches  OrderMessageDispatch[]
  returns            OrderReturn[]          @relation("ReturnOrder")
  replacementReturns OrderReturn[]          @relation("ReturnReplacement")

  @@unique([storeId, orderNumber])
  // The key the records that hang from an order point at, so that the database refuses one of another store
  @@unique([storeId, id])
  @@index([storeId, status, createdAt(sort: Desc)])
  @@index([storeId, carrierConnectionId])
  @@index([storeId, customerId])
  @@index([storeId, scheduledDeliveryDate])
  @@index([conversationId])
  @@map("orders")
}

model OrderItem {
  id                     String  @id @default(uuid())
  orderId                String  @map("order_id")
  productId              String  @map("product_id")
  variantId              String? @map("variant_id")
  productName            String  @map("product_name") // Denormalized snapshot at time of order
  variantName            String? @map("variant_name")
  quantity               Int
  unitPriceCents         Int     @map("unit_price_cents") // Snapshot; never trusted from the client
  originalUnitPriceCents Int?    @map("original_unit_price_cents") // Null unless the price was overridden
  priceOverrideReason    String? @map("price_override_reason")
  priceOverriddenBy      String? @map("price_overridden_by")
  freeShipping           Boolean @default(false) @map("free_shipping") // Snapshot of Product.freeShipping at order time

  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product               @relation(fields: [productId], references: [id])
  variant     ProductVariant?       @relation(fields: [variantId], references: [id])
  allocations OrderItemAllocation[]
  returnLines OrderReturnLine[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model Product {
  id                String   @id @default(uuid())
  storeId           String   @map("store_id")
  name              String
  description       String?
  priceCents        Int      @map("price_cents")
  costCents         Int?     @map("cost_cents") // Reference cost per unit in USD cents; the cost of a unit in stock is the one of its movements (Step 4.2)
  sku               String?
  imageMediaId      String?  @map("image_media_id")
  trackInventory    Boolean  @default(true) @map("track_inventory")
  lowStockThreshold Int?     @map("low_stock_threshold") // Null = no low-stock alert (TDD_16 §4.4)
  active            Boolean  @default(true)
  freeShipping      Boolean  @default(false) @map("free_shipping") // The price already includes shipping (TDD_17 §4.13)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants        ProductVariant[]
  inventory       InventoryMovement[]
  inventoryLevels InventoryLevel[]
  stockCountLines StockCountLine[]
  transferLines   StockTransferLine[]
  orderItems      OrderItem[]
  media           Media[]

  @@unique([storeId, sku])
  // So that the stock of a product can name its store and the database check that they go together
  @@unique([storeId, id])
  @@index([storeId, active])
  @@map("products")
}

// "Size 42", "Red / L". A product without variants sells the product row itself.
model ProductVariant {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  name       String // Display: "42", "Rojo / L"
  sku        String?
  priceCents Int?     @map("price_cents") // Null = inherits Product.priceCents
  costCents  Int?     @map("cost_cents") // Null = inherits Product.costCents
  attributes Json // { size: "42", color: "red" }
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory       InventoryMovement[]
  inventoryLevels InventoryLevel[]
  stockCountLines StockCountLine[]
  transferLines   StockTransferLine[]
  orderItems      OrderItem[]

  @@unique([productId, name])
  @@unique([productId, sku])
  @@index([productId, active])
  @@map("product_variants")
}

// The ledger of stock (TDD_16 §2): append-only, the audit trail of InventoryLevel and the source of reconciliation.
// `quantity` is always positive and `type` carries the direction. The database refuses UPDATE and DELETE on it to
// the application roles, and a store with stock cannot be deleted (TDD_16 §4.9: the foreign keys restrict it).
model InventoryMovement {
  id             String   @id @default(uuid())
  // The order in which the ledger was written: the kardex reads by it, because every movement of a transaction has
  // the same created_at (the database default is the start of the transaction) and ids are random
  seq            BigInt   @unique @default(autoincrement())
  storeId        String   @map("store_id")
  productId      String   @map("product_id")
  variantId      String?  @map("variant_id")
  warehouseId    String   @map("warehouse_id")
  type           String // InventoryMovementType
  quantity       Int
  reason         String? // InventoryAdjustmentReason, set for the manual types
  note           String?
  referenceType  String?  @map("reference_type") // InventoryReferenceType
  referenceId    String?  @map("reference_id")
  idempotencyKey String   @map("idempotency_key")
  // The cost of ONE unit, in whole USD cents, for the movements that bring units in (receipts, opening stock,
  // returns); null for the rest (a reserve has no cost) and for units whose cost is not known. The weighted-average
  // cost of a level is kept from these (InventoryLevel.valueCents), and FIFO lots can later be built from the receipts
  // without changing this table.
  unitCostCents  Int?     @map("unit_cost_cents")
  onHandAfter    Int      @map("on_hand_after")
  reservedAfter  Int      @map("reserved_after")
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  store     Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product   Product         @relation(fields: [storeId, productId], references: [storeId, id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])

  // The key is the caller's, so it is unique inside a store: tenants never share a namespace
  @@unique([storeId, idempotencyKey])
  @@index([productId, variantId, type, createdAt(sort: Desc)])
  @@index([storeId, warehouseId, createdAt(sort: Desc)])
  // The kardex and the reconciliation of one item in one warehouse, in the order of the ledger
  @@index([storeId, productId, warehouseId, variantId, seq(sort: Desc)])
  @@index([warehouseId])
  @@index([variantId])
  @@map("inventory_movements")
}

// A place where stock is kept. It belongs to the ORGANIZATION and can supply several of its stores (TDD_16 §1).
// The transfers that refer to it (StockTransfer) arrive with Step 4.5; its counts (StockCount) are below.
// The transfers that refer to it are StockTransfer (Step 4.5); the counts (StockCount) arrive with Step 4.6.
model Warehouse {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String // Short, printed on documents. Unique per organization
  address        Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stores       StoreWarehouse[]
  levels       InventoryLevel[]
  movements    InventoryMovement[]
  allocations  OrderItemAllocation[]
  counts       StockCount[]
  transfersOut StockTransfer[]       @relation("TransferFrom")
  transfersIn  StockTransfer[]       @relation("TransferTo")
  shipments    Shipment[]
  returnLines  OrderReturnLine[]

  @@unique([organizationId, code])
  // So that a link can name its organization and the database check that they go together (StoreWarehouse)
  @@unique([organizationId, id])
  @@map("warehouses")
}

// Which warehouses a store sells from; priority 1 is reserved first (TDD_16 §4.1). Both foreign keys carry the
// organization, so the database itself refuses to link a store to a warehouse of another organization.
model StoreWarehouse {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  storeId        String @map("store_id")
  warehouseId    String @map("warehouse_id")
  priority       Int

  store     Store     @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Cascade)

  @@unique([storeId, warehouseId])
  // One warehouse per priority of a store: (store_id, priority) is a DEFERRABLE unique constraint in the raw SQL of the
  // migration, so that the priorities can be swapped or shifted inside one transaction (Prisma cannot declare it)
  @@index([warehouseId])
  @@map("store_warehouses")
}

// The current stock of one item in one warehouse; variantId is null for a product without variants. Reads use this
// table and the ledger above is the trail; both change in ONE transaction (TDD_16 §4.2).
model InventoryLevel {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  productId   String   @map("product_id")
  variantId   String?  @map("variant_id")
  warehouseId String   @map("warehouse_id")
  onHand      Int      @default(0) @map("on_hand")
  reserved    Int      @default(0)
  // What the units on hand are worth at their cost, in USD cents (weighted-average costing: the average cost is
  // this divided by onHand). BigInt because a big stock of a dear item does not fit in 32 bits of cents.
  valueCents  BigInt   @default(0) @map("value_cents")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store     Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product   Product         @relation(fields: [storeId, productId], references: [storeId, id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])

  @@index([storeId, warehouseId])
  @@index([productId, variantId])
  @@index([warehouseId])
  @@index([variantId])
  @@map("inventory_levels")
}

// Which warehouse serves how many units of an order line; with split fulfillment (TDD_16 §4.1) a line can have
// several. The quantities of a line's allocations add up to OrderItem.quantity (checked by InventoryService).
model OrderItemAllocation {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  orderItemId String   @map("order_item_id")
  warehouseId String   @map("warehouse_id")
  quantity    Int
  createdAt   DateTime @default(now()) @map("created_at")

  store     Store     @relation(fields: [storeId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([orderItemId, warehouseId])
  @@index([storeId])
  @@index([warehouseId])
  @@map("order_item_allocations")
}

// A physical count of one warehouse (TDD_16 §4.6). The header belongs to the ORGANIZATION; its lines to the store of the
// product they count. `storeId` limits the count to the products of one store (null: every store that keeps stock
// there); its foreign key (organization_id, store_id) is declared in the raw SQL of the migration, because Prisma cannot
// declare a composite relation with an optional column.
model StockCount {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  warehouseId    String    @map("warehouse_id")
  number         String // "CT-0001", unique inside the organization
  status         String    @default("draft") // CountStatus
  storeId        String?   @map("store_id")
  note           String?
  createdBy      String    @map("created_by")
  startedAt      DateTime? @map("started_at")
  submittedAt    DateTime? @map("submitted_at")
  appliedBy      String?   @map("applied_by")
  appliedAt      DateTime? @map("applied_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse        @relation(fields: [organizationId, warehouseId], references: [organizationId, id])
  lines        StockCountLine[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, warehouseId])
  @@index([organizationId, storeId])
  @@map("stock_counts")
}

// One item of a count. `expectedQuantity` is the on-hand snapshot taken when the count started; applying the count
// moves stock by `countedQuantity - expectedQuantity`, never by "counted minus what is there now".
model StockCountLine {
  id               String  @id @default(uuid())
  countId          String  @map("count_id")
  storeId          String  @map("store_id")
  productId        String  @map("product_id")
  variantId        String? @map("variant_id")
  expectedQuantity Int     @map("expected_quantity")
  countedQuantity  Int?    @map("counted_quantity")

  count   StockCount      @relation(fields: [countId], references: [id], onDelete: Cascade)
  store   Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product Product         @relation(fields: [storeId, productId], references: [storeId, id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([countId, storeId])
  @@index([storeId])
  @@index([storeId, productId, variantId])
  @@index([variantId])
  @@map("stock_count_lines")
}

// A shipment of stock from one warehouse to another of the same ORGANIZATION (TDD_16 §4.5). The header belongs to the
// organization; its lines belong to the stores whose products travel. The status only moves through the transfers
// service, which writes the stock through InventoryService and never touches a level itself.
model StockTransfer {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  number          String // "TR-0001", per organization
  fromWarehouseId String    @map("from_warehouse_id")
  toWarehouseId   String    @map("to_warehouse_id")
  status          String    @default("draft") // TransferStatus
  note            String?
  createdBy       String    @map("created_by")
  dispatchedBy    String?   @map("dispatched_by")
  dispatchedAt    DateTime? @map("dispatched_at")
  closedAt        DateTime? @map("closed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Both warehouses carry the organization, so the database refuses a transfer that reaches another organization's
  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse           @relation("TransferFrom", fields: [organizationId, fromWarehouseId], references: [organizationId, id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [organizationId, toWarehouseId], references: [organizationId, id])
  lines         StockTransferLine[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@map("stock_transfers")
}

// One item that travels: `quantity` is what was (or will be) dispatched, `receivedQuantity` what has arrived. The
// STORE is the one of the product: a user sees the lines of the stores they belong to (TDD_16 §1).
model StockTransferLine {
  id               String  @id @default(uuid())
  transferId       String  @map("transfer_id")
  storeId          String  @map("store_id")
  productId        String  @map("product_id")
  variantId        String? @map("variant_id")
  quantity         Int
  receivedQuantity Int     @default(0) @map("received_quantity")
  shortageAction   String? @map("shortage_action") // TransferShortageAction, set on close

  transfer StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  store    Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product  Product         @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Restrict)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // One line per item: the unique indexes of the raw SQL (a null variant is not a value to a unique index)
  @@index([transferId])
  @@index([storeId])
  @@index([productId, variantId])
  @@index([variantId])
  @@map("stock_transfer_lines")
}

// ============================================================
// MEDIA
// ============================================================

model Media {
  id               String    @id @default(uuid())
  storeId          String?   @map("store_id") // Null only for user avatars
  purpose          String // MediaPurpose: message | origin | product | order | avatar | export
  messageId        String?   @map("message_id")
  originSlot       String?   @map("origin_slot") // OriginMediaSlot: which picture of the ad this is
  originId         String?   @map("origin_id") // Set for the picture of an ad (purpose origin), never for the gallery
  customerId       String?   @map("customer_id") // Set for message media: gallery queries
  productId        String?   @map("product_id")
  orderId          String?   @map("order_id")
  uploadedBy       String?   @map("uploaded_by") // User id; null for inbound channel media
  key              String    @unique // S3 object key, built by storage-keys.ts
  filename         String
  contentType      String    @map("content_type")
  fileSize         Int       @map("file_size")
  // { full: key, medium: key, thumb: key } — KEYS, signed at read time (TDD_07 §6.6)
  variants         Json?
  status           String    @default("pending") // MediaStatus
  scanResult       Json?     @map("scan_result") // { viruses: string[] } when infected; { reason } when refused; { sanitized: true } once a pending picture was cleaned of its metadata
  processedAt      DateTime? @map("processed_at")
  scannedAt        DateTime? @map("scanned_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  // The files an agent sends in one message: their order and the state of each toward the channel. Null for
  // an inbound file, a gallery file and any file sent before several were allowed (the message's state is theirs).
  position         Int?      @map("position")
  deliveryStatus   String?   @map("delivery_status") // DeliveryStatus: queued | sent | failed (the receipts of the provider move it on)
  channelMessageId String?   @map("channel_message_id") // Provider id of the message that carried this file
  sendErrorCode    String?   @map("send_error_code") // ErrorCode when its delivery failed
  sentAt           DateTime? @map("sent_at")
  // The text the agent put under this file (null: none, or a file sent before each had its own, when the text
  // of the message was the one of the first). How the text of the message went is on the message.
  caption          String?   @map("caption")

  store     Store?              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  message   Message?            @relation(fields: [messageId], references: [id], onDelete: SetNull)
  origin    ConversationOrigin? @relation(fields: [originId], references: [id], onDelete: Cascade)
  customer  Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product   Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  order     Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reactions MessageReaction[]

  @@index([storeId, createdAt])
  @@index([storeId, customerId, createdAt(sort: Desc)])
  @@index([messageId])
  @@index([originId])
  @@index([status, createdAt])
  @@index([storeId, channelMessageId])
  @@index([productId, storeId])
  @@map("media")
}

// ============================================================
// CHANNELS, PLUGINS & WEBHOOKS
// ============================================================

// One row per (store, plugin, account). connectionId is what the provider sends as the
// RECIPIENT of an inbound webhook (a phone number id, a Page id, an
// account id, widget site key, inbound mailbox address). It is unique per plugin
// platform-wide — a phone number belongs to exactly one store — which is how the inbound
// pipeline resolves the store (TDD_10 §4).
model ChannelConnection {
  id             String    @id @default(uuid())
  storeId        String    @map("store_id")
  pluginId       String    @map("plugin_id") // ChannelType / plugin id
  connectionId   String    @map("connection_id")
  displayName    String    @map("display_name") // "+503 2222-3333", "Mi Empresa (Page)"
  // The name the owner gave to this connection ("Main account"); null while it has none, and then the
  // name of the account (`displayName`) is shown. A connect, a reconnect or a new token never write it.
  label          String?
  status         String    @default("active") // ChannelConnectionStatus
  credentials    Bytes // AES-256-GCM ciphertext (libs/core/crypto)
  metadata       Json?
  lastHealthyAt  DateTime? @map("last_healthy_at")
  lastError      String?   @map("last_error")
  // The installation of the plugin in this store (D19): a connection is the configuration of an
  // installed plugin, and uninstalling it disconnects every one that hangs from it
  installationId String    @map("installation_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  installation  PluginInstallation @relation(fields: [installationId], references: [id], onDelete: Restrict)
  conversations Conversation[]

  @@unique([pluginId, connectionId])
  @@index([storeId, status])
  @@index([installationId])
  @@map("channel_connections")
}

// The catalog entry — one row per plugin, independent of how many stores installed it. The official
// plugins are written here from the code registry at boot (isOfficial true); the owner registers
// the private ones (isOfficial false, pricingModel 'free', status 'approved'). D19.
model Plugin {
  // The manifest's own declared id (TDD_10 §6.1, e.g. "telegram-connector", or a built-in id
  // for an official channel) — not a generated uuid, so it matches PluginInstallation.pluginId
  // and the in-memory registry key exactly.
  id                          String   @id
  name                        String
  authorName                  String   @map("author_name")
  authorEmail                 String   @map("author_email")
  type                        String // 'channel' | 'integration'
  isOfficial                  Boolean  @default(false) @map("is_official")
  manifest                    Json // Full manifest JSON, TDD_10 §6.1
  pricingModel                String   @map("pricing_model") // PluginPricingModels
  priceCents                  Int?     @map("price_cents") // pricingModel = 'paid' only
  platformRevenueSharePercent Int?     @default(20) @map("platform_revenue_share_percent")
  status                      String   @default("submitted") // PluginStatus
  reviewNotes                 String?  @map("review_notes")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  installations PluginInstallation[]

  @@index([status])
  @@map("plugins")
}

model PluginInstallation {
  id                 String    @id @default(uuid())
  storeId            String    @map("store_id")
  pluginId           String    @map("plugin_id")
  scopes             String[] // PluginScope[]
  status             String    @default("pending_setup") // PluginInstallationStatus
  // The scoped key of a plugin that calls the platform: null for an official channel, which runs
  // inside it and has none
  apiKeyPrefix       String?   @map("api_key_prefix") // First 12 chars, shown in UI
  apiKeyHash         String?   @unique @map("api_key_hash") // sha256 of the full key
  rateLimitPerMinute Int       @default(60) @map("rate_limit_per_minute") // From manifest.limits
  config             Json?
  installedBy        String    @map("installed_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  revokedAt          DateTime? @map("revoked_at")

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plugin             Plugin              @relation(fields: [pluginId], references: [id], onDelete: Restrict)
  channelConnections ChannelConnection[]

  @@unique([storeId, pluginId])
  @@index([storeId, status])
  @@map("plugin_installations")
}

// Tenant-created outbound webhooks (Settings → Webhooks).
model Webhook {
  id                  String    @id @default(uuid())
  storeId             String    @map("store_id")
  url                 String
  events              String[] // EventName[]
  secret              Bytes // Encrypted HMAC secret
  status              String    @default("active") // WebhookStatus
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastFailureAt       DateTime? @map("last_failure_at")
  createdBy           String    @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([storeId, status])
  @@map("webhooks")
}

model WebhookDelivery {
  id         String   @id @default(uuid())
  webhookId  String   @map("webhook_id")
  event      String
  statusCode Int?     @map("status_code")
  durationMs Int      @map("duration_ms")
  success    Boolean
  error      String?
  attempt    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt(sort: Desc)])
  @@index([createdAt]) // 30-day cleanup
  @@map("webhook_deliveries")
}

// Idempotency for inbound provider webhooks (Resend). Channel webhooks dedupe on
// Message.channelMessageId instead.
model ProcessedWebhookEvent {
  source      String // 'resend'
  eventId     String   @map("event_id")
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([source, eventId])
  @@index([processedAt])
  @@map("processed_webhook_events")
}

// Tenant API keys (Settings → API keys) for the public REST API. Distinct from plugin keys.
model ApiKey {
  id         String    @id @default(uuid())
  storeId    String    @map("store_id")
  name       String
  keyPrefix  String    @map("key_prefix") // "pk_live_ab12…" shown in UI
  keyHash    String    @unique @map("key_hash")
  scopes     String[] // Permission[] subset
  status     String    @default("active") // ApiKeyStatus
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@map("api_keys")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

// Persisted as an i18n key + params (TDD_02 §12). Rendered at display time in the
// recipient's locale; emails render server-side.
model Notification {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  storeId        String    @map("store_id")
  type           String // NotificationType
  severity       String // NotificationSeverity
  messageKey     String    @map("message_key") // e.g. "notifications.conversation.assigned"
  params         Json      @default("{}") // { customerName, conversationId, … }
  resourceType   String?   @map("resource_type")
  resourceId     String?   @map("resource_id")
  actionPath     String?   @map("action_path") // App-relative path, built from AppPaths
  readAt         DateTime? @map("read_at")
  // Set when the person asked for this one by email: the digest sends the rows that have it and clears it.
  // Its partial index (ix_notifications_email_pending) is raw SQL in a migration, Prisma cannot express it
  emailPendingAt DateTime? @map("email_pending_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([userId, storeId, createdAt(sort: Desc)])
  @@index([storeId, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  id      String  @id @default(uuid())
  userId  String  @map("user_id")
  storeId String  @map("store_id")
  type    String // NotificationType
  inApp   Boolean @default(true) @map("in_app")
  push    Boolean @default(true)
  email   Boolean @default(false)
  sound   Boolean @default(true)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId, type])
  @@map("notification_preferences")
}

// User-level (not per store) notification behaviour: quiet hours, digest, cross-store.
model UserNotificationSettings {
  userId                   String    @id @map("user_id")
  quietHoursEnabled        Boolean   @default(false) @map("quiet_hours_enabled")
  quietHoursStart          Int       @default(22) @map("quiet_hours_start") // 0-23, in `timezone`
  quietHoursEnd            Int       @default(7) @map("quiet_hours_end")
  quietHoursFollowStore    Boolean   @default(false) @map("quiet_hours_follow_store")
  timezone                 String    @default("America/El_Salvador")
  digestFrequency          String    @default("hourly") @map("digest_frequency") // DigestFrequency
  crossStoreEnabled        Boolean   @default(true) @map("cross_store_enabled")
  crossStoreSupervisorOnly Boolean   @default(false) @map("cross_store_supervisor_only")
  lastDigestSentAt         DateTime? @map("last_digest_sent_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_settings")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  lastUsed  DateTime @default(now()) @map("last_used")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================================
// ANALYTICS & EXPORTS
// ============================================================

model AnalyticsEvent {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  event     String // AnalyticsEventNames (TDD_11 §7.1)
  data      Json
  date      DateTime @db.Date
  timestamp DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, event, date])
  @@index([date])
  @@map("analytics_events")
}

// dimension/dimensionId default to '' (never NULL) so the unique constraint works with upsert.
model MetricHourly {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  hour        DateTime
  metric      String
  dimension   String   @default("")
  dimensionId String   @default("") @map("dimension_id")
  value       Decimal  @db.Decimal(18, 4)
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, hour, metric, dimension, dimensionId])
  @@index([storeId, metric, hour])
  @@map("metrics_hourly")
}

model MetricDaily {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  date        DateTime @db.Date
  metric      String
  dimension   String   @default("")
  dimensionId String   @default("") @map("dimension_id")
  value       Decimal  @db.Decimal(18, 4)
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date, metric, dimension, dimensionId])
  @@index([storeId, metric, date])
  @@map("metrics_daily")
}

model ScheduledReport {
  id         String    @id @default(uuid())
  storeId    String    @map("store_id")
  name       String
  metrics    String[]
  frequency  String // ReportFrequency
  format     String // ReportFormats
  recipients String[]
  filters    Json?
  timezone   String    @default("America/El_Salvador")
  sendAtHour Int       @default(8) @map("send_at_hour")
  enabled    Boolean   @default(true)
  lastSentAt DateTime? @map("last_sent_at")
  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([enabled, frequency])
  @@map("scheduled_reports")
}

// Generated exports (CSV/Excel/ZIP/PDF) — the record behind ApiRoutes.exports and the
// EXPORT_READY notification (TDD_07 §7).
model Export {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  requestedBy String    @map("requested_by")
  type        String // ExportTypes (TDD_07 §1.3)
  format      String
  filters     Json?
  status      String    @default("pending") // ExportStatus: pending | ready | failed | expired
  key         String? // S3 key when ready
  rowCount    Int?      @map("row_count")
  // How much of the file is written, 0 to 100, while the status is pending; null until the worker has counted
  progress    Int?
  error       String?
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("exports")
}

// ============================================================
// COMPLIANCE & AUDIT
// ============================================================

model AuditLog {
  id             String   @id @default(uuid())
  action         String // AuditActionType
  // Null for system actions (workers, webhooks)
  userId         String?  @map("user_id")
  storeId        String?  @map("store_id")
  // Org-level actions have no single store.
  organizationId String?  @map("organization_id")
  resourceType   String?  @map("resource_type")
  resourceId     String?  @map("resource_id")
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  timestamp      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, timestamp(sort: Desc)])
  @@index([storeId, timestamp(sort: Desc)])
  @@index([organizationId, timestamp(sort: Desc)])
  @@index([action, timestamp(sort: Desc)])
  @@index([timestamp]) // Cold export / purge
  @@map("audit_logs")
}

model DataSubjectRequest {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  storeId                String?   @map("store_id")
  type                   String // DsrType
  status                 String    @default("pending_verification") // DsrStatus
  subjectType            String    @map("subject_type") // 'customer' | 'user'
  subjectId              String?   @map("subject_id")
  subjectEmail           String?   @map("subject_email")
  subjectPhone           String?   @map("subject_phone")
  requestedBy            String?   @map("requested_by")
  requestedAt            DateTime  @default(now()) @map("requested_at")
  deadlineAt             DateTime  @map("deadline_at")
  deadlineAlertSentAt    DateTime? @map("deadline_alert_sent_at")
  verifiedAt             DateTime? @map("verified_at")
  completedAt            DateTime? @map("completed_at")
  resultKey              String?   @map("result_key")
  resultExpiresAt        DateTime? @map("result_expires_at")
  rejectionReason        String?   @map("rejection_reason")
  retainedRecordsSummary Json?     @map("retained_records_summary") // What was kept and under which legal basis
  notes                  String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@index([deadlineAt, status])
  @@index([subjectEmail])
  @@map("data_subject_requests")
}

model ConsentRecord {
  id         String    @id @default(uuid())
  storeId    String    @map("store_id")
  customerId String    @map("customer_id")
  purpose    String
  legalBasis String    @map("legal_basis") // LegalBases
  granted    Boolean
  grantedAt  DateTime? @map("granted_at")
  revokedAt  DateTime? @map("revoked_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  source     String
  createdAt  DateTime  @default(now()) @map("created_at")

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose])
  @@index([storeId, purpose, granted])
  @@map("consent_records")
}

// Cookie consent for platform users and anonymous visitors (TDD_05 §10.5).
model CookieConsent {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  visitorId     String   @map("visitor_id")
  categories    Json // { functional: true, analytics: false, marketing: false }
  policyVersion String   @map("policy_version")
  ipHash        String?  @map("ip_hash")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visitorId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("cookie_consents")
}

model RetentionSettings {
  storeId          String   @id @map("store_id")
  conversationDays Int      @default(730) @map("conversation_days")
  mediaDays        Int      @default(365) @map("media_days")
  analyticsDays    Int      @default(395) @map("analytics_days")
  notificationDays Int      @default(90) @map("notification_days")
  updatedAt        DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("retention_settings")
}

// ============================================================
// SHIPPING (TDD_17 §2, §4.17; Step 4.8, PR B1). Schema only: no service reads or writes these tables yet.
// Every table carries its store_id. A relation to another table of the same store names the store as well
// (fields [storeId, x] -> references [storeId, id]), so the database refuses a link to another store's row.
// Order, OrderItem and Warehouse have no (store_id, id) key to point at, so those links are plain foreign keys
// and the migration adds triggers that check the store (or the organization of the store) of the row they reach.
// The reception tables are Step 4.12, the remittance tables Step 4.13, and Order.carrierConnectionId stays a
// plain column until its foreign key in Step 4.8 PR C1.
// ============================================================

// A store's account with a carrier (or the 'local' courier). Credentials and webhook secret are ciphertext.
model CarrierConnection {
  id                      String    @id @default(uuid())
  storeId                 String    @map("store_id")
  carrierId               String    @map("carrier_id") // CarrierId: 'forza' | 'c807' | 'local' | a private plugin's id
  displayName             String    @map("display_name")
  status                  String    @default("active") // CarrierConnectionStatus
  credentials             Bytes? // Ciphertext; null for 'local'
  webhookSecret           Bytes?    @map("webhook_secret") // Ciphertext; the secret of this connection's inbound webhook
  defaultServiceCode      String?   @map("default_service_code") // A CarrierService.code of this connection
  defaultShippingPayer    String    @default("sender") @map("default_shipping_payer") // ShippingPayer
  labelFormat             String    @default("pdf_100x150") @map("label_format") // LabelFormat
  contact                 Json? // 'local' only: { phone, notes }
  pickupEnabled           Boolean   @default(false) @map("pickup_enabled")
  pickupDays              Int[]     @default([1, 2, 3, 4, 5]) @map("pickup_days") // ISO weekdays, 1 = Monday
  pickupCutoffTime        String?   @map("pickup_cutoff_time") // 'HH:mm' in the store timezone
  autoPickup              Boolean   @default(false) @map("auto_pickup")
  autoPickupTime          String?   @map("auto_pickup_time") // 'HH:mm' in the store timezone
  pickupReminderMinutes   Int       @default(30) @map("pickup_reminder_minutes")
  pollIntervalMinutes     Int?      @map("poll_interval_minutes") // Null = the plugin default; only for carriers polled instead of pushing
  maxDeliveryAttempts     Int       @default(3) @map("max_delivery_attempts") // Attempts the carrier makes before returning the package; the {{maxAttempts}} of a message
  defaultShippingFeeCents Int?      @map("default_shipping_fee_cents") // The fee charged to the customer: the preset and the accepted range (TDD_17 §4.13)
  minShippingFeeCents     Int?      @map("min_shipping_fee_cents")
  maxShippingFeeCents     Int?      @map("max_shipping_fee_cents")
  remittanceDeductsFee    Boolean   @default(false) @map("remittance_deducts_fee") // The carrier subtracts its fee from what it remits when the sender pays (§4.15)
  lastHealthyAt           DateTime? @map("last_healthy_at")
  lastError               String?   @map("last_error")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  store            Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  services         CarrierService[]
  guideSequence    GuideSequence?
  shipments        Shipment[]
  plannedOrders    Order[]
  pickups          PickupRequest[]
  statusMappings   CarrierStatusMapping[]
  unmappedStatuses CarrierUnmappedStatus[]
  remittances      CodRemittance[]

  @@unique([storeId, displayName])
  // So that what hangs from a connection can name its store and the database check that they go together
  @@unique([storeId, id])
  @@index([storeId, status])
  @@map("carrier_connections")
}

// The service types a carrier offers (next day, express, ...). The code is what the carrier's API expects; the label
// is what the owner sees. Seeded from the plugin's serviceCatalog() when the connection is created.
model CarrierService {
  id           String  @id @default(uuid())
  storeId      String  @map("store_id")
  connectionId String  @map("connection_id")
  code         String // Carrier-specific, sent in the API call
  label        String
  active       Boolean @default(true)

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection CarrierConnection @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Cascade)

  @@unique([connectionId, code])
  @@index([storeId])
  @@map("carrier_services")
}

// Guide numbers of the 'local' carrier. One row per connection, advanced with
// UPDATE ... SET next_value = next_value + 1 RETURNING in the same transaction as the Shipment.
model GuideSequence {
  connectionId String @id @map("connection_id")
  storeId      String @map("store_id")
  prefix       String // Printed in front of the number, e.g. 'JM'
  nextValue    Int    @default(1) @map("next_value")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection CarrierConnection @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Cascade)

  // The primary key already makes the connection unique; this is the key the composite relation to it needs
  @@unique([storeId, connectionId])
  @@index([storeId])
  @@map("guide_sequences")
}

// One guide of one order from one warehouse. Its contents are the order's allocations from that warehouse
// (TDD_16 §4.1): there is no shipment-lines table. The status is written only by ShippingService (lint rule).
model Shipment {
  id                 String    @id @default(uuid())
  storeId            String    @map("store_id")
  orderId            String    @map("order_id")
  connectionId       String    @map("connection_id")
  kind               String    @default("outbound") // ShipmentKind
  returnId           String?   @map("return_id") // Set when kind = return
  originWarehouseId  String?   @map("origin_warehouse_id") // The warehouse the goods leave from (§4.5); of a return guide, the one they go to
  status             String    @default("creating") // ShipmentStatus
  serviceCode        String    @map("service_code")
  shippingPayer      String    @map("shipping_payer") // ShippingPayer
  codAmountCents     Int?      @map("cod_amount_cents") // Null = prepaid
  codStatus          String    @default("not_applicable") @map("cod_status") // CodStatus
  codExpectedCents   Int?      @map("cod_expected_cents") // Written when the shipment is delivered (§4.15)
  codRemittedCents   Int?      @map("cod_remitted_cents")
  codRemittanceId    String?   @map("cod_remittance_id") // The confirmed remittance that settled it (Step 4.13)
  deliveredAt        DateTime? @map("delivered_at") // When the carrier delivered it: the age of what it owes (§4.15)
  currency           String
  packageCount       Int       @default(1) @map("package_count")
  failedAttempts     Int       @default(0) @map("failed_attempts") // Delivery attempts that failed (§4.9)
  weightGrams        Int?      @map("weight_grams")
  guideNumber        String?   @map("guide_number") // The carrier's guide, or ours for 'local'
  providerShipmentId String?   @map("provider_shipment_id") // The carrier's internal id, when it has one
  trackingUrl        String?   @map("tracking_url")
  labelMediaId       String?   @map("label_media_id") // Media purpose SHIPPING_LABEL; plain column like the other media ids
  carrierCostCents   Int?      @map("carrier_cost_cents") // When the carrier reports it
  refundStatus       String    @default("not_applicable") @map("refund_status") // GuideRefundStatus
  idempotencyKey     String    @map("idempotency_key") // Unique per store (@@unique below)
  pickupId           String?   @map("pickup_id")
  lastError          String?   @map("last_error")
  cancelRequestedAt  DateTime? @map("cancel_requested_at")
  cancelledAt        DateTime? @map("cancelled_at")
  createdBy          String    @map("created_by") // A user id or 'system'
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  store           Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  connection      CarrierConnection   @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Restrict)
  pickup          PickupRequest?      @relation(fields: [storeId, pickupId], references: [storeId, id], onDelete: Restrict)
  originWarehouse Warehouse?          @relation(fields: [originWarehouseId], references: [id], onDelete: Restrict)
  orderReturn     OrderReturn?        @relation("ShipmentReturn", fields: [storeId, returnId], references: [storeId, id], onDelete: Restrict)
  returnOf        OrderReturn[]       @relation("ReturnShipment")
  events          ShipmentEvent[]
  remittance      CodRemittance?      @relation("RemittedShipment", fields: [storeId, codRemittanceId], references: [storeId, id], onDelete: Restrict)
  remittanceLines CodRemittanceLine[]

  @@unique([storeId, id])
  @@unique([storeId, idempotencyKey])
  @@index([orderId])
  @@index([storeId, status])
  @@index([storeId, orderId])
  @@index([connectionId, status])
  @@index([connectionId, providerShipmentId]) // The worker finds the package a carrier event names (the guide has its own unique index)
  @@index([pickupId])
  @@index([originWarehouseId])
  @@index([returnId])
  @@index([storeId, connectionId, codStatus]) // The pending screen and the daily check of what is owed
  @@index([codRemittanceId])
  @@map("shipments")
}

// Raw SQL of the migration (Prisma cannot express a partial unique index): shipments_one_active_outbound (one active
// outbound guide per order and origin warehouse, NULLS NOT DISTINCT) and shipments_guide_per_connection.

// The history of a shipment. A status the plugin could not map is stored with a null status (TDD_17 §4.17).
model ShipmentEvent {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  shipmentId      String   @map("shipment_id")
  providerEventId String?  @map("provider_event_id")
  status          String? // ShipmentStatus; null = an unmapped provider status, stored only
  rawStatus       String?  @map("raw_status")
  description     String?
  occurredAt      DateTime @map("occurred_at")
  receivedAt      DateTime @default(now()) @map("received_at")
  source          String // ShipmentEventSource: webhook | poll | manual | system
  payload         Json? // Redacted (§4.12)

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [storeId, shipmentId], references: [storeId, id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@index([storeId])
  @@map("shipment_events")
}

// Raw SQL: shipment_events_provider_dedupe, unique on (shipment_id, provider_event_id) where provider_event_id is not null.
// Raw SQL: shipment_events_unmapped_idx on (store_id, shipment_id) where status is null (what a replay reads).

// The owner's map from a carrier's own status code to a ShipmentStatus (§4.17). Seeded from the plugin's
// statusCatalog() when the connection is created, editable afterwards.
model CarrierStatusMapping {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  connectionId String   @map("connection_id")
  providerCode String   @map("provider_code") // Normalized: normalizeProviderStatusCode
  label        String? // What the carrier calls it, for the screen
  status       String? // ShipmentStatus; null = ignore on purpose (no effect, not counted as unknown)
  source       String   @default("default") // CarrierStatusMappingSource: default | custom
  updatedBy    String?  @map("updated_by")
  updatedAt    DateTime @updatedAt @map("updated_at")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection CarrierConnection @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Cascade)

  @@unique([connectionId, providerCode])
  @@index([storeId])
  @@map("carrier_status_mappings")
}

// A provider status code that arrived with no mapping and no plugin default (§4.17). One row per connection and code,
// so the owner is told once and the screen lists what is waiting.
model CarrierUnmappedStatus {
  id                String    @id @default(uuid())
  storeId           String    @map("store_id")
  connectionId      String    @map("connection_id")
  providerCode      String    @map("provider_code") // Normalized
  sampleRawStatus   String    @map("sample_raw_status") // The text as the carrier sent it
  sampleDescription String?   @map("sample_description")
  occurrences       Int       @default(1)
  firstSeenAt       DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  resolvedAt        DateTime? @map("resolved_at")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connection CarrierConnection @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Cascade)

  @@unique([connectionId, providerCode])
  @@index([storeId])
  @@map("carrier_unmapped_statuses")
}

// A request to the carrier to collect packages on a day (§4.10). No unique index on (connection, date): a carrier whose
// guides exist only inside a pickup can need several pickups on one day; "one open pickup per connection and day" is a
// rule of ShippingService.ensurePickup, under an advisory lock.
model PickupRequest {
  id                  String   @id @default(uuid())
  storeId             String   @map("store_id")
  connectionId        String   @map("connection_id")
  pickupDate          DateTime @map("pickup_date") @db.Date // In the store timezone
  status              String   @default("pending") // PickupStatus
  packageCount        Int      @default(0) @map("package_count")
  revision            Int      @default(1) // +1 each time the package count is modified
  carrierPackageCount Int?     @map("carrier_package_count") // What the carrier last acknowledged; null = what we hold
  providerPickupId    String?  @map("provider_pickup_id")
  windowStart         String?  @map("window_start") // 'HH:mm', when the carrier lets us choose
  windowEnd           String?  @map("window_end")
  requestedBy         String   @map("requested_by") // A user id or 'system'
  lastError           String?  @map("last_error")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  connection CarrierConnection @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Restrict)
  shipments  Shipment[]

  @@unique([storeId, id])
  @@index([storeId, pickupDate])
  @@index([connectionId])
  @@map("pickup_requests")
}

model BulkLabelJob {
  id            String    @id @default(uuid())
  storeId       String    @map("store_id")
  status        String    @default("queued") // BulkLabelJobStatus
  orderIds      String[]  @map("order_ids") // In the order the agent selected them (the PDF keeps it)
  total         Int
  succeeded     Int       @default(0)
  failed        Int       @default(0)
  results       Json? // Per order: { orderId, shipmentId?, outcome, errorCode? }
  mergedMediaId String?   @map("merged_media_id") // Media purpose BULK_LABELS; plain column like the other media ids
  requestedBy   String    @map("requested_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  finishedAt    DateTime? @map("finished_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("bulk_label_jobs")
}

// The messages a store sends about an order, one template per kind and locale (§4.7).
// Every message about an order that was due (TDD_17 §4.7): where it went, or why it did not. One row per idempotency key
// (automatic: `(shipmentId, status, kind)`; manual change: `(orderId, kind, status)`), so a repeated carrier event or a
// retried request sends nothing twice, and the timeline of the order can say "not sent, reason".
model OrderMessageDispatch {
  id             String   @id @default(uuid())
  storeId        String   @map("store_id")
  orderId        String   @map("order_id") // Composite foreign key with the store: the database refuses an order of another store
  kind           String // OrderMessageKind
  trigger        String // OrderMessageTrigger
  route          String // OrderMessageRoute
  reason         String? // OrderMessageNotSentReason, set only when the route is not_sent
  idempotencyKey String   @map("idempotency_key")
  messageId      String?  @map("message_id") // The outbound Message of a channel route; plain column like the other message links
  shipmentId     String?  @map("shipment_id") // The package that caused an automatic message
  requestedBy    String?  @map("requested_by") // The member who pressed "send" or changed the status; null for the system
  locale         String? // The language of the template that was used
  createdAt      DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade)

  @@unique([storeId, idempotencyKey])
  @@index([storeId, orderId, createdAt(sort: Desc)])
  @@map("order_message_dispatches")
}

model OrderMessageTemplate {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  kind            String // OrderMessageKind
  locale          String
  body            String // Plain text with {{variables}} from OrderMessageVariables
  autoSend        Boolean  @default(false) @map("auto_send")
  attachSummary   Boolean  @default(false) @map("attach_summary") // Attach the order summary PDF when the channel supports documents
  channelTemplate Json?    @map("channel_template") // { pluginId, name, language, variables } of a pre-approved channel template (§4.7)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, kind, locale])
  @@map("order_message_templates")
}

// A return or an exchange of a delivered order (§4.11).
model OrderReturn {
  id                 String    @id @default(uuid())
  storeId            String    @map("store_id")
  orderId            String    @map("order_id")
  type               String // OrderReturnType: refund | exchange
  reason             String // OrderReturnReason
  status             String    @default("requested") // OrderReturnStatus
  shippingPayer      String    @map("shipping_payer") // Who pays the return leg and the replacement (§4.11)
  replacementOrderId String?   @map("replacement_order_id") // Exchange: the new order
  returnShipmentId   String?   @map("return_shipment_id")
  refundAmountCents  Int?      @map("refund_amount_cents")
  notes              String?
  createdBy          String    @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  receivedAt         DateTime? @map("received_at")

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order            Order             @relation("ReturnOrder", fields: [orderId], references: [id], onDelete: Restrict)
  replacementOrder Order?            @relation("ReturnReplacement", fields: [replacementOrderId], references: [id], onDelete: Restrict)
  returnShipment   Shipment?         @relation("ReturnShipment", fields: [storeId, returnShipmentId], references: [storeId, id], onDelete: Restrict)
  shipments        Shipment[]        @relation("ShipmentReturn")
  lines            OrderReturnLine[]

  @@unique([storeId, id])
  @@index([orderId])
  @@index([storeId, orderId])
  @@index([storeId, status])
  @@index([replacementOrderId])
  @@index([returnShipmentId])
  @@map("order_returns")
}

model OrderReturnLine {
  id                 String  @id @default(uuid())
  storeId            String  @map("store_id")
  returnId           String  @map("return_id")
  orderItemId        String  @map("order_item_id")
  quantity           Int
  condition          String? // OrderReturnCondition, set on receipt
  restockWarehouseId String? @map("restock_warehouse_id") // Set on receipt for resellable items

  store            Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  orderReturn      OrderReturn @relation(fields: [storeId, returnId], references: [storeId, id], onDelete: Cascade)
  orderItem        OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  restockWarehouse Warehouse?  @relation(fields: [restockWarehouseId], references: [id], onDelete: Restrict)

  @@unique([returnId, orderItemId])
  @@index([storeId])
  @@index([orderItemId])
  @@index([restockWarehouseId])
  @@map("order_return_lines")
}

// The carrier's settlement of cash collected on delivery (TDD_17 §4.15). A draft is built by hand or from an import and
// confirmed once; a confirmed remittance is immutable and can only be voided. The status is written only by
// RemittancesService (lint rule). The three totals are written at confirmation.
model CodRemittance {
  id              String    @id @default(uuid())
  storeId         String    @map("store_id")
  connectionId    String    @map("connection_id")
  status          String    @default("draft") // RemittanceStatus
  reference       String? // The carrier's settlement number
  receivedOn      DateTime? @map("received_on") @db.Date
  importProfileId String?   @map("import_profile_id") // The profile an import used (Step 4.13, import PR)
  sourceMediaId   String?   @map("source_media_id") // The uploaded file, Media purpose REMITTANCE_FILE; plain column like the other media ids
  expectedCents   BigInt    @default(0) @map("expected_cents")
  reportedCents   BigInt    @default(0) @map("reported_cents")
  feeCents        BigInt    @default(0) @map("fee_cents")
  note            String?
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  confirmedAt     DateTime? @map("confirmed_at")
  confirmedBy     String?   @map("confirmed_by")
  voidedAt        DateTime? @map("voided_at")
  voidedBy        String?   @map("voided_by")
  voidReason      String?   @map("void_reason") // Why a confirmed remittance was voided

  store      Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  connection CarrierConnection   @relation(fields: [storeId, connectionId], references: [storeId, id], onDelete: Restrict)
  lines      CodRemittanceLine[]
  shipments  Shipment[]          @relation("RemittedShipment")

  // So that its lines and the shipments it settled can name their store and the database check that they go together
  @@unique([storeId, id])
  @@index([storeId, connectionId, status])
  @@map("cod_remittances")
}

model CodRemittanceLine {
  id               String  @id @default(uuid())
  storeId          String  @map("store_id")
  remittanceId     String  @map("remittance_id")
  position         Int // 1-based order of the line in its remittance: of two lines for one guide, the first one counts
  shipmentId       String? @map("shipment_id") // Null when the guide matched nothing
  guideNumber      String  @map("guide_number") // As it appeared in the file, trimmed
  reportedCents    Int     @map("reported_cents")
  reportedFeeCents Int?    @map("reported_fee_cents")
  expectedCents    Int?    @map("expected_cents")
  outcome          String // RemittanceLineOutcome
  excluded         Boolean @default(false) // The agent left it out of the confirmation
  note             String?

  store      Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  remittance CodRemittance @relation(fields: [storeId, remittanceId], references: [storeId, id], onDelete: Cascade)
  shipment   Shipment?     @relation(fields: [storeId, shipmentId], references: [storeId, id], onDelete: Restrict)

  @@unique([remittanceId, position])
  @@index([shipmentId])
  @@map("cod_remittance_lines")
}
