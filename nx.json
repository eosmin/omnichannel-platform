{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.spec.tsx",
      "!{projectRoot}/**/*.stories.tsx",
      "!{projectRoot}/jest.config.cts"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.js"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build", "^prisma-generate"],
      "inputs": ["production", "^production", "{workspaceRoot}/tools/rspack/**/*"]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.spec.json",
        "{workspaceRoot}/jest.preset.cjs"
      ],
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "jest --passWithNoTests",
        "cwd": "{projectRoot}",
        "env": {
          "NODE_OPTIONS": "--experimental-vm-modules --no-warnings=ExperimentalWarning"
        }
      },
      "dependsOn": ["^prisma-generate"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^production"],
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --max-warnings=0 .",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^prisma-generate"]
    },
    "type-check": {
      "cache": true,
      "inputs": ["default", "^production"],
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^prisma-generate"]
    },
    "prisma-generate": {
      "cache": true,
      "inputs": ["{projectRoot}/prisma/**/*", "{projectRoot}/prisma.config.ts"]
    }
  },
  "analytics": false
}
