{
  "name": "@platform/source",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "test": "nx run-many --target=test --all",
    "test:watch": "nx run-many --target=test --all -- --watch",
    "test:cov": "nx run-many --target=test --all -- --coverage",
    "test:affected": "nx affected --target=test --base=origin/main",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "type-check": "nx run-many --target=type-check --all",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "validate:env": "tsx scripts/validate-env-example.ts",
    "db:migrate": "prisma migrate deploy && tsx scripts/set-db-role-passwords.ts",
    "db:check-rollbacks": "tsx scripts/check-rollbacks.ts",
    "db:seed": "prisma db seed",
    "db:fixtures": "tsx --tsconfig libs/core/database/tsconfig.json libs/core/database/prisma/dev-fixtures.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.0.1",
    "@next/eslint-plugin-next": "16.3.4",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/jest": "23.2.0",
    "@nx/js": "23.2.0",
    "@rspack/core": "2.2.9",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "10.9.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.16.1",
    "husky": "9.1.7",
    "jest": "30.5.1",
    "jest-environment-node": "30.5.1",
    "lint-staged": "17.4.1",
    "nx": "23.2.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.1",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "webpack-node-externals": "3.0.0"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/terminus": "12.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/extension-read-replicas": "0.5.0",
    "@prometheus-io/client": "0.16.1",
    "@sentry/nestjs": "11.5.0",
    "dotenv-flow": "4.1.0",
    "nestjs-pino": "5.1.0",
    "next": "16.3.4",
    "pg": "8.16.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  }
}
