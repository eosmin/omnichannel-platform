{
  "name": "@platform/source",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "test": "nx run-many --target=test --all",
    "test:watch": "nx run-many --target=test --all -- --watch",
    "test:cov": "nx run-many --target=test --all -- --coverage",
    "test:security": "nx run tests:test-security --skip-nx-cache",
    "test:affected": "nx affected --target=test --base=origin/main",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,cts,json,md,yml,yaml}\"",
    "type-check": "nx run-many --target=type-check --all",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "validate:env": "tsx scripts/validate-env-example.ts",
    "db:migrate": "prisma migrate deploy && tsx scripts/set-db-role-passwords.ts",
    "db:seed": "prisma db seed",
    "db:fixtures": "tsx --tsconfig libs/core/database/tsconfig.json libs/core/database/prisma/dev-fixtures.ts",
    "prepare": "husky",
    "validate:translations": "tsx scripts/validate-translations.ts",
    "validate:deprecations": "tsx scripts/validate-deprecations.ts",
    "validate:rollbacks": "tsx scripts/check-rollbacks.ts",
    "validate:isolation": "tsx scripts/check-isolation-coverage.ts",
    "validate:all": "pnpm lint && pnpm type-check && pnpm format:check && pnpm validate:translations && pnpm validate:deprecations && pnpm validate:rollbacks && pnpm validate:isolation && pnpm test",
    "validate:affected": "tsx scripts/validate-affected.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/jest": "23.2.0",
    "@nx/js": "23.2.0",
    "@rspack/core": "2.2.9",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "7.2.1",
    "eslint": "10.9.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.16.1",
    "husky": "9.1.7",
    "jest": "30.5.1",
    "jest-environment-node": "30.5.1",
    "lint-staged": "17.4.1",
    "nx": "23.2.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.1",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "webpack-node-externals": "3.0.0"
  },
  "dependencies": {
    "@bull-board/api": "9.10.5",
    "@bull-board/express": "9.10.5",
    "@bull-board/ui": "9.10.5",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/extension-read-replicas": "0.5.0",
    "@prometheus-io/client": "0.16.1",
    "@sentry/nestjs": "11.5.0",
    "bullmq": "6.3.4",
    "dotenv-flow": "4.1.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "libphonenumber-js": "1.13.15",
    "nestjs-pino": "5.1.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.16.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.9.3",
    "reflect-metadata": "0.2.2",
    "resend": "6.25.0",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,cts,mts,json,md,yml,yaml}": "prettier --write --ignore-unknown",
    "libs/core/database/prisma/schema.prisma": "prisma format",
    "apps/web/messages/*.json": "pnpm validate:translations",
    "libs/core/database/prisma/migrations/**/migration.sql": "pnpm validate:rollbacks"
  }
}
