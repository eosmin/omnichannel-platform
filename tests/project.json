{
  "name": "tests",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tests",
  "projectType": "application",
  "tags": ["scope:tests"],
  "targets": {
    "lint": {},
    "type-check": {},
    "test-contracts": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "jest --config jest.contracts.config.cts",
        "cwd": "{projectRoot}",
        "env": {
          "NODE_OPTIONS": "--experimental-vm-modules --no-warnings=ExperimentalWarning"
        }
      }
    },
    "test-security": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^prisma-generate"],
      "options": {
        "command": "if [ -n \"$SECURITY_SHARD\" ]; then jest --config jest.config.cts --runInBand --shard=\"$SECURITY_SHARD\"; else status=0; jest --config jest.config.cts --runInBand --shard=1/2 || status=1; jest --config jest.config.cts --runInBand --shard=2/2 || status=1; exit $status; fi",
        "cwd": "{projectRoot}",
        "env": {
          "NODE_OPTIONS": "--experimental-vm-modules --max-old-space-size=4096 --no-warnings=ExperimentalWarning"
        }
      }
    }
  },
  "implicitDependencies": ["api"]
}
