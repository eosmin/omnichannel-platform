{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@platform/core/errors": ["libs/core/domain/errors/index.ts"],
      "@platform/core/domain": ["libs/core/domain/index.ts"],
      "@platform/core/auth": ["libs/core/domain/auth/index.ts"],
      "@platform/core/notifications": ["libs/core/domain/notifications/index.ts"],
      "@platform/core/events": ["libs/core/domain/events/index.ts"],
      "@platform/core/realtime": ["libs/core/domain/realtime/index.ts"],
      "@platform/core/api": ["libs/core/domain/api/index.ts"],
      "@platform/core/storage": ["libs/core/domain/storage/index.ts"],
      "@platform/core/analytics": ["libs/core/domain/analytics/index.ts"],
      "@platform/core/cache": ["libs/core/platform/cache/index.ts"],
      "@platform/core/queues": ["libs/core/platform/queues/index.ts"],
      "@platform/core/audit": ["libs/core/platform/audit/index.ts"],
      "@platform/core/metrics": ["libs/core/platform/metrics/index.ts"],
      "@platform/core/compliance": ["libs/core/platform/compliance/index.ts"],
      "@platform/core/config": ["libs/core/platform/config/index.ts"],
      "@platform/core/config/env": ["libs/core/platform/config/env.ts"],
      "@platform/plugins/sdk": ["libs/plugins/sdk/src/index.ts"],
      "@platform/api-client": ["libs/api-client/src/index.ts"],
      "@platform/core/i18n": ["libs/core/domain/i18n/index.ts"],
      "@platform/core/crypto": ["libs/core/crypto/src/index.ts"],
      "@platform/core/database": ["libs/core/database/src/index.ts"],
      "@platform/core/logger": ["libs/core/logger/src/index.ts"],
      "@platform/core/metrics-module": ["libs/core/metrics/src/index.ts"],
      "@platform/core/http": ["libs/core/http/src/index.ts"],
      "@platform/core/database-testing": ["libs/core/database/testing/connection-urls.ts"],
      "@platform/core/auth-module": ["libs/core/auth/src/index.ts"],
      "@platform/core/redis": ["libs/core/redis/src/index.ts"],
      "@platform/core/queues-module": ["libs/core/queues/src/index.ts"],
      "@platform/core/i18n-server": ["libs/core/i18n-server/src/index.ts"],
      "@platform/core/email": ["libs/core/email/src/index.ts"],
      "@platform/core/sentry": ["libs/core/http/src/instrument.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
